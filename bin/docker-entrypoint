#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the rails server then create or migrate existing database
# and ensure the initial admin user exists (task is idempotent).
# Matches "rails server" anywhere in the command, so it also works when the
# platform (e.g. Render) wraps the command in a shell: /bin/sh -c "./bin/rails server"
if [[ "$*" == *"rails server"* ]]; then
  echo "[entrypoint] Preparando banco de dados e admin inicial..."
  ./bin/rails db:prepare admin:create
fi

exec "${@}"