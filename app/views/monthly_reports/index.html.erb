<div class="mb-6">
  <div class="mb-4 flex justify-between items-center">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Relatório Mensal</h2>
      <p class="text-gray-600 text-sm mt-0.5">Estatísticas de <%= I18n.localize(@current_month, format: '%B de %Y') %></p>
    </div>

    <!-- Seletor de mês e ano -->
    <%= form_with url: monthly_reports_path, method: :get, id: "month_selector_form", class: "flex items-center gap-3" do |f| %>
      <div class="flex items-center gap-2">
        <label for="month_select" class="text-sm font-medium text-gray-700">Mês:</label>
        <%= f.select :month,
            (1..12).map { |m| [I18n.t('date.month_names')[m], m] },
            { selected: @current_month.month },
            { id: "month_select", class: "px-2 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white text-gray-900 cursor-pointer" }
        %>
      </div>

      <div class="flex items-center gap-2">
        <label for="year_select" class="text-sm font-medium text-gray-700">Ano:</label>
        <%= f.select :year,
            @available_years.reverse,
            { selected: @current_month.year },
            { id: "year_select", class: "px-2 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white text-gray-900 cursor-pointer max-h-60 overflow-y-auto" }
        %>
      </div>
    <% end %>
  </div>

  <!-- KPI Cards - Todos em uma linha -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-3 mb-4">
    <!-- Lucro Líquido -->
    <div class="bg-white rounded-lg shadow p-3 border-l-4 <%= @net_profit >= 0 ? 'border-green-500' : 'border-red-500' %>">
      <h3 class="text-gray-600 text-xs font-medium mb-1">Lucro Líquido</h3>
      <p class="text-lg font-bold <%= @net_profit >= 0 ? 'text-green-600' : 'text-red-600' %>">
        R$ <%= number_to_currency(@net_profit, unit: '', delimiter: '.', separator: ',', precision: 2) %>
      </p>
    </div>

    <!-- Receitas Totais -->
    <div class="bg-white rounded-lg shadow p-3 border-l-4 border-blue-500">
      <h3 class="text-gray-600 text-xs font-medium mb-1">Receitas Totais</h3>
      <p class="text-lg font-bold text-blue-600">
        R$ <%= number_to_currency(@total_revenue, unit: '', delimiter: '.', separator: ',', precision: 2) %>
      </p>
    </div>

    <!-- Despesas Totais -->
    <div class="bg-white rounded-lg shadow p-3 border-l-4 border-orange-500">
      <h3 class="text-gray-600 text-xs font-medium mb-1">Despesas Totais</h3>
      <p class="text-lg font-bold text-orange-600">
        R$ <%= number_to_currency(@total_expenses, unit: '', delimiter: '.', separator: ',', precision: 2) %>
      </p>
    </div>

    <!-- Recebido -->
    <div class="bg-white rounded-lg shadow p-3 border-l-4 border-green-500">
      <h3 class="text-gray-600 text-xs font-medium mb-1">Recebido</h3>
      <p class="text-lg font-bold text-green-600">
        R$ <%= number_to_currency(@received, unit: '', delimiter: '.', separator: ',', precision: 2) %>
      </p>
    </div>

    <!-- Atrasados -->
    <div class="bg-white rounded-lg shadow p-3 border-l-4 border-red-500">
      <h3 class="text-gray-600 text-xs font-medium mb-1">Atrasados</h3>
      <p class="text-lg font-bold text-red-600">
        R$ <%= number_to_currency(@overdue_amount, unit: '', delimiter: '.', separator: ',', precision: 2) %>
      </p>
      <p class="text-xs text-gray-500"><%= @overdue_count %> vendas</p>
    </div>

    <!-- A Receber -->
    <div class="bg-white rounded-lg shadow p-3 border-l-4 border-yellow-500">
      <h3 class="text-gray-600 text-xs font-medium mb-1">A Receber</h3>
      <p class="text-lg font-bold text-yellow-600">
        R$ <%= number_to_currency(@pending_amount, unit: '', delimiter: '.', separator: ',', precision: 2) %>
      </p>
    </div>

    <!-- Projeção de Gastos -->
    <div class="bg-white rounded-lg shadow p-3 border-l-4 border-purple-500">
      <h3 class="text-gray-600 text-xs font-medium mb-1">Projeção</h3>
      <p class="text-lg font-bold text-purple-600">
        R$ <%= number_to_currency(@projected_expenses, unit: '', delimiter: '.', separator: ',', precision: 2) %>
      </p>
      <p class="text-xs <%= @remaining_budget >= 0 ? 'text-green-600' : 'text-red-600' %> font-semibold">
        Resta: R$ <%= number_to_currency(@remaining_budget.abs, unit: '', delimiter: '.', separator: ',', precision: 2) %>
      </p>
    </div>
  </div>

  <!-- Gráficos -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 mb-3">
    <!-- Fluxo de Caixa Diário -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Fluxo de Caixa Diário</h3>
      <div style="height: 250px; position: relative;">
        <canvas id="cashFlowChart"></canvas>
      </div>
    </div>

    <!-- Receitas vs Despesas -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Receitas vs Despesas</h3>
      <div style="height: 250px; position: relative;">
        <canvas id="revenueExpensesChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Detalhamento de Despesas Projetadas -->
  <div class="bg-white rounded-lg shadow p-4">
    <h3 class="text-sm font-semibold text-gray-900 mb-2">Detalhamento da Projeção de Gastos</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div class="p-3 bg-gray-50 rounded-lg">
        <p class="text-xs text-gray-600 mb-1">Despesas Fixas Mensais</p>
        <p class="text-lg font-bold text-gray-900">R$ <%= number_to_currency(@fixed_monthly, unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
      </div>
      <div class="p-3 bg-gray-50 rounded-lg">
        <p class="text-xs text-gray-600 mb-1">Média Esporádicas (3 meses)</p>
        <p class="text-lg font-bold text-gray-900">R$ <%= number_to_currency(@sporadic_average, unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
      </div>
      <div class="p-3 bg-blue-50 rounded-lg">
        <p class="text-xs text-blue-600 mb-1">Total Projetado</p>
        <p class="text-lg font-bold text-blue-900">R$ <%= number_to_currency(@projected_expenses, unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Submissão automática ao mudar mês ou ano
    const monthSelect = document.getElementById('month_select');
    const yearSelect = document.getElementById('year_select');
    const form = document.getElementById('month_selector_form');

    if (monthSelect && yearSelect && form) {
      monthSelect.addEventListener('change', function() {
        form.submit();
      });

      yearSelect.addEventListener('change', function() {
        form.submit();
      });
    }

    // Gráfico de Fluxo de Caixa
    const cashFlowCtx = document.getElementById('cashFlowChart');
    if (cashFlowCtx) {
      new Chart(cashFlowCtx.getContext('2d'), {
        type: 'line',
        data: {
          labels: <%= raw @chart_labels.to_json %>,
          datasets: [
            {
              label: 'Receitas',
              data: <%= raw @chart_revenue_data.to_json %>,
              borderColor: 'rgb(34, 197, 94)',
              backgroundColor: 'rgba(34, 197, 94, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 2
            },
            {
              label: 'Despesas',
              data: <%= raw @chart_expenses_data.to_json %>,
              borderColor: 'rgb(249, 115, 22)',
              backgroundColor: 'rgba(249, 115, 22, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 2
            },
            {
              label: 'Saldo Diário',
              data: <%= raw @chart_balance_data.to_json %>,
              borderColor: 'rgb(59, 130, 246)',
              backgroundColor: 'rgba(59, 130, 246, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 2,
              borderDash: [5, 5]
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                boxWidth: 12,
                padding: 10,
                font: {
                  size: 11
                }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              callbacks: {
                label: function(context) {
                  let label = context.dataset.label || '';
                  if (label) {
                    label += ': ';
                  }
                  label += 'R$ ' + context.parsed.y.toFixed(2);
                  return label;
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(0, 0, 0, 0.08)'
              },
              ticks: {
                font: {
                  size: 10
                },
                callback: function(value) {
                  return 'R$ ' + value.toFixed(0);
                }
              }
            },
            x: {
              grid: {
                color: 'rgba(0, 0, 0, 0.08)'
              },
              ticks: {
                font: {
                  size: 10
                }
              }
            }
          }
        }
      });
    }

    // Gráfico de Receitas vs Despesas (Barras)
    const revenueExpensesCtx = document.getElementById('revenueExpensesChart');
    if (revenueExpensesCtx) {
      new Chart(revenueExpensesCtx.getContext('2d'), {
        type: 'bar',
        data: {
          labels: <%= raw @chart_labels.to_json %>,
          datasets: [
            {
              label: 'Receitas',
              data: <%= raw @chart_revenue_data.to_json %>,
              backgroundColor: 'rgba(34, 197, 94, 0.8)',
              borderColor: 'rgb(34, 197, 94)',
              borderWidth: 1
            },
            {
              label: 'Despesas',
              data: <%= raw @chart_expenses_data.to_json %>,
              backgroundColor: 'rgba(249, 115, 22, 0.8)',
              borderColor: 'rgb(249, 115, 22)',
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                boxWidth: 12,
                padding: 10,
                font: {
                  size: 11
                }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              callbacks: {
                label: function(context) {
                  let label = context.dataset.label || '';
                  if (label) {
                    label += ': ';
                  }
                  label += 'R$ ' + context.parsed.y.toFixed(2);
                  return label;
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(0, 0, 0, 0.08)'
              },
              ticks: {
                font: {
                  size: 10
                },
                callback: function(value) {
                  return 'R$ ' + value.toFixed(0);
                }
              }
            },
            x: {
              grid: {
                display: false
              },
              ticks: {
                font: {
                  size: 10
                }
              }
            }
          }
        }
      });
    }
  });
</script>
