<div class="mb-6">
  <div class="mb-4 flex justify-between items-center">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Relatório Mensal</h2>
      <p class="text-gray-600 text-sm mt-0.5">Estatísticas de <%= I18n.localize(@current_month, format: '%B de %Y') %></p>
    </div>

    <!-- Seletor de mês e ano -->
    <%= form_with url: monthly_reports_path, method: :get, id: "month_selector_form", class: "flex items-center gap-3" do |f| %>
      <div class="flex items-center gap-2">
        <label for="month_select" class="text-sm font-medium text-gray-700">Mês:</label>
        <%= f.select :month,
            (1..12).map { |m| [I18n.t('date.month_names')[m], m] },
            { selected: @current_month.month },
            { id: "month_select", class: "px-2 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white text-gray-900 cursor-pointer" }
        %>
      </div>

      <div class="flex items-center gap-2">
        <label for="year_select" class="text-sm font-medium text-gray-700">Ano:</label>
        <%= f.select :year,
            @available_years.reverse,
            { selected: @current_month.year },
            { id: "year_select", class: "px-2 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white text-gray-900 cursor-pointer max-h-60 overflow-y-auto" }
        %>
      </div>
    <% end %>
  </div>

  <!-- KPI Cards - 2 por linha -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
    <!-- Lucro Líquido -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 <%= @net_profit >= 0 ? 'border-green-500' : 'border-red-500' %> relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full <%= @net_profit >= 0 ? 'bg-green-100' : 'bg-red-100' %>">
            <svg class="w-6 h-6 <%= @net_profit >= 0 ? 'text-green-600' : 'text-red-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Lucro Líquido</h3>
            <p class="text-2xl font-bold <%= @net_profit >= 0 ? 'text-green-600' : 'text-red-600' %>">
              R$ <%= number_to_currency(@net_profit, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">O 'Lucro Líquido' é o ganho real do negócio, ele é calculado pegando o valor das receitas totais e deduzindo deste os custos dos produtos vendidos e das despesas do mês. Para produtos: (preço de venda - custo unitário) × quantidade. Para serviços: valor integral.</div>
        </div>
      </div>
    </div>

    <!-- Receitas Totais -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-blue-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-blue-100">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Receitas Totais</h3>
            <p class="text-2xl font-bold text-blue-600">
              R$ <%= number_to_currency(@total_revenue, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">As 'Receitas Totais' representam a soma total de todas as vendas do mês (tanto pagas quanto pendentes), excluindo as vendas canceladas.</div>
        </div>
      </div>
    </div>

    <!-- Despesas Totais -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-orange-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-orange-100">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Despesas Totais</h3>
            <p class="text-2xl font-bold text-orange-600">
              R$ <%= number_to_currency(@total_expenses, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">As 'Despesas Totais' nada mais são do que a soma de todas as despesas ativas registradas no mês, incluindo fixas mensais, esporádicas e raras.</div>
        </div>
      </div>
    </div>

    <!-- Recebido -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-green-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-green-100">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Recebido</h3>
            <p class="text-2xl font-bold text-green-600">
              R$ <%= number_to_currency(@received, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">O 'Recebido' representa o dinheiro que já entrou no caixa, ele é calculado a partir da soma das vendas com status "pago" no mês em questão.</div>
        </div>
      </div>
    </div>

    <!-- Atrasados -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-red-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-red-100">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Atrasados</h3>
            <p class="text-2xl font-bold text-red-600">
              R$ <%= number_to_currency(@overdue_amount, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
            <p class="text-sm text-gray-500 mt-1"><%= @overdue_count %> <%= @overdue_count == 1 ? 'venda' : 'vendas' %></p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Os 'Atrasados' representam as vendas pendentes com data de vencimento anterior à data de hoje. Valores que deveriam ter sido recebidos mas que ainda não foram pagos.</div>
        </div>
      </div>
    </div>

    <!-- A Receber -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-yellow-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-yellow-100">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">A Receber</h3>
            <p class="text-2xl font-bold text-yellow-600">
              R$ <%= number_to_currency(@pending_amount, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">O 'A Receber' simboliza as vendas pendentes com vencimento futuro ou sem data definida. São valores que ainda serão recebidos dentro do prazo normal.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Gráficos -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 mb-3">
    <!-- Fluxo de Caixa Diário -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Fluxo de Caixa Diário</h3>
      <div style="height: 250px; position: relative;">
        <canvas id="cashFlowChart"></canvas>
      </div>
    </div>

    <!-- Receitas vs Despesas -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Receitas vs Despesas</h3>
      <div style="height: 250px; position: relative;">
        <canvas id="revenueExpensesChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Detalhamento de Despesas Projetadas -->
  <div class="bg-white rounded-lg shadow p-4">
    <h3 class="text-sm font-semibold text-gray-900 mb-2">Projeção de Gastos</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div class="p-3 bg-gray-50 rounded-lg">
        <p class="text-xs text-gray-600 mb-1">Despesas Fixas Mensais</p>
        <p class="text-lg font-bold text-gray-900">R$ <%= number_to_currency(@fixed_monthly, unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
      </div>
      <div class="p-3 bg-gray-50 rounded-lg">
        <p class="text-xs text-gray-600 mb-1">Média Esporádicas (3 meses)</p>
        <p class="text-lg font-bold text-gray-900">R$ <%= number_to_currency(@sporadic_average, unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
      </div>
      <div class="p-3 bg-blue-50 rounded-lg">
        <p class="text-xs text-blue-600 mb-1">Total Projetado</p>
        <p class="text-lg font-bold text-blue-900">R$ <%= number_to_currency(@projected_expenses, unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
      </div>
    </div>
  </div>
</div>

<style>
  .info-tooltip {
    position: relative;
    display: inline-block;
  }

  .info-tooltip .tooltip-text {
    visibility: hidden;
    width: 280px;
    background-color: #1f2937;
    color: #fff;
    text-align: left;
    border-radius: 8px;
    padding: 12px;
    position: absolute;
    z-index: 1000;
    top: -10px;
    right: 30px;
    opacity: 0;
    transition: opacity 0.3s;
    font-size: 0.813rem;
    line-height: 1.4;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .info-tooltip .tooltip-text::after {
    content: "";
    position: absolute;
    top: 10px;
    left: 100%;
    margin-left: 0;
    border-width: 8px;
    border-style: solid;
    border-color: transparent transparent transparent #1f2937;
  }

  .info-tooltip:hover .tooltip-text {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Submissão automática ao mudar mês ou ano
    const monthSelect = document.getElementById('month_select');
    const yearSelect = document.getElementById('year_select');
    const form = document.getElementById('month_selector_form');

    if (monthSelect && yearSelect && form) {
      monthSelect.addEventListener('change', function() {
        form.submit();
      });

      yearSelect.addEventListener('change', function() {
        form.submit();
      });
    }

    // Gráfico de Fluxo de Caixa
    const cashFlowCtx = document.getElementById('cashFlowChart');
    if (cashFlowCtx) {
      new Chart(cashFlowCtx.getContext('2d'), {
        type: 'line',
        data: {
          labels: <%= raw @chart_labels.to_json %>,
          datasets: [
            {
              label: 'Receitas',
              data: <%= raw @chart_revenue_data.to_json %>,
              borderColor: 'rgb(34, 197, 94)',
              backgroundColor: 'rgba(34, 197, 94, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 2
            },
            {
              label: 'Despesas',
              data: <%= raw @chart_expenses_data.to_json %>,
              borderColor: 'rgb(249, 115, 22)',
              backgroundColor: 'rgba(249, 115, 22, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 2
            },
            {
              label: 'Saldo Diário',
              data: <%= raw @chart_balance_data.to_json %>,
              borderColor: 'rgb(59, 130, 246)',
              backgroundColor: 'rgba(59, 130, 246, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 2,
              borderDash: [5, 5]
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                boxWidth: 12,
                padding: 10,
                font: {
                  size: 11
                }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              callbacks: {
                label: function(context) {
                  let label = context.dataset.label || '';
                  if (label) {
                    label += ': ';
                  }
                  label += 'R$ ' + context.parsed.y.toFixed(2);
                  return label;
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(0, 0, 0, 0.08)'
              },
              ticks: {
                font: {
                  size: 10
                },
                callback: function(value) {
                  return 'R$ ' + value.toFixed(0);
                }
              }
            },
            x: {
              grid: {
                color: 'rgba(0, 0, 0, 0.08)'
              },
              ticks: {
                font: {
                  size: 10
                }
              }
            }
          }
        }
      });
    }

    // Gráfico de Receitas vs Despesas (Barras)
    const revenueExpensesCtx = document.getElementById('revenueExpensesChart');
    if (revenueExpensesCtx) {
      new Chart(revenueExpensesCtx.getContext('2d'), {
        type: 'bar',
        data: {
          labels: <%= raw @chart_labels.to_json %>,
          datasets: [
            {
              label: 'Receitas',
              data: <%= raw @chart_revenue_data.to_json %>,
              backgroundColor: 'rgba(34, 197, 94, 0.8)',
              borderColor: 'rgb(34, 197, 94)',
              borderWidth: 1
            },
            {
              label: 'Despesas',
              data: <%= raw @chart_expenses_data.to_json %>,
              backgroundColor: 'rgba(249, 115, 22, 0.8)',
              borderColor: 'rgb(249, 115, 22)',
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                boxWidth: 12,
                padding: 10,
                font: {
                  size: 11
                }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              callbacks: {
                label: function(context) {
                  let label = context.dataset.label || '';
                  if (label) {
                    label += ': ';
                  }
                  label += 'R$ ' + context.parsed.y.toFixed(2);
                  return label;
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(0, 0, 0, 0.08)'
              },
              ticks: {
                font: {
                  size: 10
                },
                callback: function(value) {
                  return 'R$ ' + value.toFixed(0);
                }
              }
            },
            x: {
              grid: {
                display: false
              },
              ticks: {
                font: {
                  size: 10
                }
              }
            }
          }
        }
      });
    }
  });
</script>
