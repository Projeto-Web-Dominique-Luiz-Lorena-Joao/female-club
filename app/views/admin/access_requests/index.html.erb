<div class="space-y-6">

  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Solicitações de Acesso</h1>
      <p class="mt-2 text-gray-600">Gerenciar solicitações de acesso ao sistema</p>
    </div>
    <% if @pending_count > 0 %>
      <span class="bg-yellow-100 text-yellow-800 text-sm font-medium px-4 py-2 rounded-full">
        <%= @pending_count %> pendente<%= @pending_count > 1 ? 's' : '' %>
      </span>
    <% end %>
  </div>

  <!-- Filtros por Status -->
  <div class="bg-white rounded-lg shadow p-4">
    <div class="flex flex-wrap gap-2">
      <%= link_to "Todas", admin_access_requests_path,
          class: "px-4 py-2 rounded-lg text-sm font-medium transition duration-200 #{params[:status].blank? ? 'bg-black text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <%= link_to "Pendentes", admin_access_requests_path(status: 'pending'),
          class: "px-4 py-2 rounded-lg text-sm font-medium transition duration-200 #{params[:status] == 'pending' ? 'bg-yellow-500 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <%= link_to "Aprovadas", admin_access_requests_path(status: 'approved'),
          class: "px-4 py-2 rounded-lg text-sm font-medium transition duration-200 #{params[:status] == 'approved' ? 'bg-green-500 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <%= link_to "Rejeitadas", admin_access_requests_path(status: 'rejected'),
          class: "px-4 py-2 rounded-lg text-sm font-medium transition duration-200 #{params[:status] == 'rejected' ? 'bg-red-500 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    </div>
  </div>

  <!-- Tabela -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @access_requests.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Data</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">E-mail</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mensagem</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @access_requests.each do |request| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= request.created_at.strftime('%d/%m/%Y %H:%M') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= request.email %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">
                  <%= request.message.present? ? request.message : '—' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= request.status_badge_class %>">
                    <%= request.status_label %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                  <% if request.pending? %>
                    <div class="flex items-center justify-end gap-2">
                      <%= button_to "Aprovar", approve_admin_access_request_path(request),
                          method: :patch,
                          class: "inline-flex items-center px-3 py-1.5 bg-green-500 hover:bg-green-600 text-white text-xs font-medium rounded-lg transition duration-200",
                          form: { data: { controller: "submit-once" } },
                          data: { turbo_confirm: "Aprovar solicitação de #{request.email}? Um novo usuário será criado." } %>
                      <%= button_to "Rejeitar", reject_admin_access_request_path(request),
                          method: :patch,
                          class: "inline-flex items-center px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white text-xs font-medium rounded-lg transition duration-200",
                          form: { data: { controller: "submit-once" } },
                          data: { turbo_confirm: "Rejeitar solicitação de #{request.email}?" } %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Paginação -->
      <div class="px-6 py-4 border-t border-gray-200">
        <%= render 'shared/pagination', collection: @access_requests %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">Nenhuma solicitação encontrada</h3>
        <p class="mt-1 text-sm text-gray-500">As solicitações de acesso aparecerão aqui.</p>
      </div>
    <% end %>
  </div>

</div>
