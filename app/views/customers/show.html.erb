<div class="max-w-6xl mx-auto space-y-6">
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @customer.full_name %></h1>
    </div>
    <div class="flex space-x-3">
      <%= link_to edit_customer_path(@customer), class: "bg-black hover:bg-gray-700 text-white px-8 py-2 rounded-lg font-medium" do %>
        Editar
      <% end %>

        <%= link_to "javascript:history.back()", class: "bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2 transition shadow-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
              stroke="currentColor" stroke-width="3" fill="none"
              class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
          </svg>
          Voltar
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Card Total de Compras -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-blue-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-blue-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Total de Compras</p>
          <p class="text-2xl font-bold text-gray-900 mt-1"><%= @customer.purchases_count %></p>
        </div>
      </div>
    </div>

    <!-- Card Valor Total Gasto -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-green-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Valor Total Gasto</p>
          <p class="text-2xl font-bold text-green-600 mt-1">
            R$ <%= number_with_delimiter(@customer.total_purchases.to_f.round(2), delimiter: '.', separator: ',') %>
          </p>
        </div>
      </div>
    </div>

    <!-- Card Última Compra -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-gray-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-gray-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Última Compra</p>
          <p class="text-2xl font-bold text-gray-900 mt-1">
            <%= @customer.last_purchase_date ? I18n.l(@customer.last_purchase_date, format: :short) : 'Nunca' rescue 'Nunca' %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-black">
      <h2 class="text-xl font-bold text-white">Informações Pessoais</h2>
    </div>
    <div class="p-6 grid grid-cols-2 gap-6">
      <div>
        <p class="text-sm font-medium text-gray-500">CPF</p>
        <p class="mt-1 text-lg text-gray-900"><%= @customer.formatted_cpf %></p>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-500">Data de Nascimento</p>
        <p class="mt-1 text-lg text-gray-900">
          <%= @customer.formatted_birth_date %>
          <% if @customer.age %>
            <span class="text-sm text-gray-500">(<%= @customer.age %> anos)</span>
          <% end %>
        </p>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-500">Telefone</p>
        <p class="mt-1 text-lg text-gray-900"><%= @customer.formatted_phone %></p>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-500">E-mail</p>
        <p class="mt-1 text-lg text-gray-900"><%= @customer.email || '-' %></p>
      </div>
      
      <% if @customer.full_address.present? %>
        <div class="col-span-2">
          <p class="text-sm font-medium text-gray-500">Endereço</p>
          <p class="mt-1 text-gray-900"><%= @customer.full_address %></p>
        </div>
      <% end %>
      
      <% if @customer.notes.present? %>
        <div class="col-span-2 pt-4 border-t">
          <p class="text-sm font-medium text-gray-500">Observações</p>
          <p class="mt-1 text-gray-900"><%= @customer.notes %></p>
        </div>
      <% end %>

      <% if @customer.guarantor.present? %>
        <div class="col-span-2 pt-4 border-t border-gray-200">
          <div class="flex items-center justify-between">
            <p class="text-sm font-medium text-gray-500 mb-2">Fiador</p>
            <%= link_to guarantor_path(@customer.guarantor),
                        class: "inline-flex items-center px-4 py-2 bg-blue-200 text-blue-700 text-sm font-medium rounded-lg transition shadow" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              Ver Fiador
            <% end %>
          </div>
          <div class="mt-2 p-4 bg-gray-100 border border-gray-200 rounded-lg">
            <p class="text-lg font-semibold text-gray-900"><%= @customer.guarantor.full_name %></p>
            <p class="text-sm text-gray-600 mt-1">
              <span class="font-medium">Parentesco:</span> <%= @customer.guarantor.relationship.titleize %>
            </p>
            <% if @customer.guarantor.phone.present? %>
              <p class="text-sm text-gray-600 mt-1">
                <span class="font-medium">Telefone:</span> <%= @customer.guarantor.formatted_phone %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  
  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-black">
      <h2 class="text-xl font-bold text-white">Histórico de Compras</h2>
    </div>
    <div class="p-6">
    </div>
  </div>
</div>