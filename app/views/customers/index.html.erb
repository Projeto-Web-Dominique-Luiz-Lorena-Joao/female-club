<div class="space-y-4 sm:space-y-6">

  <!-- Header - Responsivo -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Clientes</h1>
      <p class="mt-1 sm:mt-2 text-sm sm:text-base text-gray-600">Gerenciar base de clientes</p>
    </div>
    <%= link_to new_customer_path,
      class: "bg-black hover:bg-gray-700 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg font-medium shadow-lg transition duration-200 inline-flex items-center justify-center text-sm sm:text-base" do %>
      <svg class="w-5 h-5 mr-2 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      <span class="hidden sm:inline">Novo Cliente</span>
      <span class="sm:hidden">Novo</span>
    <% end %>
  </div>

  <!-- Cards de Estatísticas - Responsivos -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-4 sm:gap-6">

    <!-- Card Clientes -->
    <div class="bg-white rounded-lg border border-gray-200 p-3 sm:p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-gray-100 rounded-lg p-2 sm:p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Total de Clientes</p>
          <p class="text-xl sm:text-2xl font-bold text-gray-900 mt-1"><%= @total_customers %></p>
        </div>
      </div>
    </div>

    <!-- Card Faturamento -->
    <div class="bg-white rounded-lg border border-gray-200 p-3 sm:p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-2 sm:p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <div class="ml-3 flex-1 min-w-0">
          <p class="text-xs text-gray-500 font-medium">Serviços Ativos</p>
          <p class="text-lg sm:text-xl font-bold text-green-600 mt-1 truncate">
            R$ <%= number_with_delimiter(@total_revenue.to_f.round(2), delimiter: ".", separator: ",") %>
          </p>
        </div>
      </div>
    </div>

  </div>

  <!-- Filtros - Responsivos -->
  <div class="bg-white rounded-lg shadow p-4 sm:p-6">
    <%= form_with url: customers_path, method: :get, class: "space-y-4", local: true do %>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">

        <div class="flex-1">
          <%= text_field_tag :search, params[:search],
            placeholder: "Buscar por nome, CPF, telefone ou e-mail",
            class: "w-full px-3 sm:px-4 py-2 border border-gray-300 rounded-lg text-sm sm:text-base" %>
        </div>

        <div class="flex gap-2 sm:gap-3">
          <%= submit_tag "Buscar",
              class: "flex-1 sm:flex-none bg-black hover:bg-gray-700 text-white px-4 sm:px-6 py-2 rounded-lg font-medium transition duration-200 text-sm sm:text-base" %>

          <%= link_to "Limpar", customers_path,
              class: "flex-1 sm:flex-none bg-gray-300 hover:bg-gray-200 text-gray-700 px-4 sm:px-6 py-2 rounded-lg font-medium transition duration-200 text-center text-sm sm:text-base" %>
        </div>

      </div>
    <% end %>
  </div>

  <!-- Paginação Topo -->
  <% if @customers.any? %>
    <%= render "shared/pagination_top", collection: @customers %>
  <% end %>

  <!-- Tabela - Responsiva com scroll horizontal em mobile -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @customers.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-black">
            <tr>
              <th class="px-4 sm:px-6 py-3 text-center text-xs font-medium text-white uppercase whitespace-nowrap">Cliente</th>
              <th class="px-4 sm:px-6 py-3 text-center text-xs font-medium text-white uppercase whitespace-nowrap">CPF</th>
              <th class="px-4 sm:px-6 py-3 text-center text-xs font-medium text-white uppercase whitespace-nowrap">Contato</th>
              <th class="px-4 sm:px-6 py-3 text-center text-xs font-medium text-white uppercase whitespace-nowrap">Gasto Total</th>
              <th class="px-4 sm:px-6 py-3 text-center text-xs font-medium text-white uppercase whitespace-nowrap">Ações</th>
            </tr>
          </thead>

          <tbody class="bg-white divide-y divide-gray-200">
            <% @customers.each do |customer| %>
              <tr class="hover:bg-gray-50">

                <td class="px-4 sm:px-6 py-3 sm:py-4">
                  <p class="text-sm text-center font-medium text-gray-900 whitespace-nowrap">
                    <%= customer.full_name %>
                  </p>
                  <% if customer.age.present? %>
                    <p class="text-xs text-center text-gray-500"><%= customer.age %> anos</p>
                  <% end %>
                </td>

                <td class="px-4 sm:px-6 py-3 sm:py-4 text-sm text-center text-gray-900 whitespace-nowrap">
                  <%= customer.formatted_cpf %>
                </td>

                <td class="px-4 sm:px-6 py-3 sm:py-4 text-sm text-center text-gray-900">
                  <p class="whitespace-nowrap"><%= customer.formatted_phone %></p>
                  <p class="text-xs text-center text-gray-500 truncate max-w-[150px]"><%= customer.email || "-" %></p>
                </td>

                <td class="px-4 sm:px-6 py-3 sm:py-4 text-center text-sm text-gray-900 whitespace-nowrap">
                  <span class="font-semibold text-green-600">
                    R$ <%= number_to_currency(customer.total_spent.to_f, unit: "", delimiter: ".", separator: ",", precision: 2) %>
                  </span>
                </td>

                <td class="px-4 sm:px-6 py-3 sm:py-4 text-center">
                  <%= link_to customer_path(customer),
                      class: "inline-flex items-center justify-center bg-blue-200 text-blue-700 px-3 sm:px-5 py-2 rounded-lg hover:bg-blue-100 text-sm font-medium whitespace-nowrap" do %>
                    <span class="hidden sm:inline">Visualizar</span>
                    <svg class="w-5 h-5 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                  <% end %>
                </td>

              </tr>
            <% end %>
          </tbody>

        </table>
      </div>

    <% else %>

      <div class="text-center py-8 sm:py-12 px-4">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        <p class="mt-4 text-lg sm:text-xl text-gray-600">Nenhum cliente cadastrado</p>
        <%= link_to "Cadastrar primeiro cliente", new_customer_path,
            class: "mt-4 inline-block bg-black hover:bg-gray-700 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg font-medium transition duration-200 text-sm sm:text-base" %>
      </div>

    <% end %>
  </div>

  <!-- Paginação Bottom -->
  <%= render "shared/pagination_top", collection: @customers %>
</div>
