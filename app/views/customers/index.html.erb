<div class="space-y-6">
  <!-- Header -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Clientes</h1>
      <p class="mt-2 text-gray-600">Gerenciar base de clientes</p>
    </div>
    <%= link_to new_customer_path, class: "bg-gray-900 hover:bg-gray-400 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition inline-flex items-center" do %>
      Novo Cliente
    <% end %>
  </div>

  <!-- Estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Total de Clientes</p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= @total_customers %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Clientes Ativos</p>
      <p class="text-3xl font-bold text-green-600 mt-2"><%= @active_customers %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Faturamento Total</p>
      <p class="text-2xl font-bold text-blue-600 mt-2">R$ <%= number_with_delimiter(@total_revenue.to_f.round(2), delimiter: '.', separator: ',') %></p>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: customers_path, method: :get, class: "space-y-4" do %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2">
          <%= text_field_tag :search, params[:search], 
              placeholder: "Buscar por nome, CPF ou telefone...", 
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500" %>
        </div>

        <div>
          <%= select_tag :tier, 
              options_for_select([
                ['Todos os Clientes', ''],
                ['Clientes VIP', 'vip'],
                ['Clientes Ativos', 'active']
              ], params[:tier]),
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500" %>
        </div>
      </div>

      <div class="flex space-x-2">
        <%= submit_tag "Buscar", class: "bg-blue-900 hover:bg-blue-400 text-white px-6 py-2 rounded-lg font-medium transition" %>
        <%= link_to "Limpar", customers_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-2 rounded-lg font-medium transition" %>
      </div>
    <% end %>
  </div>

  <!-- Lista -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @customers.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">CPF</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Contato</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Compras</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Gasto Total</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Categoria</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @customers.each do |customer| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <p class="text-sm font-medium text-gray-900"><%= customer.full_name %></p>
                <% if customer.age %>
                  <p class="text-xs text-gray-500"><%= customer.age %> anos</p>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900"><%= customer.formatted_cpf %></td>
              <td class="px-6 py-4 text-sm text-gray-900">
                <p><%= customer.formatted_phone %></p>
                <p class="text-xs text-gray-500"><%= customer.email || '-' %></p>
              </td>
              <td class="px-6 py-4 text-center">
               
          
              </td>
              <td class="px-6 py-4 text-center">
                </span>
              </td>
              <td class="px-6 py-4 text-right space-x-2">
                <%= link_to "👁️", customer_path(customer), class: "text-blue-600 hover:text-blue-800" %>
                <%= link_to "✏️", edit_customer_path(customer), class: "text-yellow-600 hover:text-yellow-800" %>
                <%= button_to "🗑️", customer_path(customer), 
                    method: :delete, 
                    data: { confirm: "Tem certeza?" },
                    class: "text-red-600 hover:text-red-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-12">
        <p class="mt-4 text-xl text-gray-600">Nenhum cliente cadastrado</p>
        <%= link_to "Cadastrar primeiro cliente", new_customer_path, 
            class: "mt-4 inline-block bg-pink-600 hover:bg-pink-700 text-white px-6 py-3 rounded-lg font-medium" %>
      </div>
    <% end %>
  </div>
</div>