<div class="space-y-6">

  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Clientes</h1>
      <p class="mt-2 text-gray-600">Gerenciar base de clientes</p>
    </div>
    <%= link_to new_customer_path,
      class: "bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition duration-200 inline-flex items-center" do %>
      Novo Cliente
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">

   <!-- Card Clientes -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
        <div class="flex items-start">
          <div class="flex-shrink-0 bg-gray-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
          </div>
          <div class="ml-3 flex-1">
            <p class="text-xs text-gray-500 font-medium">Total de Clientes</p>
            <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total_customers %></p>
          </div>
        </div>
      </div>

    <!-- Card Faturamento -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Serviços Ativos</p>
          <p class="text-2xl font-bold text-green-600 mt-1">
            R$ <%= number_with_delimiter(@total_revenue.to_f.round(2), delimiter: ".", separator: ",") %>
          </p>
        </div>
      </div>
    </div>
    
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: customers_path, method: :get, class: "space-y-4", local: true do %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <div class="md:col-span-2">
          <%= text_field_tag :search, params[:search],
            placeholder: "Buscar por nome, CPF, telefone ou e-mail",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
        </div>

        <div class="flex justify-end space-x-2 items-center">
          <%= submit_tag "Buscar",
              class: "bg-black hover:bg-gray-700 text-white px-6 py-2 rounded-lg font-medium transition duration-200" %>

          <%= link_to "Limpar", customers_path,
              class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition duration-200" %>
        </div>

      </div>
    <% end %>
  </div>

  <!-- Paginação Topo -->
  <% if @customers.any? %>
    <%= render "shared/pagination_top", collection: @customers %>
  <% end %>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @customers.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-black">
          <tr>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Cliente</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">CPF</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Contato</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Gasto Total</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase w-32">Ações</th>
          </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-200">
          <% @customers.each do |customer| %>
            <tr class="hover:bg-gray-50">

              <td class="px-6 py-4">
                <p class="text-sm text-center font-medium text-gray-900">
                  <%= customer.full_name %>
                </p>
                <% if customer.age.present? %>
                  <p class="text-xs text-center text-gray-500"><%= customer.age %> anos</p>
                <% end %>
              </td>

              <td class="px-6 py-4 text-sm text-center text-gray-900">
                <%= customer.formatted_cpf %>
              </td>

              <td class="px-6 py-4 text-sm text-center text-gray-900">
                <p><%= customer.formatted_phone %></p>
                <p class="text-xs text-center text-gray-500"><%= customer.email || "-" %></p>
              </td>

              <td class="px-6 py-4 text-center text-sm text-gray-900">
                -
              </td>

              <td class="px-6 py-4 text-center space-x-2">
                <div class="flex flex-col items-center space-y-2 w-full">

                  <%= link_to "Visualizar", customer_path(customer),
                      class: "bg-blue-200 text-blue-700 px-5 py-2 rounded-lg hover:bg-blue-100 text-center text-sm font-medium" %>

                </div>
              </td>

            </tr>
          <% end %>
        </tbody>

      </table>

    <% else %>

      <div class="text-center py-12">
        <p class="mt-4 text-xl text-gray-600">Nenhum cliente cadastrado</p>
        <%= link_to "Cadastrar primeiro cliente", new_customer_path,
            class: "mt-4 inline-block bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium transition duration-200" %>
      </div>

    <% end %>
  </div>

  <%= render "shared/pagination_top", collection: @customers %>
</div>
