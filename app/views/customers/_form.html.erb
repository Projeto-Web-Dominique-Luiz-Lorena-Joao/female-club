<div data-controller="guarantor-form" class="space-y-6">
  <%= form_with(model: customer, class: "space-y-8") do |form| %>
    
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="px-6 py-4 bg-gray-900 border-b border-gray-200">
        <h2 class="text-xl font-bold text-white">Informações do Cliente</h2>
      </div>

      <div class="p-6">
        <% if customer.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md mb-6">
            <div class="flex">
              <span class="text-red-500 text-xl">⚠️</span>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(customer.errors.count, "erro") %>:
                </h3>
                <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                  <% customer.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="md:col-span-2">
            <%= form.label :full_name, "Nome Completo *", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :full_name, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent", required: true %>
          </div>

          <div>
            <%= form.label :cpf, "CPF *", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :cpf, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent", placeholder: "000.000.000-00", maxlength: 14, required: true %>
          </div>

          <div>
            <%= form.label :birth_date, "Data de Nascimento", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.date_field :birth_date, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div>
            <%= form.label :phone_number, "Telefone *", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :phone_number, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent", placeholder: "(00) 00000-0000", required: true %>
          </div>

          <div>
            <%= form.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.email_field :email, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent", placeholder: "email@exemplo.com" %>
          </div>

          <div class="md:col-span-2">
            <%= form.label :full_address, "Endereço Completo", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_area :full_address, rows: 2, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent", placeholder: "Rua, número, complemento, bairro, cidade - CEP" %>
          </div>

          <div class="md:col-span-2">
            <%= form.label :notes, "Observações", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_area :notes, rows: 3, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>
          
          <div class="md:col-span-2 flex justify-end">
            <div class="flex items-center gap-3">
              <label class="text-md font-medium text-gray-900 text-right cursor-pointer select-none"
                    onclick="this.closest('.flex').querySelector('input[type=checkbox]').click()">
                Deseja cadastrar um fiador?
              </label>
              <label class="relative inline-flex items-center cursor-pointer shrink-0">
                <input type="checkbox"
                      class="sr-only peer"
                      data-guarantor-form-target="toggle"
                      data-action="change->guarantor-form#toggleSection"
                      <%= 'checked' if customer.guarantor.present? %>>
                <div class="relative w-14 h-7 bg-gray-200 rounded-full
                            peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-green-300
                            after:content-[''] after:absolute after:top-0.5 after:left-[4px]
                            after:bg-white after:border-gray-300 after:border after:rounded-full
                            after:h-6 after:w-6 after:transition-all
                            peer-checked:after:translate-x-full peer-checked:bg-green-600">
                </div>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>


    <% guarantor = customer.guarantor || Guarantor.new %>
      <div data-guarantor-form-target="section" class="bg-white rounded-lg shadow-lg overflow-hidden transition-all duration-300 <%= 'hidden' unless customer.guarantor.present? %>">
      <div class="px-6 py-4 bg-gray-900 border-b flex justify-between items-center">
        <h2 class="text-xl font-bold text-white">Informações do Fiador</h2>
      </div>

      <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <% if guarantor.try(:id) %>
          <input type="hidden" name="guarantor[id]" value="<%= guarantor.id %>">
        <% end %>

        <div class="md:col-span-1">
          <label class="block text-sm font-medium text-gray-700 mb-2">Nome do Fiador *</label>
          <input type="text" 
                 name="guarantor[full_name]" 
                 value="<%= guarantor.full_name %>"
                 data-guarantor-form-target="input"
                 class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:border-transparent"
                 placeholder="Nome completo">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Parentesco *</label>
          <select name="guarantor[relationship]" 
                  data-guarantor-form-target="input"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
            <option value="">Selecione...</option>
            <%= options_for_select(['Pai', 'Mãe', 'Irmão(a)', 'Esposo(a)', 'Avô(a)', 'Tio(a)', 'Primo(a)', 'Amigo(a)', 'Outro'], guarantor.relationship) %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">CPF do Fiador</label>
          <input type="text" 
                 name="guarantor[cpf]" 
                 value="<%= guarantor.cpf %>"
                 data-guarantor-form-target="input"
                 class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                 placeholder="000.000.000-00"
                 maxlength="14">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Telefone do Fiador</label>
          <input type="text" 
                 name="guarantor[phone]" 
                 value="<%= guarantor.phone %>"
                 data-guarantor-form-target="input"
                 class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                 placeholder="(00) 00000-0000">
        </div>

        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-2">Endereço do Fiador</label>
          <textarea name="guarantor[address]" 
                    rows="2"
                    data-guarantor-form-target="input"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                    placeholder="Endereço completo"><%= guarantor.address %></textarea>
        </div>
      </div>
    </div>

    <div class="flex justify-end space-x-3 pt-6 border-t border-gray-200">
      <%= link_to "Cancelar", customers_path, class: "px-6 py-3 rounded-lg bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium transition" %>
      <%= form.submit "Salvar Cliente", class: "px-6 py-3 bg-green-600 hover:bg-green-500 text-white rounded-lg font-medium shadow-lg transition cursor-pointer" %>
    </div>
  <% end %>
</div>


<script>
(function() {
  console.log('Máscaras ativadas!');

  function aplicar() {
    // Máscara para CPF do cliente
    const cpf = document.querySelector('input[name="customer[cpf]"]');
    if (cpf && !cpf.dataset.m) {
      cpf.dataset.m = '1';

    cpf.addEventListener("input", function(e) {
    let cursor = e.target.selectionStart;
    let old = e.target.value;
    let clean = old.replace(/\D/g, '');

    const before = old.slice(0, cursor).replace(/\D/g, '').length;

    const masked = formatCPF(clean);
    e.target.value = masked;

    let newCursor = masked.length;
    let count = 0;

    for (let i = 0; i < masked.length; i++) {
      if (masked[i].match(/\d/)) count++;
      if (count == before) {
        newCursor = i + 1;
        break;
      }
    }

  e.target.setSelectionRange(newCursor, newCursor);
  });


      console.log("CPF ok");
    }

    const tel = document.querySelector('input[name="customer[phone_number]"]');
    if (tel && !tel.dataset.mtel) {
      tel.dataset.mtel = '1';

      tel.addEventListener('input', function(e) {
        let cursor = e.target.selectionStart;
        let clean = e.target.value.replace(/\D/g, '');

        if (e.inputType === "deleteContentBackward") {
          e.target.value = formatPhone(clean);
          e.target.setSelectionRange(cursor, cursor);
          return;
        }

        e.target.value = formatPhone(clean);
        e.target.setSelectionRange(e.target.value.length, e.target.value.length);
      });

      console.log('Telefone ok');
    }

    // Máscara para CPF do fiador no modal
    const guarantorCpf = document.querySelector('[data-guarantor-modal-target="guarantorCpf"]');
    if (guarantorCpf && !guarantorCpf.dataset.m) {
      guarantorCpf.dataset.m = '1';

      guarantorCpf.addEventListener("input", function(e) {
        let cursor = e.target.selectionStart;
        let old = e.target.value;
        let clean = old.replace(/\D/g, '');

        const before = old.slice(0, cursor).replace(/\D/g, '').length;

        const masked = formatCPF(clean);
        e.target.value = masked;

        let newCursor = masked.length;
        let count = 0;

        for (let i = 0; i < masked.length; i++) {
          if (masked[i].match(/\d/)) count++;
          if (count == before) {
            newCursor = i + 1;
            break;
          }
        }

        e.target.setSelectionRange(newCursor, newCursor);
      });

      console.log("CPF do fiador ok");
    }

    // Máscara para Telefone do fiador no modal
    const guarantorPhone = document.querySelector('[data-guarantor-modal-target="guarantorPhone"]');
    if (guarantorPhone && !guarantorPhone.dataset.mtel) {
      guarantorPhone.dataset.mtel = '1';

      guarantorPhone.addEventListener('input', function(e) {
        let cursor = e.target.selectionStart;
        let clean = e.target.value.replace(/\D/g, '');

        if (e.inputType === "deleteContentBackward") {
          e.target.value = formatPhone(clean);
          e.target.setSelectionRange(cursor, cursor);
          return;
        }

        e.target.value = formatPhone(clean);
        e.target.setSelectionRange(e.target.value.length, e.target.value.length);
      });

      console.log('Telefone do fiador ok');
    }
  }

  function formatCPF(v) {
    if (v.length > 11) v = v.slice(0, 11);

    if (v.length > 9) {
      return v.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, "$1.$2.$3-$4");
    } else if (v.length > 6) {
      return v.replace(/(\d{3})(\d{3})(\d{1,3})/, "$1.$2.$3");
    } else if (v.length > 3) {
      return v.replace(/(\d{3})(\d{1,3})/, "$1.$2");
    }
    return v;
  }

  function formatPhone(v) {
    if (v.length > 11) v = v.slice(0, 11);

    if (v.length > 10) {
      return v.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
    } else if (v.length > 6) {
      return v.replace(/(\d{2})(\d{4,5})(\d{0,4})/, '($1) $2-$3');
    } else if (v.length > 2) {
      return v.replace(/(\d{2})(\d{0,5})/, '($1) $2');
    } else if (v.length > 0) {
      return '(' + v;
    }
    return v;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', aplicar);
  } else {
    aplicar();
  }

  document.addEventListener('turbo:load', aplicar);

})();

</script>