<%= form_with(model: customer, class: "space-y-6") do |form| %>
  <% if customer.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md">
      <div class="flex">
        <span class="text-red-500 text-xl">⚠️</span>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(customer.errors.count, "erro") %>:
          </h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% customer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <div class="md:col-span-2">
      <%= form.label :full_name, "Nome Completo *", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :full_name,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
          required: true %>
    </div>

    <div>
      <%= form.label :cpf, "CPF *", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :cpf,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
          placeholder: "000.000.000-00",
          maxlength: 14,
          required: true %>
    </div>

    <div>
      <%= form.label :birth_date, "Data de Nascimento", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :birth_date,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
    </div>

    <div>
      <%= form.label :phone_number, "Telefone *", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :phone_number,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
          placeholder: "(00) 00000-0000",
          required: true %>
    </div>

    <div>
      <%= form.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.email_field :email,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
          placeholder: "email@exemplo.com" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :full_address, "Endereço Completo", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :full_address,
          rows: 2,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
          placeholder: "Rua, número, complemento, bairro, cidade - CEP" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :notes, "Observações", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :notes,
          rows: 3,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
          placeholder: "Preferências, alergias, observações importantes..." %>
    </div>
  </div>

  <div class="flex justify-end space-x-2 pt-6 ">
    <%= link_to "Cancelar", customers_path,
        class: "px-6 py-3 rounded-lg bg-gray-300 hover:bg-gray-200 text-gray-700 font-medium transition" %>
    <%= form.submit "Salvar Cliente",
        class: "px-6 py-3 bg-green-600 hover:bg-green-500 text-white rounded-lg font-medium shadow-lg transition" %>
  </div>

<% end %>

<script>
(function() {
  console.log('Máscaras ativadas!');

  function aplicar() {

    const cpf = document.querySelector('input[name="customer[cpf]"]');
    if (cpf && !cpf.dataset.m) {
      cpf.dataset.m = '1';

    cpf.addEventListener("input", function(e) {
    let cursor = e.target.selectionStart;
    let old = e.target.value;
    let clean = old.replace(/\D/g, '');

    const before = old.slice(0, cursor).replace(/\D/g, '').length;

    const masked = formatCPF(clean);
    e.target.value = masked;

    let newCursor = masked.length;
    let count = 0;

    for (let i = 0; i < masked.length; i++) {
      if (masked[i].match(/\d/)) count++;
      if (count == before) {
        newCursor = i + 1;
        break;
      }
    }

  e.target.setSelectionRange(newCursor, newCursor);
  });


      console.log("CPF ok");
    }

    const tel = document.querySelector('input[name="customer[phone_number]"]');
    if (tel && !tel.dataset.mtel) {
      tel.dataset.mtel = '1';

      tel.addEventListener('input', function(e) {
        let cursor = e.target.selectionStart;
        let clean = e.target.value.replace(/\D/g, '');

        if (e.inputType === "deleteContentBackward") {
          e.target.value = formatPhone(clean);
          e.target.setSelectionRange(cursor, cursor);
          return;
        }

        e.target.value = formatPhone(clean);
        e.target.setSelectionRange(e.target.value.length, e.target.value.length);
      });

      console.log('Telefone ok');
    }
  }

  function formatCPF(v) {
    if (v.length > 11) v = v.slice(0, 11);

    if (v.length > 9) {
      return v.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, "$1.$2.$3-$4");
    } else if (v.length > 6) {
      return v.replace(/(\d{3})(\d{3})(\d{1,3})/, "$1.$2.$3");
    } else if (v.length > 3) {
      return v.replace(/(\d{3})(\d{1,3})/, "$1.$2");
    }
    return v;
  }

  function formatPhone(v) {
    if (v.length > 11) v = v.slice(0, 11);

    if (v.length > 10) {
      return v.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
    } else if (v.length > 6) {
      return v.replace(/(\d{2})(\d{4,5})(\d{0,4})/, '($1) $2-$3');
    } else if (v.length > 2) {
      return v.replace(/(\d{2})(\d{0,5})/, '($1) $2');
    } else if (v.length > 0) {
      return '(' + v;
    }
    return v;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', aplicar);
  } else {
    aplicar();
  }

  document.addEventListener('turbo:load', aplicar);

})();

</script>