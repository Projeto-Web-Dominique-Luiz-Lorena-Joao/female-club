<aside class="bg-black text-white flex flex-col h-screen transition-all duration-300 fixed left-0 top-0 z-40 w-72"
       data-sidebar-target="sidebar">
  
  <div class="p-4 pl-5 border-b border-gray-700 relative">
    <div class="flex items-center">
      <div class="w-10 h-10 bg-gray-700 rounded flex items-center justify-center flex-shrink-0">
        <span class="text-xs text-gray-400">Logo</span>
      </div>
      <h1 class="text-xl font-bold transition-opacity duration-300 ml-3 whitespace-nowrap" 
          data-sidebar-target="text">Female Club</h1>
    </div>

    <button data-action="click->sidebar#toggle" 
            class="absolute top-1/2 -translate-y-1/2 -right-3 bg-gray-800 hover:bg-gray-700 rounded-full p-1 border border-gray-600 z-50">
      <svg class="w-4 h-4 text-white transition-transform duration-300" 
           data-sidebar-target="arrow"
           fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>
  </div>

  <nav class="flex-1 py-6 px-3 overflow-y-auto">
    <%= link_to dashboard_path, class: "flex items-center px-3 py-3 rounded-lg transition-all duration-300 mb-2 #{active_class(dashboard_path)}", title: "Dashboard", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Dashboard</span>
    <% end %>

    <%= link_to customers_path, class: "flex items-center px-3 py-3 rounded-lg transition-all duration-300 mb-2 #{active_class(customers_path)}", title: "Clientes", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Clientes</span>
    <% end %>

    <%= link_to services_path, class: "flex items-center px-3 py-3 text-gray-300 hover:bg-white/10 hover:text-white rounded-lg transition-all duration-300 mb-2", title: "Serviços", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Serviços</span>
    <% end %>

    <%= link_to products_path, class: "flex items-center px-3 py-3 text-gray-300 hover:bg-white/10 hover:text-white rounded-lg transition-all duration-300 mb-2", title: "Produtos", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Produtos</span>
    <% end %>

    <%= link_to "#", class: "flex items-center px-3 py-3 text-gray-300 hover:bg-white/10 hover:text-white rounded-lg transition-all duration-300 mb-2", title: "Estoque", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Estoque</span>
    <% end %>

    <%= link_to employees_path, class: "flex items-center px-3 py-3 rounded-lg transition-all duration-300 mb-2 #{active_class(employees_path)}", title: "Funcionários", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M4.5 17H4a1 1 0 0 1-1-1 3 3 0 0 1 3-3h1m0-3.05A2.5 2.5 0 1 1 9 5.5M19.5 17h.5a1 1 0 0 0 1-1 3 3 0 0 0-3-3h-1m0-3.05a2.5 2.5 0 1 0-2-4.45m.5 13.5h-5a1 1 0 0 1-1-1 3 3 0 0 1 3-3h3a3 3 0 0 1 3 3 1 1 0 0 1-1 1Zm-1-9.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Z"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Funcionários</span>
    <% end %>

    <%= link_to service_appointments_path, class: "flex items-center px-3 py-3 text-gray-300 hover:bg-white/10 hover:text-white rounded-lg transition-all duration-300 mb-2", title: "Agendamentos", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Agendamentos</span>
    <% end %>

    <%= link_to sales_path, class: "flex items-center px-3 py-3 rounded-lg transition-all duration-300 mb-2 #{active_class(sales_path)}", title: "Vendas", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Vendas</span>
    <% end %>

    <%= link_to expenses_path, class: "flex items-center px-3 py-3 text-gray-300 hover:bg-white/10 hover:text-white rounded-lg transition-all duration-300 mb-2", title: "Financeiro", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Financeiro</span>
    <% end %>

    <%= link_to suppliers_path, class: "flex items-center px-3 py-3 rounded-lg transition-all duration-300 mb-2 #{active_class(suppliers_path)}", title: "Fornecedores", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Fornecedores</span>
    <% end %>

    <%= link_to guarantors_path, class: "flex items-center px-3 py-3 rounded-lg transition-all duration-300 mb-2 #{active_class(guarantors_path)}", title: "Fiadores", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Fiadores</span>
    <% end %>
  </nav>

  <div class="border-t border-gray-700 py-4 px-3 space-y-2">
    <%= link_to "#", class: "flex items-center px-3 py-3 text-gray-300 hover:bg-white/10 hover:text-white rounded-lg transition-all duration-300 mb-2", title: "Configurações", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Configurações</span>
    <% end %>

    <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center w-full px-3 py-3 text-gray-300 hover:bg-red-800 hover:text-white rounded-lg transition-all duration-300", title: "Sair", data: { sidebar_target: "link" } do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      <span class="ml-3 whitespace-nowrap" data-sidebar-target="text">Sair</span>
    <% end %>
  </div>
</aside>