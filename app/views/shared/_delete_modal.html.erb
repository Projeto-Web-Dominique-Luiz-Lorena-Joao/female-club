<div id="deleteModal"
     class="hidden absolute inset-0 z-[9999] flex items-center justify-center bg-black/20">

  <div id="deleteModalBox"
       class="bg-white max-w-md w-full rounded-xl shadow-2xl p-6">

    <div class="flex justify-center mb-4">
      <div class="w-12 h-12 flex items-center justify-center rounded-full bg-red-100">
        <span class="text-red-600 text-3xl font-bold">!</span>
      </div>
    </div>

    <h2 class="text-xl font-semibold text-center text-gray-800">
      Confirmar exclusão
    </h2>

    <p class="mt-3 text-center text-gray-600">
      Tem certeza que deseja excluir o
      <span id="deleteType" class="font-medium"></span>
      <span id="deleteName" class="font-medium"></span>?
    </p>

    <div class="mt-6 flex justify-center space-x-3">
      <button onclick="closeDeleteModal()"
              class="px-5 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 transition">
        Cancelar
      </button>

      <form id="deleteForm" method="post" class="inline" data-turbo="false">
        <input type="hidden" name="_method" value="delete">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

        <button type="submit" class="px-5 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700 transition">
          Excluir
        </button>
      </form>
    </div>

  </div>
</div>

<script>
  function openDeleteModal(basePath, id, name, label) {
    const modal = document.getElementById("deleteModal");
    const form  = document.getElementById("deleteForm");

    document.getElementById("deleteName").innerText = name;
    document.getElementById("deleteType").innerText = label;

    form.action = `${basePath}/${id}`;
    form.dataset.redirectUrl = basePath;

    modal.classList.remove("hidden");
  }

  function closeDeleteModal() {
    const modal = document.getElementById("deleteModal");
    modal.classList.add("hidden");
  }
</script>
