<div class="min-h-screen flex">
  <!-- Lado Esquerdo - Formulário -->
  <div class="w-full lg:w-1/2 bg-white flex items-center justify-center p-8">
    <div class="max-w-md w-full">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Female Club</h1>
        <div class="w-16 h-1 bg-gray-900 mb-8"></div>

        <h2 class="text-2xl font-semibold text-gray-900 mb-2">Criar nova senha</h2>
        <p class="text-gray-600">Digite sua nova senha abaixo. Ela deve ter no mínimo <%= @minimum_password_length %> caracteres, com maiúsculas, minúsculas, números e caractere especial.</p>
      </div>

      <!-- Mensagem de erro -->
      <% if flash[:alert] %>
        <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center">
          <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div>
          <%= f.label :password, "Nova senha", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <%= f.password_field :password,
                autofocus: true,
                autocomplete: "new-password",
                placeholder: "Mín. 8 chars, maiúsc., minúsc., número e especial",
                id: "password-field",
                class: "w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
            <button type="button"
                    onclick="togglePassword('password-field', 'eye-closed-1', 'eye-open-1')"
                    class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700">
              <svg id="eye-closed-1" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
              </svg>
              <svg id="eye-open-1" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar nova senha", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                placeholder: "Digite a senha novamente",
                id: "password-confirm-field",
                class: "w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
            <button type="button"
                    onclick="togglePassword('password-confirm-field', 'eye-closed-2', 'eye-open-2')"
                    class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700">
              <svg id="eye-closed-2" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
              </svg>
              <svg id="eye-open-2" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Dicas de senha segura -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
          <h4 class="text-sm font-medium text-gray-700 mb-2">Dicas para uma senha segura:</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li class="flex items-center">
              <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Mínimo de <%= @minimum_password_length %> caracteres
            </li>
            <li class="flex items-center">
              <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Combine letras maiúsculas e minúsculas
            </li>
            <li class="flex items-center">
              <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Inclua números e caracteres especiais
            </li>
          </ul>
        </div>

        <div>
          <%= f.submit "Alterar minha senha", class: "w-full bg-black hover:bg-gray-700 text-white font-medium py-3 px-4 rounded-lg transition duration-200 cursor-pointer" %>
        </div>

        <div class="text-center text-sm text-gray-600">
          <%= link_to "Voltar para o login", new_session_path(resource_name), class: "text-gray-900 font-medium hover:underline" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Lado Direito -->
  <div class="hidden lg:flex lg:w-1/2 bg-black items-center justify-center p-12">
    <div class="max-w-lg text-center">
      <div class="mb-7 flex justify-center">
        <%= image_tag "logo.png", alt: "Female Club Logo", class: "w-32 h-32 object-contain" %>
      </div>

      <h2 class="text-white text-3xl font-bold mb-4">Quase lá!</h2>

      <p class="text-gray-300 text-[14px] mb-6 max-w-md mx-auto leading-relaxed">
        Crie uma nova senha segura para sua conta.<br>
        Após alterar, você será redirecionada para o sistema.
      </p>

      <div class="grid grid-cols-1 gap-6 max-w-sm mx-auto">
        <div class="bg-gray-900 p-6 rounded-lg flex items-center">
          <div class="bg-green-600 p-3 rounded-lg mr-4">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div class="text-left">
            <h3 class="text-white font-semibold text-lg">Email Verificado</h3>
            <p class="text-gray-400 text-[13px]">Link válido e confirmado</p>
          </div>
        </div>

        <div class="bg-gray-900 p-6 rounded-lg flex items-center">
          <div class="bg-gray-800 p-3 rounded-lg mr-4 border-2 border-white">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
          </div>
          <div class="text-left">
            <h3 class="text-white font-semibold text-lg">Criar Nova Senha</h3>
            <p class="text-gray-400 text-[13px]">Você está aqui</p>
          </div>
        </div>

        <div class="bg-gray-900 p-6 rounded-lg flex items-center opacity-60">
          <div class="bg-gray-800 p-3 rounded-lg mr-4">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
          </div>
          <div class="text-left">
            <h3 class="text-white font-semibold text-lg">Acessar Sistema</h3>
            <p class="text-gray-400 text-[13px]">Próximo passo</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function togglePassword(fieldId, eyeClosedId, eyeOpenId) {
  const passwordField = document.getElementById(fieldId);
  const eyeClosedIcon = document.getElementById(eyeClosedId);
  const eyeOpenIcon = document.getElementById(eyeOpenId);

  if (passwordField.type === 'password') {
    passwordField.type = 'text';
    eyeClosedIcon.classList.add('hidden');
    eyeOpenIcon.classList.remove('hidden');
  } else {
    passwordField.type = 'password';
    eyeClosedIcon.classList.remove('hidden');
    eyeOpenIcon.classList.add('hidden');
  }
}
</script>
