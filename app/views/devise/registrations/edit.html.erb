<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Editar Perfil</h1>
      <p class="mt-2 text-gray-600">Gerencie suas informações e preferências</p>
    </div>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "bg-white rounded-lg shadow p-6 space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <!-- Informações da Conta -->
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-gray-900 border-b pb-2">Informações da Conta</h2>

      <div>
        <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded-lg">
          Aguardando confirmação para: <%= resource.unconfirmed_email %>
        </div>
      <% end %>
    </div>

    <!-- Alterar Senha -->
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-gray-900 border-b pb-2">Alterar Senha</h2>
      <p class="text-sm text-gray-600">Deixe em branco se não quiser alterar</p>

      <div>
        <%= f.label :password, "Nova Senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent" %>
        <% if @minimum_password_length %>
          <p class="mt-1 text-xs text-gray-500">Mínimo de <%= @minimum_password_length %> caracteres</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirmar Nova Senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent" %>
      </div>
    </div>

    <!-- Preferências -->
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-gray-900 border-b pb-2">Preferências</h2>

      <div>
        <%= f.label :items_per_page, "Registros por página (padrão)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :items_per_page,
            options_for_select(
              [
                ["10 registros", 10],
                ["15 registros", 15],
                ["20 registros", 20],
                ["25 registros", 25],
                ["50 registros", 50]
              ],
              resource.items_per_page || 15
            ),
            {},
            { class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent" } %>
        <p class="mt-1 text-xs text-gray-500">Define quantos registros serão exibidos por padrão nas listagens</p>
      </div>
    </div>

    <!-- Confirmação -->
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-gray-900 border-b pb-2">Confirmar Alterações</h2>

      <div>
        <%= f.label :current_password, "Senha Atual", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :current_password, autocomplete: "current-password",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent" %>
        <p class="mt-1 text-xs text-gray-500">Precisamos da sua senha atual para confirmar as alterações</p>
      </div>
    </div>

    <!-- Botões -->
    <div class="flex items-center justify-between pt-4 border-t">
      <%= link_to "Voltar", :back, class: "text-gray-600 hover:text-gray-900 font-medium" %>
      <%= f.submit "Atualizar Perfil", class: "bg-black hover:bg-gray-800 text-white px-6 py-3 rounded-lg font-medium transition duration-200 cursor-pointer" %>
    </div>
  <% end %>

  <!-- Cancelar Conta -->
  <div class="bg-red-50 border border-red-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-red-900 mb-2">Zona de Perigo</h3>
    <p class="text-sm text-red-700 mb-4">Uma vez que você deletar sua conta, não há como voltar atrás.</p>
    <%= button_to "Cancelar minha conta",
        registration_path(resource_name),
        data: { confirm: "Tem certeza? Esta ação não pode ser desfeita!", turbo_confirm: "Tem certeza? Esta ação não pode ser desfeita!" },
        method: :delete,
        class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium transition duration-200" %>
  </div>
</div>
