<div class="min-h-screen flex">
  <!-- Lado Esquerdo - Formulário -->
  <div class="w-full lg:w-1/2 bg-white flex items-center justify-center p-8">
    <div class="max-w-md w-full">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Female Club</h1>
        <div class="w-16 h-1 bg-gray-900 mb-8"></div>
        
        <h2 class="text-2xl font-semibold text-gray-900 mb-2">Criar sua conta</h2>
        <p class="text-gray-600">Preencha os dados abaixo para solicitar acesso ao sistema</p>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email, 
              autofocus: true, 
              autocomplete: "email",
              placeholder: "seu@email.com",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :password, "Senha", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-gray-500">(<%= @minimum_password_length %> caracteres no mínimo)</span>
          <% end %>
          <%= f.password_field :password, 
              autocomplete: "new-password",
              placeholder: "········",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirme a senha", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.password_field :password_confirmation, 
              autocomplete: "new-password",
              placeholder: "········",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
        </div>

        <div>
          <%= f.submit "Cadastrar", class: "w-full bg-black hover:bg-gray-800 text-white font-medium py-3 px-4 rounded-lg transition duration-200 cursor-pointer" %>
        </div>

        <div class="text-center text-sm text-gray-600">
          Já tem conta? 
          <%= link_to "Entre aqui", new_session_path(resource_name), class: "text-gray-900 font-medium hover:underline" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Lado Direito -->
  <div class="hidden lg:flex lg:w-1/2 bg-black items-center justify-center p-12">
    <div class="max-w-lg text-center">
      <div class="mb-8 flex justify-center">
        <%= image_tag "logo.png", alt: "Female Club Logo", class: "w-40 h-40 object-contain" %>
      </div>
      
      <h2 class="text-white text-3xl font-bold mb-6">Female Club</h2>
      
      <p class="text-gray-300 text-lg mb-12">
        Sistema completo de gestão para sua loja de artigos femininos.<br>
        Controle vendas, estoque, finanças e muito mais em um só lugar.
      </p>

      <div class="grid grid-cols-2 gap-6">
        <div class="bg-gray-900 p-6 rounded-lg">
          <h3 class="text-white font-semibold text-lg mb-2">Gestão Completa</h3>
          <p class="text-gray-400 text-sm">Todas as ferramentas que você precisa</p>
        </div>
        
        <div class="bg-gray-900 p-6 rounded-lg">
          <h3 class="text-white font-semibold text-lg mb-2">Relatórios</h3>
          <p class="text-gray-400 text-sm">Análises detalhadas do negócio</p>
        </div>
        
        <div class="bg-gray-900 p-6 rounded-lg">
          <h3 class="text-white font-semibold text-lg mb-2">Controle Financeiro</h3>
          <p class="text-gray-400 text-sm">Acompanhe receitas e despesas</p>
        </div>
        
        <div class="bg-gray-900 p-6 rounded-lg">
          <h3 class="text-white font-semibold text-lg mb-2">Estoque</h3>
          <p class="text-gray-400 text-sm">Nunca fique sem produtos</p>
        </div>
      </div>
    </div>
  </div>
</div>