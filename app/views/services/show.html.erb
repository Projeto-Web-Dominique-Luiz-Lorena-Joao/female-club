<div class="max-w-6xl mx-auto space-y-6">

  <!-- Header com Nome e Botões de Ação -->
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @service.name %></h1>
    </div>
    <div class="flex space-x-3">
      <%= link_to edit_service_path(@service), class: "bg-orange-200 hover:bg-orange-100 text-orange-700 px-8 py-2 rounded-lg font-medium" do %>
        Editar
      <% end %>
      <%= link_to services_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg font-medium" do %>
        ← Voltar
      <% end %>
    </div>
  </div>

  <!-- Cards de Métricas Principais -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Preço do Serviço</p>
      <p class="text-3xl font-bold text-green-600 mt-2">
        <%= @service.formatted_price %>
      </p>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Status</p>
      <div class="mt-2">
        <% case @service.active %>
        <% when 'ativo' %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
            ✓ Ativo
          </span>
        <% when 'inativo' %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
            ⚠ Inativo
          </span>
        <% when 'arquivado' %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
            ✕ Arquivado
          </span>
        <% else %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
            <%= @service.active %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Total de Utilizações</p>
      <p class="text-3xl font-bold text-blue-600 mt-2">
        <%#= @service.service_appointments.count %>
      </p>
    </div>
  </div>

  <!-- Informações Detalhadas do Serviço -->
  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-900">
      <h2 class="text-xl font-bold text-white">Informações do Serviço</h2>
    </div>
    <div class="p-6">

      <% if @service.description.present? %>
        <div>
          <p class="text-sm font-medium text-gray-500">Descrição</p>
          <p class="mt-3 text-lg text-gray-900 whitespace-pre-wrap"><%= @service.description %></p>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-gray-400">Nenhuma descrição disponível</p>
        </div>
      <% end %>

    </div>
  </div>

  <!-- Agendamentos e Vendas -->
  <%# if @service_appointments.any? || @sale_services.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- Agendamentos de Serviço -->
      <%# if @service_appointments.any? %>
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
          <div class="px-6 py-4 bg-gray-900">
            <h2 class="text-xl font-bold text-white">Agendamentos (<%= @service_appointments.count %>)</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Cliente</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Funcionário</th>
                  <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Ação</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @service_appointments.limit(5).each do |appointment| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 text-sm text-gray-900">
                      <% if appointment.customer %>
                        <%= link_to appointment.customer.name, customer_path(appointment.customer), class: "text-blue-600 hover:text-blue-800" %>
                      <% else %>
                        <span class="text-gray-400">-</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-900">
                      <% if appointment.employee %>
                        <%= link_to appointment.employee.name, employee_path(appointment.employee), class: "text-blue-600 hover:text-blue-800" %>
                      <% else %>
                        <span class="text-gray-400">-</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <%= link_to "Ver", service_appointment_path(appointment), class: "text-blue-600 hover:text-blue-800 text-sm" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @service_appointments.count > 5 %>
            <div class="px-6 py-3 bg-gray-50 text-center text-sm text-gray-600">
              <p>+ <%= @service_appointments.count - 5 %> agendamentos</p>
            </div>
          <% end %>
        </div>
      <%# end %>

      <!-- Vendas de Serviço -->
      <%# if @sale_services.any? %>
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
          <div class="px-6 py-4 bg-gray-900">
            <h2 class="text-xl font-bold text-white">Vendas (<%= @sale_services.count %>)</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Venda</th>
                  <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Valor</th>
                  <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Ação</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @sale_services.limit(5).each do |sale_service| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 text-sm text-gray-900">
                      <% if sale_service.sale %>
                        <%= link_to "Venda ##{sale_service.sale.id}", sale_path(sale_service.sale), class: "text-blue-600 hover:text-blue-800" %>
                      <% else %>
                        <span class="text-gray-400">-</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 text-center text-sm text-gray-900">
                      <%= sale_service.quantity %>x R$ <%= number_with_precision(sale_service.unit_price, precision: 2, delimiter: ",", separator: ".") %>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <% if sale_service.sale %>
                        <%= link_to "Ver", sale_path(sale_service.sale), class: "text-blue-600 hover:text-blue-800 text-sm" %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @sale_services.count > 5 %>
            <div class="px-6 py-3 bg-gray-50 text-center text-sm text-gray-600">
              <p>+ <%= @sale_services.count - 5 %> vendas</p>
            </div>
          <% end %>
        </div>
      <%# end %>

    </div>
  <%# end %>

  <!-- Data de Criação/Atualização -->
  <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
    <p>Criado em: <%= l(@service.created_at, format: :short) %></p>
    <p>Última atualização: <%= l(@service.updated_at, format: :short) %></p>
  </div>

</div>
