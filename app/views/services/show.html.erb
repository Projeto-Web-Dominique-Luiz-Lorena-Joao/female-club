<div class="max-w-6xl mx-auto space-y-6">

  <!-- Header com Nome e Botões de Ação -->
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @service.name %></h1>
    </div>
    <div class="flex space-x-3">
      <%= link_to edit_service_path(@service), class: "bg-black hover:bg-gray-700 text-white px-8 py-2 rounded-lg font-medium" do %>
        Editar
      <% end %>
      <%= link_to "javascript:history.back()", class: "bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2 transition shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="3" fill="none"
           class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
        </svg>
        Voltar
      <% end %>
    </div>
  </div>

  <!-- Cards de Métricas Principais -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Card Preço -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none"
              viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>

        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Preço do Serviço</p>
          <p class="text-2xl font-bold text-green-600 mt-1">
            <%= @service.formatted_price %>
          </p>
        </div>
      </div>
    </div>

    <!-- Card Status -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-gray-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none"
              viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 9v4l3 3m6-4a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
          </svg>
        </div>

        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Status</p>
          <div class="mt-1">
            <% case @service.active %>
            <% when 'ativo' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                Ativo
              </span>
            <% when 'inativo' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                Inativo
              </span>
            <% when 'arquivado' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                Arquivado
              </span>
            <% else %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                <%= @service.active %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Card Total de Utilizações -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-purple-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-600" fill="none"
              viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M4.5 9.75l7.5-6 7.5 6m-15 4.5l7.5 6 7.5-6M4.5 9.75v4.5m15-4.5v4.5M12 3.75v16.5" />
          </svg>
        </div>

        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Total de Utilizações</p>
          <p class="text-2xl font-bold text-purple-600 mt-1">
            <%#= @service.service_appointments.count %>
            0
          </p>
        </div>
      </div>
    </div>

  </div>


  <!-- Informações Detalhadas do Serviço -->
  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-900">
      <h2 class="text-xl font-bold text-white">Informações do Serviço</h2>
    </div>
    <div class="p-6">

      <% if @service.description.present? %>
        <div>
          <p class="text-sm font-medium text-gray-500">Descrição</p>
          <p class="mt-3 text-lg text-gray-900 whitespace-pre-wrap"><%= @service.description %></p>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-gray-400">Nenhuma descrição disponível</p>
        </div>
      <% end %>

    </div>
  </div>
  <!-- Agendamentos e Vendas -->
  <%# if @service_appointments.any? || @sale_services.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- Agendamentos de Serviço -->
      <%# if @service_appointments.any? %>
      <%# end %>
    </div>
  <%# end %>
  <!-- Data de Criação/Atualização -->
  <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600 space-y-1 border border-gray-200">
    <p>Criado em: <%= l(@service.created_at, format: :short) %></p>
    <p>Última atualização: <%= l(@service.updated_at, format: :short) %></p>
  </div>

</div>
