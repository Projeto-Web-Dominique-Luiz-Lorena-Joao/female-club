<div class="space-y-6">

  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Serviços</h1>
      <p class="mt-2 text-gray-600">Gerenciar catálogo de serviços</p>
    </div>
    <%= link_to new_service_path,
      class: "bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition duration-200 inline-flex items-center" do %>
      Novo Serviço
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Card Total de Serviços -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-gray-100 rounded-lg p-3">
          <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Total de Serviços</p>
          <p class="text-2xl font-bold text-gray-900 mt-1"><%= Service.count %></p>
        </div>
      </div>
    </div>

    <!-- Card Serviços Ativos -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
          <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Serviços Ativos</p>
          <p class="text-2xl font-bold text-green-600 mt-1"><%= Service.ativo.count %></p>
        </div>
      </div>
    </div>

    <!-- Card Serviços Inativos -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-red-100 rounded-lg p-3">
          <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Serviços Inativos</p>
          <p class="text-2xl font-bold text-red-600 mt-1"><%= Service.inativo.count %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: services_path, method: :get, class: "space-y-4", local: true do %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <div>
          <%= text_field_tag :search, params[:search],
            placeholder: "Buscar por nome...",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
        </div>

        <div>
          <%= select_tag :status,
            options_for_select([["Todos os Status", ""], ["Ativo", "ativo"], ["Inativo", "inativo"], ["Arquivado", "arquivado"]], params[:status]),
            { class: "w-full px-4 py-2 border border-gray-300 rounded-lg" } %>
        </div>

        <div class="flex justify-end space-x-2 items-center">
          <%= submit_tag "Buscar",
              class: "bg-black hover:bg-gray-700 text-white px-6 py-2 rounded-lg font-medium transition duration-200" %>

          <%= link_to "Limpar", services_path,
              class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition duration-200" %>
        </div>

      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @services.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-black">
          <tr>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Nome</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Preço</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Status</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase w-40">Ações</th>
          </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-200">
          <% @services.each do |service| %>
            <tr class="hover:bg-gray-50">

              <td class="px-6 py-4 text-center">
                <p class="text-sm font-medium text-gray-900">
                  <%= link_to service.name, service_path(service), class: "text-sm text-center font-medium text-gray-900" %>
                </p>
              </td>

              <td class="px-6 py-4 text-center text-sm text-green-600">
                <p class="font-medium"><%= service.formatted_price %></p>
              </td>

              <td class="px-6 py-4 text-center">
                <% case service.active %>
                <% when 'ativo' %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Ativo
                  </span>
                <% when 'inativo' %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    Inativo
                  </span>
                <% when 'arquivado' %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    Arquivado
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    <%= service.active %>
                  </span>
                <% end %>
              </td>

              <td class="px-6 py-4 text-center w-40">
                <div class="flex flex-col items-center space-y-2 w-full">

                  <%= link_to "Visualizar", service_path(service),
                      class: "bg-blue-200 text-blue-700 px-5 py-2 rounded-lg hover:bg-blue-100 text-center text-sm font-medium" %>

                </div>
              </td>

            </tr>
          <% end %>
        </tbody>

      </table>

    <% else %>

      <div class="text-center py-12">
        <p class="mt-4 text-xl text-gray-600">Nenhum serviço encontrado</p>
        <%= link_to "Cadastrar primeiro serviço", new_service_path,
            class: "mt-4 inline-block bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium transition duration-200" %>
      </div>

    <% end %>
  </div>
</div>