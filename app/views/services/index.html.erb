<div class="space-y-6">

  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Serviços</h1>
      <p class="mt-2 text-gray-600">Gerenciar catálogo de serviços</p>
    </div>
    <%= link_to new_service_path,
      class: "bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition inline-flex items-center" do %>
      + Novo Serviço
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Total de Serviços</p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= Service.count %></p>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Serviços Ativos</p>
      <p class="text-3xl font-bold text-green-600 mt-2"><%= Service.ativo.count %></p>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Serviços Inativos</p>
      <p class="text-3xl font-bold text-red-600 mt-2"><%= Service.inativo.count %></p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: services_path, method: :get, class: "space-y-4", local: true do %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <div>
          <%= text_field_tag :search, params[:search],
            placeholder: "Buscar por nome...",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
        </div>

        <div>
          <%= select_tag :status,
            options_for_select([["Todos os Status", ""], ["Ativo", "ativo"], ["Inativo", "inativo"], ["Arquivado", "arquivado"]], params[:status]),
            { class: "w-full px-4 py-2 border border-gray-300 rounded-lg" } %>
        </div>

        <div class="flex justify-end space-x-2 items-center">
          <%= submit_tag "Buscar",
              class: "bg-blue-700 hover:bg-blue-500 text-white px-6 py-2 rounded-lg font-medium transition" %>

          <%= link_to "Limpar", services_path,
              class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition" %>
        </div>

      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @services.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nome</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Preço</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Descrição</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase w-40">Ações</th>
          </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-200">
          <% @services.each do |service| %>
            <tr class="hover:bg-gray-50">

              <td class="px-6 py-4">
                <p class="text-sm font-medium text-gray-900">
                  <%= link_to service.name, service_path(service), class: "text-blue-600 hover:text-blue-800" %>
                </p>
              </td>

              <td class="px-6 py-4 text-center text-sm text-gray-900">
                <p class="font-medium"><%= service.formatted_price %></p>
              </td>

              <td class="px-6 py-4 text-center text-sm text-gray-600">
                <% if service.description.present? %>
                  <span class="line-clamp-2"><%= service.description %></span>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>

              <td class="px-6 py-4 text-center">
                <% case service.active %>
                <% when 'ativo' %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Ativo
                  </span>
                <% when 'inativo' %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    Inativo
                  </span>
                <% when 'arquivado' %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    Arquivado
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    <%= service.active %>
                  </span>
                <% end %>
              </td>

              <td class="px-6 py-4 text-center w-40">
                <div class="flex flex-col items-center space-y-2 w-full">

                  <%= link_to "Visualizar", service_path(service),
                      class: "bg-blue-200 text-blue-700 px-3 py-1 rounded-lg hover:bg-blue-100 w-full text-center text-sm font-medium" %>

                  <%= link_to "Editar", edit_service_path(service),
                      class: "bg-orange-200 text-orange-700 px-3 py-1 rounded-lg hover:bg-orange-100 w-full text-center text-sm font-medium" %>

                  <button
                    onclick="openDeleteModal('/services', <%= service.id %>, '<%= j service.name %>', 'serviço')"
                    class="bg-red-200 text-red-700 px-3 py-1 rounded-lg hover:bg-red-100 w-full text-center text-sm font-medium">
                    Deletar
                  </button>

                </div>
              </td>

            </tr>
          <% end %>
        </tbody>

      </table>

    <% else %>

      <div class="text-center py-12">
        <p class="mt-4 text-xl text-gray-600">Nenhum serviço encontrado</p>
        <%= link_to "Cadastrar primeiro serviço", new_service_path,
            class: "mt-4 inline-block bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-lg font-medium" %>
      </div>

    <% end %>
  </div>
</div>
