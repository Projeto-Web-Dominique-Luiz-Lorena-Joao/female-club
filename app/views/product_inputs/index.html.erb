<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Entradas de Produtos</h1>
    <%= link_to "Registrar Entrada", new_product_input_path, class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <!-- Filtros -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label for="product_id" class="block text-sm font-medium text-gray-700">Produto</label>
        <select name="product_id" id="product_id" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500">
          <option value="">Todos os produtos</option>
          <% Product.active.order(:name).each do |product| %>
            <option value="<%= product.id %>" <%= "selected" if params[:product_id] == product.id.to_s %>>
              <%= product.name %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label for="supplier_id" class="block text-sm font-medium text-gray-700">Fornecedor</label>
        <select name="supplier_id" id="supplier_id" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500">
          <option value="">Todos os fornecedores</option>
          <% Supplier.where(status: "ativo").order(:legal_name).each do |supplier| %>
            <option value="<%= supplier.id %>" <%= "selected" if params[:supplier_id] == supplier.id.to_s %>>
              <%= supplier.legal_name %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label for="start_date" class="block text-sm font-medium text-gray-700">Data Início</label>
        <input type="date" name="start_date" id="start_date" value="<%= params[:start_date] %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500">
      </div>

      <div>
        <label for="end_date" class="block text-sm font-medium text-gray-700">Data Fim</label>
        <input type="date" name="end_date" id="end_date" value="<%= params[:end_date] %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500">
      </div>

      <div class="flex items-end">
        <button type="submit" class="w-full bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
          Filtrar
        </button>
      </div>
    </form>
  </div>

  <!-- Tabela -->
  <% if @product_inputs.any? %>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Produto</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Fornecedor</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Quantidade</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Custo Unitário</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Custo Total</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Data</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @product_inputs.each do |input| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= link_to input.product.name, product_path(input.product), class: "text-blue-600 hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                <% if input.supplier %>
                  <%= link_to input.supplier.legal_name, supplier_path(input.supplier), class: "text-blue-600 hover:text-blue-900" %>
                <% else %>
                  <span class="text-gray-500">-</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 text-center">
                <%= input.quantity %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                <% if input.unit_cost %>
                  <%= number_to_currency(input.unit_cost) %>
                <% else %>
                  <span class="text-gray-500">-</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 font-medium">
                <% if input.unit_cost %>
                  <%= number_to_currency(input.total_cost) %>
                <% else %>
                  <span class="text-gray-500">-</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                <%= l(input.date_input, format: :short) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                <%= link_to "Ver", product_input_path(input), class: "text-blue-600 hover:text-blue-900" %>
                <%= link_to "Editar", edit_product_input_path(input), class: "text-gray-600 hover:text-gray-900" %>
                <%= link_to "Deletar", product_input_path(input), method: :delete, data: { confirm: "Tem certeza?" }, class: "text-red-600 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Paginação -->
    <div class="mt-6">
      <%= paginate @product_inputs %>
    </div>
  <% else %>
    <div class="bg-white shadow rounded-lg p-6 text-center text-gray-500">
      <p>Nenhuma entrada de produto registrada.</p>
    </div>
  <% end %>
</div>
