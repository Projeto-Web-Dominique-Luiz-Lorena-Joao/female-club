<div class="max-w-4xl mx-auto space-y-6">
  <!-- Cabeçalho com Título e Ações -->
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Entrada de Estoque</h1>
      <p class="mt-2 text-gray-600">
        Realizada em <%= l(@product_input.date_input, format: :long) %>
      </p>
    </div>

    <div class="flex space-x-3">
      <!-- Botão Editar -->
      <%= link_to edit_product_input_path(@product_input), class: "bg-black hover:bg-gray-700 text-white px-6 py-2 rounded-lg font-medium flex items-center gap-2" do %>
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
        </svg>
        Editar
      <% end %>

      <!-- Botão Excluir -->
      <%= button_to product_input_path(@product_input),
          method: :delete,
          form: { data: { controller: "submit-once" } },
          data: { confirm: "Tem certeza que deseja cancelar/excluir esta entrada de estoque?" },
          class: "bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-medium flex items-center gap-2 h-full" do %>
          Excluir
      <% end %>

      <!-- Botão Voltar -->
      <%= link_to "javascript:history.back()", class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            stroke="currentColor" stroke-width="2" fill="none"
            class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
        </svg>
        Voltar
      <% end %>
    </div>
  </div>

  <!-- Card Único Principal de Informações -->
  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="bg-black text-white px-6 py-4 flex items-center gap-3">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
      </svg>
      <h2 class="text-xl font-bold">Detalhes da Entrada</h2>
    </div>

    <div class="p-6">
      <!-- Bloco Produto e Fornecedor -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
           <p class="text-sm font-medium text-gray-500 mb-1 flex items-center gap-1">
             <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
               <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
             </svg>
             Produto
           </p>
           <p class="text-lg font-semibold text-gray-900">
             <%= link_to @product_input.product.name, product_path(@product_input.product), class: "hover:text-blue-600 hover:underline" %>
           </p>
        </div>

        <div>
           <p class="text-sm font-medium text-gray-500 mb-1 flex items-center gap-1">
             <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
               <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125V14.25m-17.25 4.5l1.125-6.75a2.25 2.25 0 012.238-1.928h13.296a2.25 2.25 0 012.238 1.928l1.125 6.75M12 2.25a3.375 3.375 0 00-3.375 3.375h6.75A3.375 3.375 0 0012 2.25z" />
             </svg>
             Fornecedor
           </p>
           <p class="text-lg font-semibold text-gray-900">
             <% if @product_input.supplier %>
               <%= link_to @product_input.supplier.legal_name, supplier_path(@product_input.supplier), class: "hover:text-blue-600 hover:underline" %>
             <% else %>
               <span class="text-gray-500 italic">Não informado</span>
             <% end %>
           </p>
        </div>
      </div>

      <hr class="my-6 border-gray-200">

      <!-- Bloco Detalhes Numéricos -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-6">
        <div>
          <p class="text-sm font-medium text-gray-500">Nota Fiscal</p>
          <p class="mt-1 font-semibold text-gray-900">
            <%= @product_input.invoice_number.present? ? @product_input.invoice_number : "-" %>
          </p>
        </div>

        <div>
          <p class="text-sm font-medium text-gray-500">Quantidade</p>
          <p class="mt-1 font-semibold text-gray-900"><%= @product_input.quantity %></p>
        </div>

        <div>
          <p class="text-sm font-medium text-gray-500">Custo Unitário</p>
          <p class="mt-1 font-semibold text-gray-900">
            <% if @product_input.unit_cost %>
              <%= number_to_currency(@product_input.unit_cost) %>
            <% else %>
              <span class="text-gray-400">-</span>
            <% end %>
          </p>
        </div>

        <div>
          <p class="text-sm font-medium text-gray-500">Registrado por</p>
          <span class="inline-block mt-1 px-3 py-1 rounded-full bg-gray-100 text-gray-800 text-sm font-medium">
            <%= @product_input.created_by&.email || "Sistema" %>
          </span>
        </div>
      </div>

      <!-- Bloco Custo Total -->
      <div class="bg-gray-50 rounded-lg p-4 flex justify-between items-center">
        <span class="font-semibold text-lg text-gray-700">Custo Total</span>
        <span class="font-bold text-2xl text-green-700">
          <% if @product_input.total_cost %>
            <%= number_to_currency(@product_input.total_cost) %>
          <% else %>
            -
          <% end %>
        </span>
      </div>

      <!-- Bloco Anotações (Se existir) -->
      <% if @product_input.notes.present? %>
        <hr class="my-6 border-gray-200">
        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-2 flex items-center gap-1">
             <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
               <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
             </svg>
             Observações
          </h3>
          <div class="bg-gray-50 rounded-lg p-4">
             <p class="text-gray-700 whitespace-pre-wrap"><%= @product_input.notes %></p>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>