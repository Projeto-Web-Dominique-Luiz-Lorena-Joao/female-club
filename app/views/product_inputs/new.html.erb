<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Registrar Entrada de Produto</h1>

    <div class="bg-white shadow rounded-lg p-6">
      <%= form_with(model: @product_input, local: true, data: { turbo: false }) do |form| %>
        <% if @product_input.errors.any? %>
          <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded">
            <h2 class="text-lg font-semibold text-red-900 mb-2">
              <%= pluralize(@product_input.errors.count, "erro") %> encontrado:
            </h2>
            <ul class="text-red-800">
              <% @product_input.errors.full_messages.each do |message| %>
                <li class="mb-1">• <%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Seção de Seleção de Produto -->
        <div class="mb-6" data-controller="dynamic-search" data-dynamic-search-search-url="<%= search_products_product_inputs_path %>" data-dynamic-search-item-type="product">
          <label for="product_input_product_id" class="block text-sm font-medium text-gray-700 mb-2">
            Produto <span class="text-red-600">*</span>
          </label>
          <div style="position: relative;">
            <input type="text" id="product_input_product_id" name="product_input[product_name]" placeholder="Digite para buscar..." class="block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500" required data-dynamic-search-target="input" autocomplete="off" />
            <div class="hidden absolute top-full left-0 right-0 mt-1 border border-gray-300 rounded-md shadow-lg bg-white z-10 max-h-64 overflow-y-auto" data-dynamic-search-target="results"></div>
          </div>
          <input type="hidden" id="product_input_product_id_hidden" name="product_input[product_id]" />
        </div>

        <!-- Seção de Seleção de Fornecedor -->
        <div class="mb-6" data-controller="dynamic-search" data-dynamic-search-search-url="<%= search_suppliers_product_inputs_path %>" data-dynamic-search-item-type="supplier">
          <label for="product_input_supplier_id" class="block text-sm font-medium text-gray-700 mb-2">
            Fornecedor
          </label>
          <div style="position: relative;">
            <input type="text" id="product_input_supplier_id" name="product_input[supplier_name]" placeholder="Digite para buscar (opcional)..." class="block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500" data-dynamic-search-target="input" autocomplete="off" />
            <div class="hidden absolute top-full left-0 right-0 mt-1 border border-gray-300 rounded-md shadow-lg bg-white z-10 max-h-64 overflow-y-auto" data-dynamic-search-target="results"></div>
          </div>
          <input type="hidden" id="product_input_supplier_id_hidden" name="product_input[supplier_id]" />
        </div>

        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label for="product_input_quantity" class="block text-sm font-medium text-gray-700 mb-2">
              Quantidade <span class="text-red-600">*</span>
            </label>
            <%= form.number_field :quantity, min: 1, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500", placeholder: "0", required: true %>
          </div>

          <div>
            <label for="product_input_unit_cost" class="block text-sm font-medium text-gray-700 mb-2">
              Custo Unitário
            </label>
            <%= form.text_field :unit_cost, inputmode: "decimal", class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500", placeholder: "0,00", data: { controller: "currency-mask" } %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label for="product_input_date_input" class="block text-sm font-medium text-gray-700 mb-2">
              Data da Entrada <span class="text-red-600">*</span>
            </label>
            <%= form.date_field :date_input, value: Date.today, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500", required: true %>
          </div>

          <div>
            <label for="product_input_date_input_time" class="block text-sm font-medium text-gray-700 mb-2">
              Horário
            </label>
            <input type="time" id="product_input_date_input_time" name="product_input[date_input_time]" value="<%= Time.current.strftime('%H:%M') %>" class="block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500" />
          </div>
        </div>

        <div class="mb-6">
          <label for="product_input_invoice_number" class="block text-sm font-medium text-gray-700 mb-2">
            Número da Nota Fiscal
          </label>
          <%= form.text_field :invoice_number, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500", placeholder: "NF-123456" %>
        </div>

        <div class="mb-6">
          <label for="product_input_notes" class="block text-sm font-medium text-gray-700 mb-2">
            Observações
          </label>
          <%= form.text_area :notes, rows: 4, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500", placeholder: "Detalhes adicionais sobre a entrada..." %>
        </div>

        <div class="flex gap-4">
          <%= form.submit "Registrar Entrada", class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-6 rounded" %>
          <%= link_to "Cancelar", product_inputs_path, class: "bg-gray-400 hover:bg-gray-500 text-white font-bold py-2 px-6 rounded" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
