<div class="mb-6">
  <div class="mb-4 flex justify-between items-center">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Relatório Diário</h2>
      <p class="text-gray-600 text-sm mt-0.5">Estatísticas de <%= I18n.localize(@current_date, format: :long) %></p>
    </div>

    <!-- Seletor de data -->
    <%= form_with url: daily_reports_path, method: :get, id: "date_selector_form", class: "flex items-center gap-3" do |f| %>
      <div class="flex items-center gap-2">
        <label for="date_select" class="text-sm font-medium text-gray-700">Data:</label>
        <%= f.date_field :date,
            value: @current_date,
            id: "date_select",
            class: "px-2 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white text-gray-900 cursor-pointer",
            onchange: "this.form.submit()"
        %>
      </div>
    <% end %>
  </div>

  <!-- KPI Cards - 2 por linha -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
    <!-- Receitas do Dia -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-blue-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-blue-100">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Receitas do Dia</h3>
            <p class="text-2xl font-bold text-blue-600">
              R$ <%= number_to_currency(@total_revenue, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
            <p class="text-sm text-gray-500 mt-1"><%= @sales_count %> <%= @sales_count == 1 ? 'venda' : 'vendas' %></p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Soma total de todas as vendas realizadas no dia, incluindo pagas e pendentes.</div>
        </div>
      </div>
    </div>

    <!-- Recebido Hoje -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-green-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-green-100">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Recebido Hoje</h3>
            <p class="text-2xl font-bold text-green-600">
              R$ <%= number_to_currency(@received_today, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Vendas que já foram pagas hoje. Dinheiro efetivamente recebido no caixa.</div>
        </div>
      </div>
    </div>

    <!-- Despesas do Dia -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-orange-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-orange-100">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Despesas do Dia</h3>
            <p class="text-2xl font-bold text-orange-600">
              R$ <%= number_to_currency(@total_expenses, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Total de despesas registradas para este dia.</div>
        </div>
      </div>
    </div>

    <!-- Saldo do Dia -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 <%= @daily_balance >= 0 ? 'border-green-500' : 'border-red-500' %> relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full <%= @daily_balance >= 0 ? 'bg-green-100' : 'bg-red-100' %>">
            <svg class="w-6 h-6 <%= @daily_balance >= 0 ? 'text-green-600' : 'text-red-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Saldo do Dia</h3>
            <p class="text-2xl font-bold <%= @daily_balance >= 0 ? 'text-green-600' : 'text-red-600' %>">
              R$ <%= number_to_currency(@daily_balance, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Diferença entre o que foi recebido e o que foi gasto hoje (Recebido - Despesas).</div>
        </div>
      </div>
    </div>

    <!-- Lucro Líquido -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 <%= @net_profit >= 0 ? 'border-green-500' : 'border-red-500' %> relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full <%= @net_profit >= 0 ? 'bg-green-100' : 'bg-red-100' %>">
            <svg class="w-6 h-6 <%= @net_profit >= 0 ? 'text-green-600' : 'text-red-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Lucro Líquido</h3>
            <p class="text-2xl font-bold <%= @net_profit >= 0 ? 'text-green-600' : 'text-red-600' %>">
              R$ <%= number_to_currency(@net_profit, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Lucro real do dia após descontar custos dos produtos e despesas.</div>
        </div>
      </div>
    </div>

    <!-- Ticket Médio -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-purple-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-purple-100">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Ticket Médio</h3>
            <p class="text-2xl font-bold text-purple-600">
              R$ <%= number_to_currency(@average_ticket, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Valor médio por venda (Total de receitas ÷ Número de vendas).</div>
        </div>
      </div>
    </div>

    <!-- Pendente Hoje -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-yellow-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-yellow-100">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Pendente Hoje</h3>
            <p class="text-2xl font-bold text-yellow-600">
              R$ <%= number_to_currency(@pending_today, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Vendas realizadas hoje que ainda não foram pagas.</div>
        </div>
      </div>
    </div>

    <!-- Vencem Hoje -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-red-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-red-100">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Vencem Hoje</h3>
            <p class="text-2xl font-bold text-red-600">
              R$ <%= number_to_currency(@due_today, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
            <p class="text-sm text-gray-500 mt-1"><%= @due_today_count %> <%= @due_today_count == 1 ? 'venda' : 'vendas' %></p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Vendas pendentes com vencimento para hoje. Requer atenção!</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Top Produtos e Serviços -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
    <!-- Top 5 Produtos -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Top 5 Produtos do Dia</h3>
      <% if @top_products.any? %>
        <div class="space-y-2">
          <% @top_products.each_with_index do |(name, data), index| %>
            <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-gray-500"><%= index + 1 %>.</span>
                <span class="text-sm font-medium text-gray-700"><%= name %></span>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-blue-600">R$ <%= number_to_currency(data[:revenue], unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
                <p class="text-xs text-gray-500"><%= data[:quantity] %> un.</p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 text-center py-4">Nenhum produto vendido hoje</p>
      <% end %>
    </div>

    <!-- Top 5 Serviços -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Top 5 Serviços do Dia</h3>
      <% if @top_services.any? %>
        <div class="space-y-2">
          <% @top_services.each_with_index do |(name, data), index| %>
            <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-gray-500"><%= index + 1 %>.</span>
                <span class="text-sm font-medium text-gray-700"><%= name %></span>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-purple-600">R$ <%= number_to_currency(data[:revenue], unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
                <p class="text-xs text-gray-500"><%= data[:quantity] %> serv.</p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 text-center py-4">Nenhum serviço vendido hoje</p>
      <% end %>
    </div>
  </div>

  <!-- Informação adicional -->
  <div class="bg-white rounded-lg shadow p-4">
    <h3 class="text-sm font-semibold text-gray-900 mb-2">Resumo do Dia</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div class="p-3 bg-gray-50 rounded-lg">
        <p class="text-xs text-gray-600 mb-1">Agendamentos</p>
        <p class="text-lg font-bold text-gray-900"><%= @appointments_today %></p>
      </div>
      <div class="p-3 bg-gray-50 rounded-lg">
        <p class="text-xs text-gray-600 mb-1">Total de Vendas</p>
        <p class="text-lg font-bold text-gray-900"><%= @sales_count %></p>
      </div>
      <div class="p-3 bg-blue-50 rounded-lg">
        <p class="text-xs text-blue-600 mb-1">Taxa de Recebimento</p>
        <p class="text-lg font-bold text-blue-900">
          <%= @total_revenue.positive? ? ((@received_today / @total_revenue) * 100).round(1) : 0 %>%
        </p>
      </div>
    </div>
  </div>
</div>
