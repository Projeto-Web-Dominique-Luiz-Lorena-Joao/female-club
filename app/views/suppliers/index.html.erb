<div class="space-y-6">
  <!-- Header -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Fornecedores</h1>
      <p class="mt-2 text-gray-600">Gerenciar fornecedores e parceiros</p>
    </div>
    <%= link_to new_supplier_path, class: "bg-gray-900 hover:bg-gray-400 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition inline-flex items-center" do %>
      Novo Fornecedor
    <% end %>
  </div>

  <!-- Estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Total de Fornecedores</p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= @total_suppliers %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Fornecedores Ativos</p>
      <p class="text-3xl font-bold text-green-600 mt-2"><%= @active_suppliers %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Itens Fornecidos</p>
      <p class="text-3xl font-bold text-blue-600 mt-2"><%= @total_items %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Valor em Estoque</p>
      <p class="text-2xl font-bold text-purple-600 mt-2">R$ <%= number_with_delimiter(@total_stock_value.to_f.round(2), delimiter: '.', separator: ',') %></p>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: suppliers_path, method: :get, class: "space-y-4" do %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="md:col-span-2">
          <%= text_field_tag :search, params[:search],
              placeholder: "Buscar por nome ou razão social...",
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg " %>
        </div>

        <div>
          <%= select_tag :category,
              options_for_select([
                ['Todas as Categorias', ''],
                ['Cosméticos', 'cosmeticos'],
                ['Maquiagem', 'maquiagem'],
                ['Perfumaria', 'perfumaria'],
                ['Cabelo', 'cabelo'],
                ['Unhas', 'unhas'],
                ['Pele', 'pele'],
                ['Acessórios', 'acessorios'],
                ['Equipamentos', 'equipamentos'],
                ['Diversos', 'diversos']
              ], params[:category]),
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg " %>
        </div>

        <div>
          <%= select_tag :status,
              options_for_select([
                ['Todos', ''],
                ['Ativos', 'active']
              ], params[:status]),
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg " %>
        </div>
      </div>

      <div class="flex space-x-2">
        <%= submit_tag "Buscar", class: "bg-blue-900 hover:bg-blue-400 text-white px-6 py-2 rounded-lg font-medium transition" %>
        <%= link_to "Limpar", suppliers_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-2 rounded-lg font-medium transition" %>
      </div>
    <% end %>
  </div>

  <!-- Lista -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @suppliers.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fornecedor</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Categoria</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Contato</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Itens</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Valor Estoque</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @suppliers.each do |supplier| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <p class="text-sm font-medium text-gray-900"><%= supplier.display_name %></p>
                <% if supplier.trade_name != supplier.legal_name %>
                  <p class="text-xs text-gray-500"><%= supplier.legal_name %></p>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <span class="px-3 py-1 text-xs font-medium rounded-full <%= supplier.category_badge_color %>">
                  <%= supplier.product_category&.titleize || 'Não definida' %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900">
                <p><%= supplier.formatted_phone %></p>
                <p class="text-xs text-gray-500"><%= supplier.email || '-' %></p>
              </td>
              <td class="px-6 py-4 text-center">
                <p class="text-lg font-bold text-gray-900"><%# supplier.total_items_supplied %></p>
                <p class="text-xs text-gray-500"><%# supplier.items_in_stock %> em estoque</p>
              </td>
              <td class="px-6 py-4 text-sm font-medium text-green-600">
                R$ <%# number_with_delimiter(supplier.total_stock_value.to_f.round(2), delimiter: '.', separator: ',') %>
              </td>
              <td class="px-6 py-4 text-right space-x-2">
                <div class="flex flex-col items-end space-y-2 w-full">
                <%= link_to "Visualizar", supplier_path(supplier), class: "bg-blue-200 text-blue-700 px-3 py-1 rounded-lg hover:bg-blue-100 w-full text-center text-sm font-medium" %>
                <%= link_to "Editar", edit_supplier_path(supplier), class: "bg-orange-200 text-orange-700 px-3 py-1 rounded-lg hover:bg-orange-100 w-full text-center text-sm font-medium" %>
                <%= button_to "Deletar", supplier_path(supplier),
                    method: :delete,
                    data: { confirm: "Tem certeza? Isso afetará os itens de estoque vinculados." },
                    form: { class: "w-full" },
                    class: "bg-red-200 text-red-700 px-3 py-1 rounded-lg hover:bg-red-100 w-full text-center text-sm font-medium" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-12">
        <span class="text-6xl">🏢</span>
        <p class="mt-4 text-xl text-gray-600">Nenhum fornecedor cadastrado</p>
        <%= link_to "Cadastrar primeiro fornecedor", new_supplier_path,
            class: "mt-4 inline-block bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-lg font-medium" %>
      </div>
    <% end %>
  </div>
</div>