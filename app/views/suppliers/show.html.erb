<div class="max-w-6xl mx-auto space-y-6">
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @supplier.display_name %></h1>
      <% if @supplier.trade_name != @supplier.legal_name %>
        <p class="mt-2 text-gray-600"><%= @supplier.legal_name %></p>
      <% end %>
      <span class="inline-block mt-2 px-4 py-2 text-sm font-medium rounded-full <%= @supplier.category_badge_color %>">
        <%= @supplier.product_category&.titleize || 'Categoria não definida' %>
      </span>
    </div>
    <div class="flex space-x-3">

      <%= link_to edit_supplier_path(@supplier), class: "bg-black hover:bg-gray-700 text-white px-8 py-2 rounded-lg font-medium" do %>
        Editar
      <% end %>

      <% if @supplier.active? %>
        <%= button_to "Inativar Fornecedor",
                      supplier_path(@supplier),
                      method: :delete,
                      data: { confirm: "Tem certeza que deseja inativar este fornecedor?" },
                      class: "bg-red-500 hover:bg-red-400 text-white px-4 py-2 rounded-lg font-medium" %>
      <% else %>
        <%= button_to "Reativar Fornecedor",
                      reactivate_supplier_path(@supplier),
                      method: :patch,
                      data: { confirm: "Deseja reativar este fornecedor?" },
                      class: "bg-green-500 hover:bg-green-400 text-white px-4 py-2 rounded-lg font-medium" %>
      <% end %>

      <%= link_to "javascript:history.back()", class: "bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2 transition shadow-sm" do %>

        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            stroke="currentColor" stroke-width="2" fill="none"
            class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
        </svg>

        Voltar
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-black">
      <h2 class="text-xl font-bold text-white">Informações do Fornecedor</h2>
    </div>
    <div class="p-6 grid grid-cols-2 gap-6">
      <div>
        <p class="text-sm font-medium text-gray-500">Telefone</p>
        <p class="mt-1 text-lg text-gray-900"><%= @supplier.formatted_phone %></p>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-500">E-mail</p>
        <p class="mt-1 text-lg text-gray-900"><%= @supplier.email || '-' %></p>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-500">Status</p>
        <p class="mt-1">
          <% if @supplier.active? %>
            <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
              Ativo
            </span>
          <% else %>
            <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
              Inativo
            </span>
          <% end %>
        </p>
      </div>

      <% if @supplier.full_address.present? %>
        <div class="col-span-2">
          <p class="text-sm font-medium text-gray-500">Endereço</p>
          <p class="mt-1 text-gray-900"><%= @supplier.full_address %></p>
        </div>
      <% end %>

      <% if @supplier.notes.present? %>
        <div class="col-span-2 pt-4 border-t border-gray-200">
          <p class="text-sm font-medium text-gray-500">Observações</p>
          <p class="mt-1 text-gray-900"><%= @supplier.notes %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>