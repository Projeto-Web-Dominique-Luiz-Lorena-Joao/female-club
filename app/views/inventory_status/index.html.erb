<div class="space-y-6">

  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Estado Atual do Estoque</h1>
      <p class="mt-2 text-gray-600">Visão geral do inventário de produtos</p>
    </div>
  </div>

  <!-- Cards de Estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <!-- Card Total de Produtos -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-gray-100 rounded-lg p-3">
          <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Total de Produtos</p>
          <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total_products %></p>
        </div>
      </div>
    </div>

    <!-- Card Em Estoque -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
          <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Em Estoque</p>
          <p class="text-2xl font-bold text-green-600 mt-1"><%= @in_stock %></p>
        </div>
      </div>
    </div>

    <!-- Card Estoque Baixo -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-orange-100 rounded-lg p-3">
          <svg class="h-6 w-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Estoque Baixo</p>
          <p class="text-2xl font-bold text-orange-600 mt-1"><%= @low_stock %></p>
        </div>
      </div>
    </div>

    <div class="bg-orange-50 border border-orange-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-orange-600 font-medium">Estoque Crítico</p>
          <p class="text-3xl font-bold text-orange-900"><%= @critical_stock %></p>
        </div>
        <svg class="w-12 h-12 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
    </div>

    <div class="bg-red-50 border border-red-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-red-600 font-medium">Fora de Estoque</p>
          <p class="text-3xl font-bold text-red-900"><%= @out_of_stock %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: inventory_status_path, method: :get, class: "space-y-4", local: true do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

        <div>
          <%= f.text_field :search,
                placeholder: "Buscar por nome ou código",
                value: params[:search],
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
        </div>

        <div>
          <%= f.select :stock_status,
                options_for_select(
                  [
                    ["Todos os Status", ""],
                    ["Em Estoque", "em_estoque"],
                    ["Estoque Baixo", "baixo"],
                    ["Fora de Estoque", "fora_de_estoque"]
                  ],
                  params[:stock_status]
                ),
                { class: "w-full px-4 py-2 border border-gray-300 rounded-lg" } %>
        </div>

        <div class="flex items-center space-x-2">
          <%= f.check_box :low_stock_only, { checked: params[:low_stock_only] == "true" }, "true", "false" %>
          <%= f.label :low_stock_only, "Mostrar apenas estoque baixo", class: "text-sm text-gray-700" %>
        </div>

        <div class="flex justify-end space-x-2 items-center">
          <%= f.submit "Filtrar",
                class: "bg-black hover:bg-gray-700 text-white px-6 py-2 rounded-lg font-medium transition duration-200" %>

          <%= link_to "Limpar", inventory_status_path,
                class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition duration-200" %>
        </div>

      </div>
    <% end %>
  </div>

  <!-- Tabela de Produtos -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @products.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-black">
          <tr>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Produto</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Quantidade</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Estoque Mínimo</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Status</th>
          </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-200">
          <% @products.each do |product| %>
            <tr class="hover:bg-gray-50">

              <td class="px-6 py-4 text-center">
                <p class="text-sm font-medium text-gray-900">
                  <%= link_to product.name, product_path(product), class: "text-gray-900 hover:text-blue-800" %>
                </p>
              </td>

              <td class="px-6 py-4 text-center">
                <div class="flex flex-col items-center">
                  <p class="text-sm font-medium text-gray-900"><%= [product.quantity, 0].max %></p>
                </div>
              </td>

              <td class="px-6 py-4 text-center">
                <span class="text-sm text-gray-900"><%= product.min_stock || "-" %></span>
              </td>

              <td class="px-6 py-4 text-center">
                <% case product.stock_status %>
                  <% when "em_estoque" %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Em Estoque
                    </span>
                  <% when "baixo" %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                      Estoque Baixo
                    </span>
                  <% when "critico" %>
                    <span class="inline-flex items-center gap-2 bg-orange-100 text-orange-800 px-3 py-1 rounded-full text-xs font-semibold">
                      Estoque Crítico
                    </span>
                  <% when "fora_de_estoque" %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      Fora de Estoque
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      -
                    </span>
                <% end %>
              </td>

            </tr>
          <% end %>
        </tbody>

      </table>

    <% else %>

      <div class="text-center py-12">
        <p class="mt-4 text-xl text-gray-600">Nenhum produto encontrado</p>
        <%= link_to "Cadastrar primeiro produto", new_product_path,
            class: "mt-4 inline-block bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium transition duration-200" %>
      </div>

    <% end %>
  </div>

  <!-- Paginação -->
  <% if @products.respond_to?(:total_pages) && @products.total_pages > 1 %>
    <div class="flex justify-center">
      <%= paginate @products, theme: 'bootstrap-5' %>
    </div>
  <% end %>
</div>