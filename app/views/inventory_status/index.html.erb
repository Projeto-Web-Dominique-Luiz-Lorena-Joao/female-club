<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Estado Atual do Estoque</h1>

  <!-- Cards de Estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-blue-600 font-medium">Total de Produtos</p>
          <p class="text-3xl font-bold text-blue-900"><%= @total_products %></p>
        </div>
        <svg class="w-12 h-12 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
      </div>
    </div>

    <div class="bg-green-50 border border-green-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-green-600 font-medium">Em Estoque</p>
          <p class="text-3xl font-bold text-green-900"><%= @in_stock %></p>
        </div>
        <svg class="w-12 h-12 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-yellow-600 font-medium">Estoque Baixo</p>
          <p class="text-3xl font-bold text-yellow-900"><%= @low_stock %></p>
        </div>
        <svg class="w-12 h-12 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>

    <div class="bg-orange-50 border border-orange-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-orange-600 font-medium">Estoque Crítico</p>
          <p class="text-3xl font-bold text-orange-900"><%= @critical_stock %></p>
        </div>
        <svg class="w-12 h-12 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
    </div>

    <div class="bg-red-50 border border-red-200 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-red-600 font-medium">Fora de Estoque</p>
          <p class="text-3xl font-bold text-red-900"><%= @out_of_stock %></p>
        </div>
        <svg class="w-12 h-12 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Filtros</h2>

    <%= form_with url: inventory_status_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-3 gap-4" do |f| %>
      <div>
        <%= f.text_field :search, placeholder: "Buscar por nome ou código", value: params[:search], class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.select :stock_status,
            options_for_select(
              [
                ["Todos os Status", ""],
                ["Em Estoque", "em_estoque"],
                ["Estoque Baixo", "baixo"],
                ["Estoque Crítico", "critico"],
                ["Fora de Estoque", "fora_de_estoque"]
              ],
              params[:stock_status]
            ),
            { class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" } %>
      </div>

      <div class="flex items-end gap-2">
        <%= f.submit "Filtrar", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg flex-1" %>
        <%= link_to "Limpar", inventory_status_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-900 font-bold py-2 px-6 rounded-lg text-center flex-1" %>
      </div>
    <% end %>
  </div>

  <!-- Tabela de Produtos -->
  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <table class="w-full border-collapse">
      <thead>
        <tr class="bg-gray-100 border-b-2 border-gray-300">
          <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Código</th>
          <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Produto</th>
          <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Quantidade</th>
          <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Estoque Mínimo</th>
          <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Status</th>
        </tr>
      </thead>
      <tbody>
        <% if @products.any? %>
          <% @products.each do |product| %>
            <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 text-sm text-gray-700">
                <span class="bg-gray-100 px-3 py-1 rounded-full font-mono text-xs"><%= product.code %></span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900">
                <%= link_to product.name, product_path(product), class: "text-blue-600 hover:text-blue-800 font-medium" %>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="text-lg font-bold text-gray-900"><%= product.quantity || 0 %></span>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="text-sm text-gray-600"><%= product.min_stock || "-" %></span>
              </td>
              <td class="px-6 py-4 text-center">
                <% case product.stock_status %>
                  <% when "em_estoque" %>
                    <span class="inline-flex items-center gap-2 bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs font-semibold">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      Em Estoque
                    </span>
                  <% when "baixo" %>
                    <span class="inline-flex items-center gap-2 bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-xs font-semibold">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                      </svg>
                      Estoque Baixo
                    </span>
                  <% when "critico" %>
                    <span class="inline-flex items-center gap-2 bg-orange-100 text-orange-800 px-3 py-1 rounded-full text-xs font-semibold">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                      </svg>
                      Estoque Crítico
                    </span>
                  <% when "fora_de_estoque" %>
                    <span class="inline-flex items-center gap-2 bg-red-100 text-red-800 px-3 py-1 rounded-full text-xs font-semibold">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                      </svg>
                      Fora de Estoque
                    </span>
                  <% else %>
                    <span class="inline-block bg-gray-100 text-gray-800 px-3 py-1 rounded-full text-xs font-semibold">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-gray-500">
              <p class="text-lg">Nenhum produto encontrado</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Paginação -->
  <% if @products.respond_to?(:total_pages) && @products.total_pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= paginate @products, theme: 'bootstrap-5' %>
    </div>
  <% end %>
</div>
