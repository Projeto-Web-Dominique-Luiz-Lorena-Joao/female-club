<div class="container mx-auto px-4 max-w-4xl">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">EXTRATO DE VENDA</h1>
      <p class="text-sm text-gray-500">Venda #<%= @sale.id %></p>
    </div>

    <div class="flex space-x-3">
      <% if @sale.pendente? %>
        <%= button_to "Marcar como paga", mark_as_paid_sale_path(@sale), method: :patch, class: "bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg font-medium flex items-center gap-2" %>
      <% end %>

      <%= link_to edit_sale_path(@sale), class: "bg-black hover:bg-gray-700 text-white px-8 py-2 rounded-lg font-medium" do %>
        Editar
      <% end %>
      <%= link_to sales_path, class: "bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2 transition shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="3" fill="none"
           class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
        </svg>
        Voltar
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="bg-black text-white px-6 py-6">
      <div class="flex items-center gap-3 mb-2">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <h2 class="text-xl font-bold">Detalhes da Venda</h2>
      </div>
    </div>

    <div class="p-6">
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div>
          <p class="text-sm text-gray-500 mb-1">Status:</p>
          <% if @sale.pago? %>
            <span class="inline-block px-3 py-1 rounded-full bg-green-100 text-green-800 font-semibold text-sm">Pago</span>
          <% elsif @sale.pendente? %>
            <span class="inline-block px-3 py-1 rounded-full bg-yellow-400 text-gray-900 font-semibold text-sm">Pendente</span>
          <% elsif @sale.cancelado? %>
            <span class="inline-block px-3 py-1 rounded-full bg-red-100 text-red-800 font-semibold text-sm">Cancelado</span>
          <% else %>
            <span class="inline-block px-3 py-1 rounded-full bg-gray-100 text-gray-800 font-semibold text-sm">Expirado</span>
          <% end %>
        </div>

        <div class="text-right">
          <p class="text-sm text-gray-500 mb-1">Data da Venda:</p>
          <p class="font-semibold"><%= @sale.sale_date.strftime("%d/%m/%Y") %></p>
        </div>
      </div>

      <% if @sale.overdue? %>
        <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3 mb-6 flex items-center gap-2">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-red-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
          <span class="text-red-700 font-medium">Vencida há <%= @sale.days_overdue %> dias</span>
        </div>
      <% end %>

      <div class="grid grid-cols-3 gap-4 mb-6 text-sm">
        <% if @sale.due_date.present? %>
          <div>
            <p class="text-gray-500 mb-1">Vencimento:</p>
            <p class="font-semibold"><%= @sale.due_date.strftime("%d/%m/%Y") %></p>
          </div>
        <% end %>

        <div>
          <p class="text-gray-500 mb-1">Forma de Pagamento:</p>
          <p class="font-semibold"><%= @sale.payment_method.humanize.upcase %></p>
        </div>

        <% if @sale.paid_date.present? %>
          <div>
            <p class="text-gray-500 mb-1">Data do Pagamento:</p>
            <p class="font-semibold text-green-600"><%= @sale.paid_date.strftime("%d/%m/%Y") %></p>
          </div>
        <% end %>
      </div>

      <hr class="my-6 border-gray-200">

      <div class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h2 class="font-semibold text-gray-900">Resumo de Valores</h2>
        </div>

        <div class="bg-gray-50 rounded-lg p-4 space-y-2">
          <div class="flex justify-between">
            <span class="text-gray-600">Subtotal:</span>
            <span class="font-semibold">R$ <%= number_to_currency(@sale.total_amount, unit: "", precision: 2, delimiter: ".", separator: ",") %></span>
          </div>

          <% if @sale.discount_percentage.present? && @sale.discount_percentage > 0 %>
            <div class="flex justify-between text-red-600">
              <span>Desconto (<%= @sale.discount_percentage %>%):</span>
              <span class="font-semibold">- R$ <%= number_to_currency(@sale.total_amount - @sale.total_with_discount, unit: "", precision: 2, delimiter: ".", separator: ",") %></span>
            </div>
            <hr class="border-gray-300">
            <div class="flex justify-between text-lg pt-1">
              <span class="font-semibold">Total a Pagar:</span>
              <span class="font-bold text-green-600">R$ <%= number_to_currency(@sale.total_with_discount, unit: "", precision: 2, delimiter: ".", separator: ",") %></span>
            </div>
          <% else %>
            <hr class="border-gray-300">
            <div class="flex justify-between text-lg pt-1">
              <span class="font-semibold">Total a Pagar:</span>
              <span class="font-bold text-green-600">R$ <%= number_to_currency(@sale.total_amount, unit: "", precision: 2, delimiter: ".", separator: ",") %></span>
            </div>
          <% end %>
        </div>
      </div>

      <hr class="my-6 border-gray-200">

      <div class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
          <h2 class="font-semibold text-gray-900">Cliente</h2>
        </div>

        <div class="bg-gray-50 rounded-lg p-4">
          <p class="font-medium text-gray-900 mb-2">
            <%= link_to @sale.customer_name, @sale.customer.present? ? customer_path(@sale.customer) : "#", class: "text-blue-600 hover:text-blue-800" %>
          </p>
          <% if @sale.customer.present? %>
            <div class="text-sm text-gray-600 space-y-1">
              <p><%= @sale.customer.formatted_phone %></p>
              <p><%= @sale.customer.email %></p>
            </div>
          <% end %>
        </div>
      </div>

      <hr class="my-6 border-gray-200">

      <div class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>

          <h2 class="font-semibold text-gray-900">Atendido por</h2>
        </div>

        <div class="bg-gray-50 rounded-lg p-4">
          <p class="font-medium text-gray-900 mb-2">
            <%= link_to @sale.employee_name, employee_path(@sale.employee), class: "text-blue-600 hover:text-blue-800" %>
          </p>
          <div class="text-sm text-gray-600 space-y-1">
            <p><%= @sale.employee.formatted_phone %></p>
            <p class="text-gray-500"><%= @sale.employee.position.humanize %></p>
          </div>
        </div>
      </div>

      <% if @sale.sale_products.any? %>
        <hr class="my-6 border-gray-200">
        <div class="mb-6">
          <div class="flex items-center gap-2 mb-3">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
            </svg>
            <h2 class="font-semibold text-gray-900">Produtos</h2>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-blue-100 text-gray-700">
                <tr>
                  <th class="text-left px-3 py-2 font-semibold">Item</th>
                  <th class="text-center px-3 py-2 font-semibold">Qtd</th>
                  <th class="text-right px-3 py-2 font-semibold">Preço Unit.</th>
                  <th class="text-right px-3 py-2 font-semibold">Total</th>
                </tr>
              </thead>
              <tbody class="bg-white">
                <% @sale.sale_products.each do |sale_product| %>
                  <tr class="border-b border-gray-200">
                    <td class="px-3 py-2"><%= sale_product.product.name %></td>
                    <td class="text-center px-3 py-2"><%= sale_product.quantity %></td>
                    <td class="text-right px-3 py-2">R$ <%= number_with_precision(sale_product.unit_price, precision: 2, delimiter: ',', separator: '.') %></td>
                    <td class="text-right px-3 py-2 font-semibold">R$ <%= number_with_precision(sale_product.total_price, precision: 2, delimiter: ',', separator: '.') %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

      <% if @sale.sale_services.any? %>
        <hr class="my-6 border-gray-200">
        <div class="mb-6">
          <div class="flex items-center gap-2 mb-3">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
            </svg>
            <h2 class="font-semibold text-gray-900">Serviços</h2>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-green-100 text-gray-700">
                <tr>
                  <th class="text-left px-3 py-2 font-semibold">Serviço</th>
                  <th class="text-center px-3 py-2 font-semibold">Qtd</th>
                  <th class="text-right px-3 py-2 font-semibold">Preço Unit.</th>
                  <th class="text-right px-3 py-2 font-semibold">Total</th>
                </tr>
              </thead>
              <tbody class="bg-white">
                <% @sale.sale_services.each do |sale_service| %>
                  <tr class="border-b border-gray-200">
                    <td class="px-3 py-2"><%= sale_service.service.name %></td>
                    <td class="text-center px-3 py-2"><%= sale_service.quantity %></td>
                    <td class="text-right px-3 py-2">R$ <%= number_with_precision(sale_service.unit_price, precision: 2, delimiter: ',', separator: '.') %></td>
                    <td class="text-right px-3 py-2 font-semibold">R$ <%= number_with_precision(sale_service.total_price, precision: 2, delimiter: ',', separator: '.') %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

      <% if @sale.notes.present? %>
        <hr class="my-6 border-gray-200">
        <div class="mb-4">
          <div class="flex items-center gap-2 mb-3">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            <h2 class="font-semibold text-gray-900">Observações</h2>
          </div>

          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-gray-700 text-sm whitespace-pre-wrap"><%= @sale.notes %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 text-center">
    <% if @sale.status != 'cancelado' %>
      <%= button_to "Cancelar Venda", sale_path(@sale), method: :patch, params: { sale: { status: 'cancelado' } }, class: "bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg font-medium", data: { confirm: "Tem certeza que deseja cancelar esta venda? O estoque será devolvido automaticamente." } %>
    <% else %>
      <p class="text-gray-600 font-medium">Venda cancelada em <%= @sale.updated_at.strftime('%d/%m/%Y às %H:%M') %></p>
    <% end %>
  </div>
</div>