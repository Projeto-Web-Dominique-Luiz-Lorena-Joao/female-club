<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Venda #<%= @sale.id %></h1>
    <div class="flex gap-2">

      <%= link_to "Editar", edit_sale_path(@sale), class: "bg-orange-400 hover:bg-orange-300 text-white px-8 py-2 rounded-lg font-medium" %>
       
      <%= button_to "Deletar Venda",
                    sale_path(@sale),
                    method: :delete,
                    data: { confirm: "Tem certeza que deseja excluir esta venda?" },
                    class: "bg-red-500 hover:bg-red-400 text-white px-4 py-2 rounded-lg font-medium" %>

      <%= link_to "← Voltar", sales_path, class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium" %>
      <% if @sale.pendente? %>
        <%= button_to "Marcar como Paga", mark_as_paid_sale_path(@sale), method: :patch, class: "bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg" %>
      <% end %>
    </div>
  </div>

  <!-- Status -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-semibold mb-2">Status</h2>
        <% if @sale.pago? %>
          <span class="px-4 py-2 rounded-full bg-green-100 text-green-800 font-semibold">Pago</span>
        <% elsif @sale.pendente? %>
          <span class="px-4 py-2 rounded-full bg-yellow-100 text-yellow-800 font-semibold">Pendente</span>
        <% elsif @sale.cancelado? %>
          <span class="px-4 py-2 rounded-full bg-red-100 text-red-800 font-semibold">Cancelado</span>
        <% else %>
          <span class="px-4 py-2 rounded-full bg-gray-100 text-gray-800 font-semibold">Expirado</span>
        <% end %>

        <% if @sale.overdue? %>
          <p class="text-red-600 mt-2">⚠️ Vencida há <%= @sale.days_overdue %> dias</p>
        <% end %>
      </div>

      <div class="text-right">
        <p class="text-sm text-gray-500">Valor Total</p>
        <% if @sale.discount_percentage.present? && @sale.discount_percentage > 0 %>
          <p class="text-lg text-gray-600 line-through">R$ <%= number_to_currency(@sale.total_amount, unit: "", precision: 2, delimiter: ".", separator: ",") %></p>
          <p class="text-3xl font-bold text-green-600 mt-1">R$ <%= number_to_currency(@sale.total_with_discount, unit: "", precision: 2, delimiter: ".", separator: ",") %></p>
          <p class="text-sm text-green-600 mt-1">
            -<%= @sale.discount_percentage %>% (R$ <%= number_to_currency(@sale.total_amount - @sale.total_with_discount, unit: "", precision: 2, delimiter: ".", separator: ",") %>)
          </p>
        <% else %>
          <p class="text-3xl font-bold text-gray-900">R$ <%= number_to_currency(@sale.total_amount, unit: "", precision: 2, delimiter: ".", separator: ",") %></p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Cliente -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold mb-4">Cliente</h2>
      <div class="space-y-3">
        <div>
          <p class="text-sm text-gray-500">Nome</p>
          <p class="text-lg font-medium"><%= @sale.customer_name %></p>
        </div>
        <% if @sale.customer.present? %>
          <div>
            <p class="text-sm text-gray-500">Telefone</p>
            <p class="text-lg"><%= @sale.customer.formatted_phone %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">Email</p>
            <p class="text-lg"><%= @sale.customer.email %></p>
          </div>
          <%= link_to "Ver perfil", customer_path(@sale.customer), class: "text-pink-500 hover:text-pink-600" %>
        <% end %>
      </div>
    </div>

    <!-- Funcionário -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold mb-4">Funcionário</h2>
      <div class="space-y-3">
        <div>
          <p class="text-sm text-gray-500">Nome</p>
          <p class="text-lg font-medium"><%= @sale.employee_name %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Telefone</p>
          <p class="text-lg"><%= @sale.employee.phone %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Cargo</p>
          <p class="text-lg"><%= @sale.employee.position.humanize %></p>
        </div>
        <%= link_to "Ver perfil", employee_path(@sale.employee), class: "text-pink-500 hover:text-pink-600" %>
      </div>
    </div>

    <!-- Detalhes -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold mb-4">Detalhes</h2>
      <div class="space-y-3">
        <div>
          <p class="text-sm text-gray-500">Data da Venda</p>
          <p class="text-lg font-medium"><%= @sale.sale_date.strftime("%d/%m/%Y") %></p>
        </div>
        <% if @sale.due_date.present? %>
          <div>
            <p class="text-sm text-gray-500">Vencimento</p>
            <p class="text-lg font-medium"><%= @sale.due_date.strftime("%d/%m/%Y") %></p>
          </div>
        <% end %>
        <% if @sale.paid_date.present? %>
          <div>
            <p class="text-sm text-gray-500">Data do Pagamento</p>
            <p class="text-lg font-medium text-green-600"><%= @sale.paid_date.strftime("%d/%m/%Y") %></p>
          </div>
        <% end %>
        <div>
          <p class="text-sm text-gray-500">Forma de Pagamento</p>
          <p class="text-lg font-medium"><%= @sale.payment_method.humanize %></p>
        </div>
      </div>
    </div>

    <!-- Valores -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold mb-4">Valores</h2>
      <div class="space-y-3">
        <div class="flex justify-between pb-3 border-b">
          <span class="text-gray-600">Valor Total:</span>
          <span class="text-xl font-semibold">R$ <%= number_to_currency(@sale.total_amount, unit: "", precision: 2, delimiter: ".", separator: ",") %></span>
        </div>
        <% if @sale.discount_percentage.present? && @sale.discount_percentage > 0 %>
          <div class="flex justify-between pb-3 border-b">
            <span class="text-gray-600">Desconto (<%= @sale.discount_percentage %>%):</span>
            <span class="text-lg text-green-600">- R$ <%= number_to_currency(@sale.total_amount - @sale.total_with_discount, unit: "", precision: 2, delimiter: ".", separator: ",") %></span>
          </div>
          <div class="flex justify-between pt-2">
            <span class="text-lg font-semibold">Valor Final:</span>
            <span class="text-2xl font-bold text-pink-600">R$ <%= number_to_currency(@sale.total_with_discount, unit: "", precision: 2, delimiter: ".", separator: ",") %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Observações -->
  <% if @sale.notes.present? %>
    <div class="bg-white rounded-lg shadow-md p-6 mt-6">
      <h2 class="text-xl font-semibold mb-4">Observações</h2>
      <p class="text-gray-700 whitespace-pre-wrap"><%= @sale.notes %></p>
    </div>
  <% end %>


  <!-- Ações -->
  <div class="flex gap-4 mt-6">
    <%= button_to "Excluir Venda", sale_path(@sale), method: :delete, class: "bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg", data: { confirm: "Tem certeza?" } %>
  </div>
</div>