<div class="container mx-auto px-4">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Vendas</h1>
    <%= link_to "Nova Venda", new_sale_path, class: "bg-pink-500 hover:bg-pink-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-200" %>
  </div>

  <!-- Resumo -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center">
        <div class="flex-1">
          <p class="text-gray-500 text-sm">Total de Vendas</p>
          <p class="text-2xl font-bold text-gray-800"><%= @sales.total_count %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center">
        <div class="flex-1">
          <p class="text-gray-500 text-sm">Vendas Pagas</p>
          <p class="text-2xl font-bold text-green-600"><%= Sale.by_status('pago').count %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center">
        <div class="flex-1">
          <p class="text-gray-500 text-sm">Vendas Pendentes</p>
          <p class="text-2xl font-bold text-yellow-600"><%= Sale.by_status('pendente').count %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center">
        <div class="flex-1">
          <p class="text-gray-500 text-sm">Vendas Vencidas</p>
          <p class="text-2xl font-bold text-red-600"><%= Sale.overdue.count %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <%= form_with url: sales_path, method: :get, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :status,
              options_for_select([
                ["Todos", ""],
                ["Pendente", "pendente"],
                ["Pago", "pago"],
                ["Cancelado", "cancelado"],
                ["Expirado", "expirado"]
              ], params[:status]),
              {},
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-500"
          %>
        </div>

        <div>
          <%= f.label :payment_method, "Forma de Pagamento", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :payment_method,
              options_for_select([
                ["Todos", ""],
                ["Dinheiro", "dinheiro"],
                ["Cartão de Crédito", "cartao_credito"],
                ["Cartão de Débito", "cartao_debito"],
                ["PIX", "pix"],
                ["Transferência", "transferencia"],
                ["Boleto", "boleto"]
              ], params[:payment_method]),
              {},
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-500"
          %>
        </div>

        <div data-controller="filter-autocomplete" data-filter-autocomplete-search-url-value="/sales/search_customers">
          <%= f.label :customer_id, "Cliente", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <div class="relative">
            <input type="text"
                   id="customer_filter_search"
                   placeholder="Digite o nome do cliente..."
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-500"
                   autocomplete="off"
                   data-filter-autocomplete-target="searchInput"
                   data-action="input->filter-autocomplete#search focus->filter-autocomplete#focus keydown->filter-autocomplete#handleKeydown">
            <%= f.hidden_field :customer_id, id: "filter_customer_id", data: { "filter-autocomplete-target": "hiddenInput" } %>
            <div id="customer_filter_results"
                 class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-auto"
                 data-filter-autocomplete-target="results"></div>
          </div>
        </div>

        <div data-controller="filter-autocomplete" data-filter-autocomplete-search-url-value="/sales/search_employees">
          <%= f.label :employee_id, "Funcionário", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <div class="relative">
            <input type="text"
                   id="employee_filter_search"
                   placeholder="Digite o nome do funcionário..."
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-500"
                   autocomplete="off"
                   data-filter-autocomplete-target="searchInput"
                   data-action="input->filter-autocomplete#search focus->filter-autocomplete#focus keydown->filter-autocomplete#handleKeydown">
            <%= f.hidden_field :employee_id, id: "filter_employee_id", data: { "filter-autocomplete-target": "hiddenInput" } %>
            <div id="employee_filter_results"
                 class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-auto"
                 data-filter-autocomplete-target="results"></div>
          </div>
        </div>

        <div>
          <%= f.label :start_date, "Data", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :start_date, value: params[:start_date], class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-500" %>
        </div>
      </div>

      <div class="flex gap-2">
        <%= f.submit "Filtrar", class: "bg-pink-500 hover:bg-pink-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-200 cursor-pointer" %>
        <%= link_to "Limpar Filtros", sales_path, class: "bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-200" %>
      </div>
    <% end %>
  </div>

  <!-- Tabela -->
  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-900">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase">Data</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase">Funcionário</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase">Valor Total</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase">Desconto</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase">Pagamento</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @sales.each do |sale| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm text-gray-900">
                <%= sale.sale_date.strftime("%d/%m/%Y") %>
                <% if sale.overdue? %>
                  <span class="block text-xs text-red-600">Vencida há <%= sale.days_overdue %> dias</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900"><%= sale.customer_name %></td>
              <td class="px-6 py-4 text-sm text-gray-900"><%= sale.employee_name %></td>
              <td class="px-6 py-4 text-sm font-semibold text-gray-900">
                R$ <%= number_to_currency(sale.total_amount, unit: "", precision: 2, delimiter: ".", separator: ",") %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900">
                <% if sale.discount_percentage.present? && sale.discount_percentage > 0 %>
                  <div class="font-semibold text-green-600">
                    R$ <%= number_to_currency(
                            sale.total_amount - sale.total_with_discount,
                            unit: "",
                            precision: 2,
                            delimiter: ".",
                            separator: ","
                        ) %>
                  </div>
                  <div>
                    <span class="inline-block px-2 py-0.5 mt-1 rounded-full bg-green-100 text-green-800 text-xs font-semibold">
                      <%= sale.discount_percentage %>%
                    </span>
                  </div>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900"><%= sale.payment_method.humanize %></td>
              <td class="px-6 py-4">
                <% if sale.pago? %>
                  <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">Pago</span>
                <% elsif sale.pendente? %>
                  <span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-800">Pendente</span>
                <% elsif sale.cancelado? %>
                  <span class="px-2 py-1 text-xs rounded-full bg-red-100 text-red-800">Cancelado</span>
                <% else %>
                  <span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800">Expirado</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm">
                <div class="flex gap-2">
                  <%= link_to "Ver", sale_path(sale), class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to "Editar", edit_sale_path(sale), class: "text-yellow-600 hover:text-yellow-900" %>
                  <% if sale.pendente? %>
                    <%= button_to "Pagar", mark_as_paid_sale_path(sale), method: :patch, class: "text-green-600 hover:text-green-900" %>
                  <% end %>
                  <%= button_to "Excluir", sale_path(sale), method: :delete, class: "text-red-600 hover:text-red-900", data: { confirm: "Tem certeza?" } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-4 py-3 border-t">
      <%= paginate @sales %>
    </div>
  </div>
</div>