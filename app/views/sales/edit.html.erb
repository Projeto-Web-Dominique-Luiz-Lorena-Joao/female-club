<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Editar Venda #<%= @sale.id %></h1>
    <div class="flex gap-2">
      <%= link_to "Voltar", sale_path(@sale), class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg" %>
      <%= link_to "Ver Detalhes", sale_path(@sale), class: "bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg" %>
    </div>
  </div>

  <%= render "form", sale: @sale %>
</div>