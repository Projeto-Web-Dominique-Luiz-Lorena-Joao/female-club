<%# app/views/sales/_form.html.erb %>
<%= form_with(model: sale, local: true, id: "sale_form") do |form| %>
  <% if sale.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded mb-4">
      <h4 class="font-bold"><%= pluralize(sale.errors.count, "erro") %> impediram que esta venda fosse salva:</h4>
      <ul class="list-disc list-inside mt-2">
        <% sale.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Campo de Funcionário com Autocomplete -->
    <div data-controller="sales-autocomplete"
         data-sales-autocomplete-search-url-value="/sales/search_employees"
         data-sales-autocomplete-allow-create-value="false"
         id="employee_autocomplete">
      <%= form.label :employee_id, "Funcionário *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="relative">
        <%= form.hidden_field :employee_id, id: "sale_employee_id", data: { "sales-autocomplete-target": "hiddenInput" } %>
        <input type="text"
               id="employee_search"
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
               placeholder="Digite o nome do funcionário..."
               autocomplete="off"
               value="<%= sale.employee&.full_name %>"
               data-sales-autocomplete-target="searchInput"
               data-action="input->sales-autocomplete#search focus->sales-autocomplete#focus click->sales-autocomplete#focus"
               required>
        <div id="employee_results"
             class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg max-h-60 overflow-auto"
             data-sales-autocomplete-target="results"></div>
      </div>
      <small class="text-gray-500 text-xs">Selecionado: <span id="selected_employee" class="font-medium" data-sales-autocomplete-target="selectedDisplay"><%= sale.employee&.full_name || 'Nenhum' %></span></small>
    </div>

    <!-- Campo de Cliente com Autocomplete -->
    <div data-controller="sales-autocomplete"
         data-sales-autocomplete-search-url-value="/sales/search_customers"
         data-sales-autocomplete-allow-create-value="true"
         id="customer_autocomplete">
      <%= form.label :customer_id, "Cliente", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="relative">
        <%= form.hidden_field :customer_id, id: "sale_customer_id", data: { "sales-autocomplete-target": "hiddenInput" } %>
        <input type="text"
               id="customer_search"
               name="customer_search"
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
               placeholder="Digite o nome do cliente ou deixe em branco..."
               autocomplete="off"
               value="<%= sale.customer&.full_name %>"
               data-sales-autocomplete-target="searchInput"
               data-action="input->sales-autocomplete#search focus->sales-autocomplete#focus click->sales-autocomplete#focus">
        <div id="customer_results"
             class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg max-h-60 overflow-auto"
             data-sales-autocomplete-target="results"></div>
      </div>
      <small class="text-gray-500 text-xs">Selecionado: <span id="selected_customer" class="font-medium" data-sales-autocomplete-target="selectedDisplay"><%= sale.customer&.full_name || 'Cliente Avulso' %></span></small>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
    <div>
      <%= form.label :sale_date, "Data da Venda *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.date_field :sale_date, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
    </div>

    <div>
      <%= form.label :due_date, "Data de Vencimento", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.date_field :due_date, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
    <div>
      <%= form.label :payment_method, "Forma de Pagamento *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :payment_method, @payment_methods, { prompt: "Selecione uma opção" }, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
    </div>

    <div>
      <%= form.label :status, "Status *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :status, @statuses, { prompt: "Selecione uma opção" }, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
    <div>
      <%= form.label :discount_percentage, "Desconto (%)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :discount_percentage, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", step: "0.01", min: "0", max: "100" %>
    </div>

    <div>
      <%= form.label :total_amount, "Valor Total *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :total_amount, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", step: "0.01", min: "0", required: true %>
    </div>
  </div>

  <div class="mt-4">
    <%= form.label :notes, "Observações", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :notes, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="flex gap-3 mt-6">
    <%= form.submit "Salvar Venda", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    <%= link_to "Cancelar", sales_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
  </div>
<% end %>