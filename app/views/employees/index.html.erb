<div class="space-y-6">
  <!-- Header -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">👥 Funcionários</h1>
      <p class="mt-2 text-gray-600">Gerenciar equipe</p>
    </div>
    <%= link_to new_employee_path, class: "bg-gray-900 hover:bg-gray-400 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition inline-flex items-center" do %>
      Novo Funcionário
    <% end %>
  </div>


  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Total de Funcionários</p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= @total_employees %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Funcionários Ativos</p>
      <p class="text-3xl font-bold text-green-600 mt-2"><%= @active_employees %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Folha Salarial</p>
      <p class="text-2xl font-bold text-blue-600 mt-2">R$ <%= number_with_delimiter(@total_salary.to_f.round(2), delimiter: '.', separator: ',') %></p>
    </div>
  </div>


  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: employees_path, method: :get, class: "space-y-4" do %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <%= text_field_tag :search, params[:search],
              placeholder: "Buscar por nome ou CPF...",
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500" %>
        </div>

        <div>
          <%= select_tag :status,
              options_for_select([
                ['Todos os Status', ''],
                ['Ativos', 'ativo'],
                ['Inativos', 'inativo'],
                ['Férias', 'ferias'],
                ['Afastados', 'afastado']
              ], params[:status]),
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500" %>
        </div>

        <div>
          <%= select_tag :position,
              options_for_select([
                ['Todos os Cargos', ''],
                ['Gerente', 'gerente'],
                ['Vendedor', 'vendedor'],
                ['Caixa', 'caixa'],
                ['Estoquista', 'estoquista'],
                ['Manicure', 'manicure'],
                ['Cabeleireira', 'cabeleireira'],
                ['Esteticista', 'esteticista'],
                ['Maquiador', 'maquiador'],
                ['Atendente', 'atendente'],
                ['Auxiliar', 'auxiliar']
              ], params[:position]),
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500" %>
        </div>

        <div class="flex space-x-2">
          <%= submit_tag "Buscar", class: "flex-1 bg-blue-900 hover:bg-blue-400 text-white px-6 py-2 rounded-lg font-medium transition" %>
          <%= link_to "Limpar", employees_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-2 rounded-lg font-medium transition" %>
        </div>
      </div>
    <% end %>
  </div>


  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @employees.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Funcionário</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">CPF</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Cargo</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Contato</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Salário</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @employees.each do |employee| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <p class="text-sm font-medium text-gray-900"><%= employee.full_name %></p>
                <% if employee.admission_date %>
                  <p class="text-xs text-gray-500"><%= employee.years_of_service %> anos de serviço</p>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900"><%= employee.formatted_cpf %></td>
              <td class="px-6 py-4">
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-purple-100 text-purple-800">
                  <%= employee.position&.titleize || '-' %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900">
                <p><%= employee.formatted_phone %></p>
                <p class="text-xs text-gray-500"><%= employee.email || '-' %></p>
              </td>
              <td class="px-6 py-4 text-sm font-medium text-gray-900">
                <%= employee.formatted_salary %>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="px-3 py-1 text-xs font-medium rounded-full <%= employee.status_color %>">
                  <%= employee.status&.titleize %>
                </span>
              </td>
              <td class="px-6 py-4 text-right space-x-2">
                <%= link_to "👁️", employee_path(employee), class: "text-blue-600 hover:text-blue-800" %>
                <%= link_to "✏️", edit_employee_path(employee), class: "text-yellow-600 hover:text-yellow-800" %>
                <%= button_to "🗑️", employee_path(employee),
                    method: :delete,
                    data: { confirm: "Tem certeza?" },
                    class: "text-red-600 hover:text-red-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-12">
        <span class="text-6xl">👥</span>
        <p class="mt-4 text-xl text-gray-600">Nenhum funcionário cadastrado</p>
        <%= link_to "Cadastrar primeiro funcionário", new_employee_path,
            class: "mt-4 inline-block bg-pink-600 hover:bg-pink-700 text-white px-6 py-3 rounded-lg font-medium" %>
      </div>
    <% end %>
  </div>
</div>