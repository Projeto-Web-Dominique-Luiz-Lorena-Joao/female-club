<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Funcionários</h1>
      <p class="mt-2 text-gray-600">Gerenciar equipe</p>
    </div>
    <%= link_to new_employee_path, class: "bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition duration-200 inline-flex items-center" do %>
      Novo Funcionário
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-gray-100 rounded-lg p-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
        </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Total de Funcionários</p>
          <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total_employees %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Funcionários Ativos</p>
          <p class="text-2xl font-bold text-green-600 mt-1"><%= @active_employees %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Folha Salarial</p>
          <p class="text-2xl font-bold text-green-600 mt-1">
            R$ <%= number_with_delimiter(@total_salary.to_f.round(2), delimiter: '.', separator: ',') %>
          </p>
        </div>
      </div>
    </div>
  </div>

<div class="bg-white rounded-lg shadow p-6">
  <%= form_with url: employees_path, method: :get, class: "space-y-4" do %>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4">

      <div class="md:col-span-6">
        <%= text_field_tag :search, params[:search],
            placeholder: "Buscar por nome, CPF, telefone ou e-mail ...",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
      </div>

      <div class="md:col-span-2">
        <%= select_tag :status,
            options_for_select([
              ['Todos os Status', ''],
              ['Ativos', 'ativo'],
              ['Inativos', 'inativo'],
              ['Férias', 'ferias'],
              ['Afastados', 'afastado']
            ], params[:status]),
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-black-900" %>
      </div>

      <div class="md:col-span-2">
        <%= select_tag :position,
            options_for_select([
              ['Todos os Cargos', ''],
              ['Gerente', 'gerente'],
              ['Vendedor', 'vendedor'],
              ['Caixa', 'caixa'],
              ['Estoquista', 'estoquista'],
              ['Manicure', 'manicure'],
              ['Cabeleireira', 'cabeleireira'],
              ['Esteticista', 'esteticista'],
              ['Maquiador', 'maquiador'],
              ['Atendente', 'atendente'],
              ['Auxiliar', 'auxiliar']
            ], params[:position]),
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-black-900" %>
      </div>

      <div class="md:col-span-2">
        <%= select_tag :sort_admission,
            options_for_select([
              ['Ordenar por', ''],
              ['Mais Antigos', 'desc'],
              ['Mais Novos', 'asc']
            ], params[:sort_admission]),
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-black-900" %>
      </div>

      <div class="flex space-x-2"> 
        <%= submit_tag "Buscar", class: "flex-1 bg-black hover:bg-gray-700 text-white px-6 py-2 rounded-lg font-medium transition duration-200" %>
        <%= link_to "Limpar", employees_path, class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition duration-200" %> 
      </div>

    </div>
  <% end %>
</div>


  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @employees.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-black">
          <tr>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Funcionário</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">CPF</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Cargo</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Contato</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Status</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Ações</th>
          </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-200">
          <% @employees.each do |employee| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <p class="text-sm text-center font-medium text-gray-900"><%= employee.full_name %></p>
                <% if employee.admission_date %>
                  <p class="text-xs text-center text-gray-500"><%= employee.years_of_service %> anos de serviço</p>
                <% end %>
              </td>

              <td class="px-6 py-4 text-sm text-center text-gray-900"><%= employee.formatted_cpf %></td>

              <td class="px-6 py-4 text-center">
                <span class="px-3 py-1 text-xs text-center font-medium rounded-full bg-purple-100 text-purple-800">
                  <%= employee.position&.titleize || '-' %>
                </span>
              </td>

              <td class="px-6 py-4 text-sm text-center text-gray-900">
                <p><%= employee.formatted_phone %></p>
                <p class="text-xs text-center text-gray-500"><%= employee.email || '-' %></p>
              </td>

              <td class="px-6 py-4 text-center">
                <span class="px-3 py-1 text-xs font-medium rounded-full <%= employee.status_color %>">
                  <%= employee.status&.titleize %>
                </span>
              </td>

              <td class="px-6 py-4 text-center space-x-2">
                <div class="flex flex-col items-center space-y-2 w-full">
                  <%= link_to "Visualizar", employee_path(employee),
                      class: "bg-blue-200 text-blue-700 px-5 py-2 rounded-lg hover:bg-blue-100 text-center text-sm font-medium" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-12">
        <p class="mt-4 text-xl text-gray-600">Nenhum funcionário cadastrado</p>
        <%= link_to "Cadastrar primeiro funcionário", new_employee_path,
            class: "mt-4 inline-block bg-black hover:bg-gray-800 text-white px-6 py-3 rounded-lg font-medium transition duration-200" %>
      </div>
    <% end %>
  </div>
</div>