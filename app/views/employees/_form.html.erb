<div class="space-y-6">
  <%= form_with(model: employee, local: true, class: "space-y-8 max-w-4xl mx-auto", data: { controller: "submit-once" }) do |form| %>

    <div class="bg-white rounded-lg shadow-lg overflow-hidden">

      <div class="px-6 py-4 bg-black border-b border-gray-200">
        <h2 class="text-xl font-bold text-white">Dados do Funcionário</h2>
      </div>

      <div class="p-6">

        <% if employee.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md mb-6">
            <div class="flex">
              <span class="text-red-500 text-xl">⚠️</span>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(employee.errors.count, "erro") %> ao salvar:
                </h3>
                <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                  <% employee.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Foto 3x4 + Informações Pessoais lado a lado -->
        <div class="flex flex-col md:flex-row gap-6 pb-6 border-b border-gray-200">

          <!-- Foto do Funcionário (3x4) -->
          <div class="flex-shrink-0" data-controller="image-crop" data-image-crop-aspect-ratio-value="0.75">

            <div class="flex flex-col items-center gap-3">
              <!-- Preview da foto -->
              <div class="<%= employee.photo.attached? ? '' : 'hidden' %>" data-image-crop-target="previewContainer">
                <div class="relative">
                  <% if employee.photo.attached? %>
                    <%= image_tag employee.photo.variant(resize_to_limit: [150, 200]),
                        class: "w-44 h-80 rounded-lg object-cover border border-gray-300",
                        data: { image_crop_target: "preview" } %>
                  <% else %>
                    <img src="" alt="Preview" class="w-44 h-80 rounded-lg object-cover border border-gray-300" data-image-crop-target="preview">
                  <% end %>
                  <button type="button"
                          data-action="click->image-crop#removePhoto"
                          class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-600 text-sm font-bold">
                    X
                  </button>
                </div>
              </div>

              <!-- Placeholder quando sem foto -->
              <div class="<%= employee.photo.attached? ? 'hidden' : '' %> w-44 h-80 rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 flex flex-col items-center justify-center text-gray-400" data-image-crop-target="placeholder">
                <svg class="w-10 h-10 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="text-xs">Sem foto</span>
              </div>

              <!-- Input de arquivo -->
              <div>
                <%= form.file_field :photo,
                    accept: "image/*",
                    class: "block w-full text-xs text-gray-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-medium file:bg-black file:text-white hover:file:bg-gray-700 file:cursor-pointer",
                    data: { image_crop_target: "input", action: "change->image-crop#fileSelected" } %>
                <p class="mt-1 text-xs text-gray-400 text-center">JPG, PNG. Máx: 5MB</p>
              </div>

              <!-- Checkbox oculto para remoção -->
              <%= form.check_box :photo_delete, { class: "hidden", data: { image_crop_target: "removeFlag" } }, "true", "false" %>
            </div>

            <!-- Modal de Crop -->
            <div class="hidden fixed inset-0 z-50 overflow-y-auto" data-image-crop-target="cropModal">
              <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
                <div class="relative bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:max-w-2xl sm:w-full">
                  <div class="bg-black px-4 py-3">
                    <h3 class="text-lg font-medium text-white">Recortar Foto</h3>
                  </div>
                  <div class="bg-gray-100 p-4">
                    <div class="max-h-96 overflow-hidden">
                      <img src="" alt="Imagem para recorte" class="max-w-full" data-image-crop-target="cropImage">
                    </div>
                  </div>
                  <div class="bg-gray-50 px-4 py-3 flex flex-wrap justify-center gap-2">
                    <button type="button" data-action="click->image-crop#rotateLeft" class="px-3 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-medium text-gray-700">Girar Esquerda</button>
                    <button type="button" data-action="click->image-crop#rotateRight" class="px-3 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-medium text-gray-700">Girar Direita</button>
                    <button type="button" data-action="click->image-crop#zoomIn" class="px-3 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-medium text-gray-700">+ Zoom</button>
                    <button type="button" data-action="click->image-crop#zoomOut" class="px-3 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-medium text-gray-700">- Zoom</button>
                    <button type="button" data-action="click->image-crop#reset" class="px-3 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-medium text-gray-700">Resetar</button>
                  </div>
                  <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse border-t border-gray-200">
                    <button type="button" data-action="click->image-crop#applyCrop" class="w-full inline-flex justify-center rounded-lg px-4 py-2 bg-green-600 hover:bg-green-500 text-base font-medium text-white shadow-lg transition cursor-pointer sm:ml-3 sm:w-auto sm:text-sm">Aplicar Recorte</button>
                    <button type="button" data-action="click->image-crop#closeCropModal" class="mt-3 w-full inline-flex justify-center rounded-lg bg-gray-200 border border-gray-300 hover:bg-white px-4 py-2 text-base font-medium text-gray-700 transition sm:mt-0 sm:w-auto sm:text-sm">Cancelar</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Informações Pessoais -->
          <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
              <%= form.label :full_name, "Nome Completo *", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :full_name,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  required: true %>
            </div>

            <div>
              <%= form.label :cpf, "CPF *", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :cpf,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "000.000.000-00",
                  maxlength: 14,
                  required: true %>
            </div>

            <div>
              <%= form.label :phone, "Telefone *", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :phone,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "(00) 00000-0000",
                  required: true %>
            </div>

            <div>
              <%= form.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.email_field :email,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "email@exemplo.com" %>
            </div>

            <div>
              <div class="flex items-center gap-1 mb-2">
                <%= form.label :position, "Cargo *", class: "text-sm font-medium text-gray-700" %>
              </div>
              <%= form.select :position,
                  [
                    ['Gerente', 'gerente'],
                    ['Vendedor', 'vendedor'],
                    ['Caixa', 'caixa'],
                    ['Estoquista', 'estoquista'],
                    ['Manicure', 'manicure'],
                    ['Cabeleireira', 'cabeleireira'],
                    ['Esteticista', 'esteticista'],
                    ['Maquiador', 'maquiador'],
                    ['Atendente', 'atendente'],
                    ['Auxiliar', 'auxiliar']
                  ],
                  {},
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  required: true %>
            </div>

            <div>
              <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :status,
                  [
                    ['Ativo', 'ativo'],
                    ['Inativo', 'inativo'],
                    ['Férias', 'ferias'],
                    ['Afastado', 'afastado']
                  ],
                  {},
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
            </div>

            <div>
              <%= form.label :address, "Endereço", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_area :address,
                  rows: 2,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
            </div>
          </div>
        </div>

        <!-- Informações Profissionais -->
        <div class="pt-6 pb-6 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Informações Profissionais</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= form.label :admission_date, "Data de Admissão", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.date_field :admission_date,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
            </div>

            <div>
              <%= form.label :salary, "Salário (R$)", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.number_field :salary,
                  step: 0.01,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "0.00" %>
            </div>

            <div class="md:col-span-2">
              <%= form.label :work_days, "Dias de Trabalho", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :work_days,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "Ex: Segunda a Sexta, 8h às 18h" %>
            </div>

            <div class="md:col-span-2">
              <%= form.label :notes, "Observações", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_area :notes,
                  rows: 3,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100
                          focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
            </div>
          </div>
        </div>

        <div class="flex justify-between items-center pt-2">
          <div class="text-xs text-gray-500">* campos obrigatórios</div>
        </div>

      </div>
    </div>

    <div class="flex justify-end space-x-3 pt-6 border-t border-gray-200">
      <%= link_to "Cancelar", employees_path,
          class: "px-6 py-3 rounded-lg bg-gray-200 border border-gray-300 hover:bg-white
                 text-gray-700 font-medium transition" %>

      <%= form.submit "Salvar Funcionário",
          class: "px-6 py-3 bg-green-600 hover:bg-green-500 text-white rounded-lg 
                 font-medium shadow-lg transition cursor-pointer" %>
    </div>
  <% end %>
</div>

<script>
(function() {
  function removerOpcaoVazia() {
    const selectPosition = document.getElementById('employee_position');
    if (selectPosition) {
      // Remove a opção vazia (a primeira opção)
      const primeiraOpcao = selectPosition.querySelector('option[value=""]');
      if (primeiraOpcao) {
        primeiraOpcao.remove();
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', removerOpcaoVazia);
  } else {
    removerOpcaoVazia();
  }

  document.addEventListener('turbo:load', removerOpcaoVazia);
})();
</script>

<script>
  (function() {
    console.log('Máscaras ativadas!');

    function aplicar() {
      const cpf = document.querySelector('input[name="employee[cpf]"]');
      if (cpf && !cpf.dataset.m) {
        cpf.dataset.m = '1';
        cpf.addEventListener('input', function(e) {
          let v = e.target.value.replace(/\D/g, ''); 
          if (v.length > 11) v = v.slice(0, 11);     

          if (v.length > 9) {
            // 10 ou 11 dígitos
            v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
          } else if (v.length > 6) {
            // 7 a 9 dígitos
            v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
          } else if (v.length > 3) {
            // 4 a 6 dígitos
            v = v.replace(/(\d{3})(\d{1,3})/, '$1.$2');
          }
          e.target.value = v;
        });
        console.log('CPF ok');
      }

      const tel = document.querySelector('input[name="employee[phone]"]');
      if (tel && !tel.dataset.m) {
        tel.dataset.m = '1';
        tel.addEventListener('input', function(e) {
          let v = e.target.value.replace(/\D/g, ''); 
          if (v.length > 11) v = v.slice(0, 11);     

          if (v.length > 10) {
            // 11 dígitos: (XX) XXXXX-XXXX
            v = v.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
          } else if (v.length > 6) {
            // 7 a 10 dígitos: (XX) XXXX-XXXX (progressivo)
            v = v.replace(/(\d{2})(\d{4})(\d{1,4})/, '($1) $2-$3');
          } else if (v.length > 2) {
            // 3 a 6 dígitos: (XX) XXXX (progressivo)
            v = v.replace(/(\d{2})(\d{1,4})/, '($1) $2');
          } else if (v.length > 0) {
            // 1 a 2 dígitos: (XX (progressivo)
            v = v.replace(/(\d{1,2})/, '($1');
          }

          e.target.value = v;
        });
        console.log('Tel ok');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', aplicar);
    } else {
      aplicar();
    }
    document.addEventListener('turbo:load', aplicar);
    setTimeout(aplicar, 100);
  })();
  </script>