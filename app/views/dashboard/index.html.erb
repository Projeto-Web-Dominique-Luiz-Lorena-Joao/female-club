<div class="flex min-h-screen bg-gray-50">
  <!-- Main Content -->
  <main class="flex-1">
    <div class="mb-6">
      <h2 class="text-3xl font-bold text-gray-900">Dashboard</h2>
      <p class="text-gray-600 mt-1">Visão geral do seu negócio</p>
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Vendas do Mês -->
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-gray-600 text-sm font-medium">Vendas do Mês</h3>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="text-2xl font-bold text-gray-900 mb-2">R$ <%= number_to_currency(@vendas_mes, unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
        <p class="text-sm text-gray-500 flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
          Mês atual
        </p>
      </div>

      <!-- Total de Vendas -->
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-gray-600 text-sm font-medium">Total de Vendas</h3>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
        </div>
        <p class="text-2xl font-bold text-gray-900 mb-2"><%= @total_vendas %></p>
        <p class="text-sm text-gray-500 flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Este mês
        </p>
      </div>

      <!-- Clientes Ativos -->
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-gray-600 text-sm font-medium">Clientes Ativos</h3>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
        <p class="text-2xl font-bold text-gray-900 mb-2"><%= @clientes_ativos %></p>
        <p class="text-sm text-gray-500 flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Últimos 30 dias
        </p>
      </div>

      <!-- Estoque Baixo -->
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-gray-600 text-sm font-medium">Estoque Baixo</h3>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>
        <p class="text-2xl font-bold text-gray-900 mb-2"><%= @estoque_baixo %> itens</p>
        <p class="text-sm <%= @estoque_baixo > 0 ? 'text-red-600' : 'text-green-600' %> flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <%= @estoque_baixo > 0 ? 'Requer atenção' : 'Tudo OK' %>
        </p>
      </div>
    </div>

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Desempenho de Vendas -->
      <div class="lg:col-span-2 bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Desempenho de Vendas</h3>
        <canvas id="salesChart" height="80"></canvas>
      </div>

      <!-- Produtos Mais Vendidos -->
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-black mb-4">Produtos Mais Vendidos</h3>
        <% if @produtos_mais_vendidos.any? %>
          <div class="space-y-4">
            <% @produtos_mais_vendidos.each_with_index do |produto, index| %>
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <div class="w-8 h-8 bg-black text-white rounded-full flex items-center justify-center font-semibold text-sm mr-3">
                    <%= index + 1 %>
                  </div>
                  <div>
                    <p class="font-medium text-black"><%= produto[:nome] %></p>
                    <p class="text-sm text-gray-500"><%= produto[:unidades] %> unidades</p>
                  </div>
                </div>
                <p class="font-semibold text-gray-900">R$ <%= number_to_currency(produto[:valor], unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8 text-gray-500">
            <svg class="w-12 h-12 mx-auto mb-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
            </svg>
            <p>Nenhuma venda registrada este mês</p>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Função para inicializar o gráfico
  function initializeSalesChart() {
    const ctx = document.getElementById('salesChart');
    if (!ctx) {
      console.log('Canvas não encontrado, tentando novamente...');
      setTimeout(initializeSalesChart, 100);
      return;
    }

    // Destruir gráfico anterior se existir
    if (window.salesChartInstance) {
      window.salesChartInstance.destroy();
    }

    window.salesChartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['7 meses atrás', '6 meses atrás', '5 meses atrás', '4 meses atrás', '3 meses atrás', '2 meses atrás', 'Mês passado', 'Este mês'],
        datasets: [{
          label: 'Vendas (R$)',
          data: <%= raw @vendas_data.to_json %>,
          borderColor: 'rgb(17, 24, 39)',
          backgroundColor: 'rgba(17, 24, 39, 0.1)',
          tension: 0.3,
          borderWidth: 2,
          pointRadius: 4,
          pointBackgroundColor: 'rgb(17, 24, 39)',
          fill: true
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            display: true,
            position: 'top'
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                let label = context.dataset.label || '';
                if (label) {
                  label += ': ';
                }
                if (context.parsed.y !== null) {
                  label += new Intl.NumberFormat('pt-BR', { 
                    style: 'currency', 
                    currency: 'BRL' 
                  }).format(context.parsed.y);
                }
                return label;
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: {
              color: 'rgba(0, 0, 0, 0.05)'
            },
            ticks: {
              callback: function(value) {
                return 'R$ ' + new Intl.NumberFormat('pt-BR').format(value);
              }
            }
          },
          x: {
            grid: {
              display: false
            }
          }
        }
      }
    });
  }

  // Inicializar quando a página carregar
  document.addEventListener('DOMContentLoaded', function() {
    initializeSalesChart();
  });

  // Inicializar quando o Turbo terminar de carregar a página
  document.addEventListener('turbo:load', function() {
    initializeSalesChart();
  });

  // Inicializar quando a frame terminar de carregar
  document.addEventListener('turbo:frame-load', function() {
    initializeSalesChart();
  });

  // Inicializar também no carregamento tradicional (fallback)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSalesChart);
  } else {
    initializeSalesChart();
  }
</script>