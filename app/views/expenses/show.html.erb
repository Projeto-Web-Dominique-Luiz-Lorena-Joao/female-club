<div class="container mx-auto px-4 max-w-4xl">
  <div class="flex justify-between items-center mb-6">
    <%= link_to expenses_path, class: "bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2 transition shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="3" fill="none"
           class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
        </svg>
      Voltar
    <% end %>

    <div class="flex gap-2">
      <%= link_to edit_expense_path(@expense), class: "bg-orange-400 hover:bg-orange-500 text-white px-4 py-2 rounded-lg font-medium flex items-center gap-2" do %>
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
        </svg>
        Editar
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="bg-black text-white px-6 py-6">
      <div class="flex items-center gap-3 mb-2">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <h1 class="text-2xl font-bold">Detalhes da Despesa</h1>
      </div>
    </div>

    <div class="p-6">
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div>
          <p class="text-sm text-gray-500 mb-1">Categoria:</p>
          <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-blue-800 font-semibold text-sm">
            <%= @expense.category_label %>
          </span>
        </div>

        <div class="text-right">
          <p class="text-sm text-gray-500 mb-1">Data da Despesa:</p>
          <p class="font-semibold"><%= l(@expense.expense_date, format: :default) %></p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6 text-sm">
        <div>
          <p class="text-gray-500 mb-1">Tipo de Despesa:</p>
          <p class="font-semibold text-gray-900"><%= @expense.expense_type_label %></p>
        </div>
        
        <div class="md:col-span-2">
          <p class="text-gray-500 mb-1">Forma de Pagamento:</p>
          <p class="font-semibold text-gray-900">
            <% payment_methods = { "dinheiro" => "Dinheiro", "cartao_credito" => "Cartão de Crédito", "cartao_debito" => "Cartão de Débito", "pix" => "PIX", "transferencia" => "Transferência", "boleto" => "Boleto" } %>
            <%= payment_methods[@expense.payment_method] || @expense.payment_method.humanize %>
          </p>
        </div>
      </div>

      <hr class="my-6 border-gray-200">

      <div class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h2 class="font-semibold text-gray-900">Resumo de Valores</h2>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-4 space-y-2">
          <div class="flex justify-between text-lg pt-1">
            <span class="font-semibold">Valor Total:</span>
            <span class="font-bold text-gray-900">R$ <%= number_with_precision(@expense.amount, precision: 2, delimiter: '.', separator: ',') %></span>
          </div>
        </div>
      </div>

      <hr class="my-6 border-gray-200">

      <div class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75a.75.75 0 00.75-.75V13.5a.75.75 0 00-.75-.75H6.75a.75.75 0 00-.75.75v3.75c0 .415.336.75.75.75z" />
          </svg>
          <h2 class="font-semibold text-gray-900">Fornecedor</h2>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="font-medium text-gray-900 mb-1">
            <% if @expense.supplier %>
              <%= @expense.supplier.display_name %>
            <% else %>
              <span class="text-gray-500">Não informado</span>
            <% end %>
          </p>
        </div>
      </div>

      <hr class="my-6 border-gray-200">

      <div class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
          <h2 class="font-semibold text-gray-900">Funcionário Responsável</h2>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="font-medium text-gray-900 mb-1">
            <% if @expense.employee %>
              <%= @expense.employee.full_name %>
            <% else %>
              <span class="text-gray-500">Não informado</span>
            <% end %>
          </p>
        </div>
      </div>

      <% if @expense.notes.present? %>
        <hr class="my-6 border-gray-200">
        <div class="mb-4">
          <div class="flex items-center gap-2 mb-3">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-700">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            <h2 class="font-semibold text-gray-900">Anotações</h2>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-gray-700 text-sm whitespace-pre-wrap"><%= @expense.notes %></p>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <div class="mt-6 text-center">
    <%= button_to "Excluir Despesa", expense_path(@expense), method: :delete, class: "bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg font-medium", data: { confirm: "Tem certeza que deseja excluir esta despesa?" } %>
  </div>
</div>