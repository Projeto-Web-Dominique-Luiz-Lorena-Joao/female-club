<div class="min-h-screen bg-gray-50 p-8">
  <div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900">Detalhes da Despesa</h1>
        <p class="text-gray-600 mt-2">Data: <%= l(@expense.expense_date, format: :long) %></p>
      </div>
      <div class="flex gap-2">
        <%= link_to "Editar", edit_expense_path(@expense), class: "bg-yellow-600 text-white px-6 py-2 rounded-lg hover:bg-yellow-700 font-medium" %>
        <%= link_to "Deletar", expense_path(@expense), method: :delete, data: { confirm: "Tem certeza?" }, class: "bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 font-medium" %>
      </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-lg shadow p-8">
      <div class="grid grid-cols-2 gap-6 mb-8">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Funcionário</label>
          <p class="text-lg text-gray-900"><%= @expense.employee.full_name %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Fornecedor</label>
          <p class="text-lg text-gray-900"><%= @expense.supplier&.display_name || '-' %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Valor</label>
          <p class="text-2xl font-bold text-gray-900">R$ <%= number_with_precision(@expense.amount, precision: 2, delimiter: ',', separator: '.') %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Forma de Pagamento</label>
          <p class="text-lg text-gray-900">
            <% payment_methods = { "dinheiro" => "Dinheiro", "cartao_credito" => "Cartão de Crédito", "cartao_debito" => "Cartão de Débito", "pix" => "PIX", "transferencia" => "Transferência", "boleto" => "Boleto" } %>
            <%= payment_methods[@expense.payment_method] %>
          </p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Despesa</label>
          <p class="text-lg text-gray-900"><%= @expense.expense_type_label %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Categoria</label>
          <span class="px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
            <%= @expense.category_label %>
          </span>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
          <span class="px-3 py-1 rounded-full text-sm font-medium <%= @expense.status == 'ativa' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
            <%= @expense.status_label %>
          </span>
        </div>
      </div>

      <% if @expense.notes.present? %>
        <div class="border-t border-gray-200 pt-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">Anotações</label>
          <p class="text-gray-700 whitespace-pre-wrap"><%= @expense.notes %></p>
        </div>
      <% end %>

      <div class="flex gap-4 pt-6 border-t border-gray-200 mt-6">
        <%= link_to "Voltar", expenses_path, class: "flex-1 text-center bg-gray-200 text-gray-800 px-6 py-2 rounded-lg hover:bg-gray-300 font-medium" %>
      </div>
    </div>
  </div>
</div>
