<div class="space-y-6">

  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Despesas</h1>
      <p class="mt-2 text-gray-600">Gerenciar despesas</p>
    </div>
    <%= link_to new_expense_path,
        class: "bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition duration-200 inline-flex items-center" do %>
      Adicionar Despesa
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: expenses_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">

        <div>
          <%= f.label :employee_id, "Funcionário", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :employee_id,
              Employee.all,
              :id,
              :full_name,
              { prompt: "Todos", selected: params[:employee_id] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" %>
        </div>

        <div>
          <%= f.label :supplier_id, "Fornecedor", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :supplier_id,
              Supplier.all,
              :id,
              :display_name,
              { prompt: "Todos", selected: params[:supplier_id] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" %>
        </div>

        <div>
          <%= f.label :expense_type, "Tipo", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :expense_type,
              [
                ["Todos", ""],
                ["Aluguel", "aluguel"],
                ["Utilidades", "utilities"],
                ["Salários", "salaries"],
                ["Suprimentos", "supplies"],
                ["Manutenção", "maintenance"],
                ["Marketing", "marketing"],
                ["Seguro", "insurance"],
                ["Impostos", "taxes"],
                ["Outro", "other"]
              ],
              { selected: params[:expense_type] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" %>
        </div>

        <div>
          <%= f.label :category, "Categoria", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :category,
              [
                ["Todas", ""],
                ["Fixa Mensal", "fixa_mensal"],
                ["Fixa Anual", "fixa_anual"],
                ["Esporádica", "esporadica"],
                ["Rara", "rara"]
              ],
              { selected: params[:category] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" %>
        </div>
      </div>

      <div class="flex justify-start space-x-2">
        <%= f.submit "Filtrar", class: "bg-black hover:bg-gray-700 text-white px-6 py-2 rounded-lg font-medium transition duration-200 cursor-pointer" %>
        <%= link_to "Limpar", expenses_path, class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition duration-200" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @expenses.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-black">
            <tr>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Data</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Funcionário</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Fornecedor</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Tipo</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Categoria</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Valor</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @expenses.each do |expense| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-center text-sm text-gray-900">
                  <%= l(expense.expense_date, format: :long) %>
                </td>
                <td class="px-6 py-4 text-center text-sm text-gray-900">
                  <%= expense.employee.full_name %>
                </td>
                <td class="px-6 py-4 text-center text-sm text-gray-900">
                  <%= expense.supplier.display_name %>
                </td>
                <td class="px-6 py-4 text-center text-sm text-gray-900">
                  <%= expense.expense_type_label %>
                </td>
                <td class="px-6 py-4 text-center text-sm">
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    <%= expense.category_label %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center text-sm font-semibold text-gray-900">
                  R$ <%= number_with_precision(expense.amount, precision: 2, delimiter: ',', separator: '.') %>
                </td>
                <td class="px-6 py-4 text-center">
                  <div class="flex justify-center items-center space-x-2">
                    <%= link_to "Visualizar", expense_path(expense), class: "bg-blue-200 text-blue-700 px-5 py-2 rounded-lg hover:bg-blue-100 text-center text-sm font-medium" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-6 py-4 border-t border-gray-200">
        <%#= paginate @expenses %>
      </div>

    <% else %>
      <div class="text-center py-12">
        <p class="mt-4 text-xl text-gray-600">Nenhuma despesa registrada</p>
        <%= link_to "Adicionar Despesa", new_expense_path,
            class: "mt-4 inline-block bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium transition duration-200" %>
      </div>
    <% end %>
  </div>
</div>