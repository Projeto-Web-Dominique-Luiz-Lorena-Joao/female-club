<div class="min-h-screen bg-gray-50 p-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900">Despesas</h1>
        <p class="text-gray-600 mt-2">Gerenciar despesas do clube feminino</p>
      </div>
      <%= link_to "Adicionar Despesa", new_expense_path, class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 font-medium" %>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow p-6 mb-8">
      <%= form_with url: expenses_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-5 gap-4" do |f| %>
        <div>
          <%= f.label :employee_id, "Funcionário", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.collection_select :employee_id,
              Employee.all,
              :id,
              :full_name,
              { prompt: "Todos", selected: params[:employee_id] },
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :supplier_id, "Fornecedor", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.collection_select :supplier_id,
              Supplier.all,
              :id,
              :display_name,
              { prompt: "Todos", selected: params[:supplier_id] },
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :expense_type, "Tipo", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :expense_type,
              [
                ["Todos", ""],
                ["Aluguel", "aluguel"],
                ["Utilidades", "utilities"],
                ["Salários", "salaries"],
                ["Suprimentos", "supplies"],
                ["Manutenção", "maintenance"],
                ["Marketing", "marketing"],
                ["Seguro", "insurance"],
                ["Impostos", "taxes"],
                ["Outro", "other"]
              ],
              { selected: params[:expense_type] },
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :category, "Categoria", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :category,
              [
                ["Todas", ""],
                ["Fixa Mensal", "fixa_mensal"],
                ["Fixa Anual", "fixa_anual"],
                ["Esporádica", "esporadica"],
                ["Rara", "rara"]
              ],
              { selected: params[:category] },
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div class="flex items-end">
          <%= f.submit "Filtrar", class: "w-full bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 font-medium" %>
        </div>
      <% end %>
    </div>

    <!-- Expenses Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <% if @expenses.any? %>
        <table class="w-full">
          <thead class="bg-gray-100 border-b border-gray-200">
            <tr>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Data</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Funcionário</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Fornecedor</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Tipo</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Categoria</th>
              <th class="px-6 py-3 text-right text-sm font-semibold text-gray-900">Valor</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @expenses.each do |expense| %>
              <tr class="border-b border-gray-200 hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-900">
                  <%= l(expense.expense_date, format: :long) %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <%= expense.employee.full_name %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <%= expense.supplier.display_name %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <%= expense.expense_type_label %>
                </td>
                <td class="px-6 py-4 text-sm">
                  <span class="px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                    <%= expense.category_label %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 text-right font-medium">
                  R$ <%= number_with_precision(expense.amount, precision: 2, delimiter: ',', separator: '.') %>
                </td>
                <td class="px-6 py-4 text-sm">
                  <div class="flex gap-2">
                    <%= link_to "Ver", expense_path(expense), class: "text-blue-600 hover:text-blue-900" %>
                    <%= link_to "Editar", edit_expense_path(expense), class: "text-yellow-600 hover:text-yellow-900" %>
                    <%= link_to "Deletar", expense_path(expense), method: :delete, data: { confirm: "Tem certeza?" }, class: "text-red-600 hover:text-red-900" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="p-8 text-center">
          <p class="text-gray-500 text-lg">Nenhuma despesa registrada</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
