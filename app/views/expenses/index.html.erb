<div class="space-y-6">

  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Despesas</h1>
      <p class="mt-2 text-gray-600">Gerenciar despesas</p>
    </div>
    <%= link_to new_expense_path,
        class: "bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition duration-200 inline-flex items-center" do %>
      Adicionar Despesa
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg border border-gray-200 p-5">
      <div class="flex items-center gap-4">
        <div class="flex-shrink-0 bg-gray-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-gray-500 font-medium">Valor Total de Despesas</p>
          <p class="text-2xl font-bold text-gray-900 mt-1">
            R$ <%= number_with_precision(@expenses.where(status: 'ativa').sum(:amount), precision: 2, delimiter: '.', separator: ',') %>
          </p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-5">
      <div class="flex items-center gap-4">
        <div class="flex-shrink-0 bg-blue-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-gray-500 font-medium">Quantidade de Despesas</p>
          <p class="text-2xl font-bold text-gray-900 mt-1">
            <%= @expenses.where(status: 'ativa').count %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: expenses_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">

        <div>
          <%= f.label :employee_id, "Funcionário", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :employee_id,
              Employee.all,
              :id,
              :full_name,
              { prompt: "Todos", selected: params[:employee_id] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" %>
        </div>

        <div>
          <%= f.label :supplier_id, "Fornecedor", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :supplier_id,
              Supplier.all,
              :id,
              :display_name,
              { prompt: "Todos", selected: params[:supplier_id] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" %>
        </div>

        <div>
          <%= f.label :expense_type, "Tipo", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :expense_type,
              [
                ["Todos", ""],
                ["Aluguel", "aluguel"],
                ["Utilidades", "utilities"],
                ["Salários", "salaries"],
                ["Suprimentos", "supplies"],
                ["Manutenção", "maintenance"],
                ["Marketing", "marketing"],
                ["Seguro", "insurance"],
                ["Impostos", "taxes"],
                ["Outro", "other"]
              ],
              { selected: params[:expense_type] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" %>
        </div>

        <div>
          <%= f.label :category, "Categoria", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :category,
              [
                ["Todas", ""],
                ["Fixa Mensal", "fixa_mensal"],
                ["Fixa Anual", "fixa_anual"],
                ["Esporádica", "esporadica"],
                ["Rara", "rara"]
              ],
              { selected: params[:category] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" %>
        </div>

        <div>
          <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :status,
              [
                ["Todos", ""],
                ["Ativa", "ativa"],
                ["Inativa", "inativa"]
              ],
              { selected: params[:status] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" %>
        </div>
      </div>

      <div class="flex justify-start space-x-2">
        <%= f.submit "Filtrar", class: "bg-black hover:bg-gray-700 text-white px-6 py-2 rounded-lg font-medium transition duration-200 cursor-pointer" %>
        <%= link_to "Limpar", expenses_path, class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition duration-200" %>
      </div>
    <% end %>
  </div>

  <!-- Paginação Topo -->
  <% if @expenses.any? %>
    <%= render "shared/pagination_top", collection: @expenses %>
  <% end %>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @expenses.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-black">
            <tr>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Data</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Funcionário</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Fornecedor</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Tipo</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Categoria</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Status</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Valor</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @expenses.each do |expense| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-center text-sm text-gray-900">
                  <%= l(expense.expense_date, format: :long) %>
                </td>
                <td class="px-6 py-4 text-center text-sm text-gray-900">
                  <%= expense.employee.full_name %>
                </td>
                <td class="px-6 py-4 text-center text-sm text-gray-900">
                  <%= expense.supplier&.display_name || '-' %>
                </td>
                <td class="px-6 py-4 text-center text-sm text-gray-900">
                  <%= expense.expense_type_label %>
                </td>
                <td class="px-6 py-4 text-center text-sm">
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 whitespace-nowrap">
                    <%= expense.category_label %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center text-sm">
                  <span class="px-3 py-1 rounded-full text-xs font-medium <%= expense.status == 'ativa' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                    <%= expense.status_label %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center text-sm font-semibold text-gray-900">
                  R$ <%= number_with_precision(expense.amount, precision: 2, delimiter: '.', separator: ',') %>
                </td>
                <td class="px-6 py-4 text-center">
                  <div class="flex justify-center items-center space-x-2">
                    <%= link_to "Visualizar", expense_path(expense), class: "bg-blue-200 text-blue-700 px-5 py-2 rounded-lg hover:bg-blue-100 text-center text-sm font-medium" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% else %>
      <div class="text-center py-12">
        <p class="mt-4 text-xl text-gray-600">Nenhuma despesa registrada</p>
        <%= link_to "Adicionar Despesa", new_expense_path,
            class: "mt-4 inline-block bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium transition duration-200" %>
      </div>
    <% end %>
  </div>

  <%= render "shared/pagination_top", collection: @expenses %>
</div>