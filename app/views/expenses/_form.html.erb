<div class="space-y-6">
  <%= form_with model: @expense, local: true, class: "space-y-8 max-w-4xl mx-auto" do |f| %>
    
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="px-6 py-4 bg-black border-b border-gray-200">
        <h2 class="text-xl font-bold text-white">Dados da Despesa</h2>
      </div>

      <div class="p-6">
        <% if @expense.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md mb-6">
            <div class="flex">
              <span class="text-red-500 text-xl">⚠️</span>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@expense.errors.count, "erro") %> ao salvar:
                </h3>
                <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                  <% @expense.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :employee_id, "Funcionário", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.collection_select :employee_id,
                Employee.all,
                :id,
                :full_name,
                { prompt: "Selecione um funcionário" },
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div>
            <%= f.label :supplier_id, "Fornecedor", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.collection_select :supplier_id,
                Supplier.all,
                :id,
                :display_name,
                { prompt: "Selecione um fornecedor" },
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div>
            <%= f.label :expense_date, "Data da Despesa", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.date_field :expense_date,
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div>
            <%= f.label :amount, "Valor (R$)", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.number_field :amount,
                step: 0.01,
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div>
            <%= f.label :expense_type, "Tipo de Despesa", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :expense_type,
                [
                  ["Aluguel", "aluguel"],
                  ["Utilidades", "utilities"],
                  ["Salários", "salaries"],
                  ["Suprimentos", "supplies"],
                  ["Manutenção", "maintenance"],
                  ["Marketing", "marketing"],
                  ["Seguro", "insurance"],
                  ["Impostos", "taxes"],
                  ["Outro", "other"]
                ],
                { prompt: "Selecione um tipo" },
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div>
            <%= f.label :category, "Categoria", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :category,
                [
                  ["Fixa Mensal", "fixa_mensal"],
                  ["Fixa Anual", "fixa_anual"],
                  ["Esporádica", "esporadica"],
                  ["Rara", "rara"]
                ],
                { prompt: "Selecione uma categoria" },
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div>
            <%= f.label :payment_method, "Forma de Pagamento", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :payment_method,
                [
                  ["Dinheiro", "dinheiro"],
                  ["Cartão de Crédito", "cartao_credito"],
                  ["Cartão de Débito", "cartao_debito"],
                  ["PIX", "pix"],
                  ["Transferência", "transferencia"],
                  ["Boleto", "boleto"]
                ],
                { prompt: "Selecione uma forma de pagamento" },
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div class="md:col-span-2">
            <%= f.label :notes, "Anotações (opcional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.text_area :notes,
                rows: 4,
                placeholder: "Adicione qualquer anotação relevante sobre esta despesa",
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>
        </div>
      </div>
    </div>
    
    <div class="flex justify-end space-x-3 pt-6 border-t border-gray-200">
      <%= link_to "Cancelar", expenses_path, class: "px-6 py-3 rounded-lg bg-gray-200 border border-gray-300 hover:bg-white text-gray-700 font-medium transition" %>
      <%= f.submit "Salvar Despesa", class: "px-6 py-3 bg-green-600 hover:bg-green-500 text-white rounded-lg font-medium shadow-lg transition cursor-pointer" %>
    </div>
  <% end %>
</div>