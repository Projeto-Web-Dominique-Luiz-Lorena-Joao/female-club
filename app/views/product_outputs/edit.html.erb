<div class="w-full mb-8 pb-4 border-b border-gray-200 px-8">
  <div class="flex justify-between items-center max-w-4xl mx-auto">

    <div class="flex items-center gap-4">
      <div class="bg-black p-3 rounded-2xl shadow-lg flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" 
          stroke-width="1.5" stroke="white" class="size-8">
          <path stroke-linecap="round" stroke-linejoin="round" 
          d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
        </svg>
      </div>

      <div>
        <h1 class="text-2xl font-medium text-gray-900">Editar Saída de Produto</h1>
        <p class="text-gray-600 text-sm mt-1">
          Atualize os dados abaixo para modificar esta saída do estoque
        </p>
      </div>
    </div>

    <%= link_to "javascript:history.back()", class: "bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2 transition shadow-sm" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="3" fill="none"
           class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
      </svg>
      Voltar
    <% end %>

  </div>
</div>

<div class="max-w-4xl mx-auto">
  <div class="bg-white shadow-lg rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-black border-b border-gray-200">
      <h2 class="text-xl font-bold text-white">Dados da Saída</h2>
    </div>

    <div class="p-6">
      <%= form_with(model: @product_output, local: true, data: { turbo: false }) do |form| %>
        <% if @product_output.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md mb-6">
            <div class="flex">
              <span class="text-red-500 text-xl">⚠️</span>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@product_output.errors.count, "erro") %> encontrado:
                </h3>
                <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                  <% @product_output.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Seção de Produto (não editável) -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Produto
          </label>
          <div class="block w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 text-gray-700">
            <%= @product_output.product.name %>
          </div>
          <p class="text-xs text-gray-500 mt-1">Produto não pode ser alterado</p>
        </div>

        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label for="product_output_quantity" class="block text-sm font-medium text-gray-700 mb-2">
              Quantidade <span class="text-red-600">*</span>
            </label>
            <%= form.number_field :quantity, min: 1, class: "block w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent", placeholder: "0", required: true %>
          </div>

          <div>
            <label for="product_output_output_type" class="block text-sm font-medium text-gray-700 mb-2">
              Tipo de Saída <span class="text-red-600">*</span>
            </label>
            <select name="product_output[output_type]" id="product_output_output_type" class="block w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" required>
              <% ProductOutput.output_type_labels.each do |key, label| %>
                <option value="<%= key %>" <%= "selected" if @product_output.output_type == key.to_s %>>
                  <%= label %>
                </option>
              <% end %>
            </select>
          </div>
        </div>

        <div class="mb-6">
          <label for="product_output_date_output" class="block text-sm font-medium text-gray-700 mb-2">
            Data e Hora da Saída <span class="text-red-600">*</span>
          </label>
          <%= form.datetime_local_field :date_output, class: "block w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent", required: true %>
        </div>

        <div class="mb-6">
          <label for="product_output_notes" class="block text-sm font-medium text-gray-700 mb-2">
            Observações
          </label>
          <%= form.text_area :notes, rows: 4, class: "block w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent", placeholder: "Detalhes adicionais sobre a saída..." %>
        </div>

        <div class="flex justify-between items-center pt-2 mb-4">
          <div class="text-xs text-gray-500">* campos obrigatórios</div>
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t border-gray-200">
          <%= link_to "Cancelar", product_output_path(@product_output), class: "px-6 py-3 rounded-lg bg-gray-200 border border-gray-300 hover:bg-white text-gray-700 font-medium transition" %>
          <%= form.submit "Atualizar Saída", class: "px-6 py-3 bg-green-600 hover:bg-green-500 text-white rounded-lg font-medium shadow-lg transition cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>