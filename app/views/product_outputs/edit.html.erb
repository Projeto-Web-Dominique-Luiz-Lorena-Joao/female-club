<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Editar Saída de Produto</h1>

    <div class="bg-white shadow rounded-lg p-6">
      <%= form_with(model: @product_output, local: true) do |form| %>
        <% if @product_output.errors.any? %>
          <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded">
            <h2 class="text-lg font-semibold text-red-900 mb-2">
              <%= pluralize(@product_output.errors.count, "erro") %> encontrado:
            </h2>
            <ul class="text-red-800">
              <% @product_output.errors.full_messages.each do |message| %>
                <li class="mb-1">• <%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Produto
          </label>
          <div class="block w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-50 text-gray-700">
            <%= @product_output.product.name %>
          </div>
          <p class="text-xs text-gray-500 mt-1">Produto não pode ser alterado</p>
        </div>

        <div class="mb-6">
          <label for="product_output_quantity" class="block text-sm font-medium text-gray-700 mb-2">
            Quantidade <span class="text-red-600">*</span>
          </label>
          <%= form.number_field :quantity, min: 1, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", required: true %>
        </div>

        <div class="mb-6">
          <label for="product_output_output_type" class="block text-sm font-medium text-gray-700 mb-2">
            Tipo de Saída <span class="text-red-600">*</span>
          </label>
          <select name="product_output[output_type]" id="product_output_output_type" class="block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
            <% ProductOutput.output_type_labels.each do |key, label| %>
              <option value="<%= key %>" <%= "selected" if @product_output.output_type == key.to_s %>>
                <%= label %>
              </option>
            <% end %>
          </select>
        </div>

        <div class="mb-6">
          <label for="product_output_date_output" class="block text-sm font-medium text-gray-700 mb-2">
            Data da Saída <span class="text-red-600">*</span>
          </label>
          <%= form.datetime_select :date_output, { minute_step: 15 }, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", required: true %>
        </div>

        <div class="mb-6">
          <label for="product_output_notes" class="block text-sm font-medium text-gray-700 mb-2">
            Observações
          </label>
          <%= form.text_area :notes, rows: 4, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", placeholder: "Detalhes adicionais sobre a saída..." %>
        </div>

        <div class="flex gap-4">
          <%= form.submit "Atualizar Saída", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded" %>
          <%= link_to "Cancelar", product_output_path(@product_output), class: "bg-gray-400 hover:bg-gray-500 text-white font-bold py-2 px-6 rounded" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
