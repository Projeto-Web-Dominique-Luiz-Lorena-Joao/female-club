<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-900">Detalhes da Saída</h1>
      <div class="space-x-2">
        <%= link_to "Editar", edit_product_output_path(@product_output), class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
        <%= link_to "Voltar", product_outputs_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg p-6">
      <div class="grid grid-cols-2 gap-6 mb-6">
        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase">Produto</h3>
          <p class="text-lg font-semibold text-gray-900 mt-1">
            <%= link_to @product_output.product.name, product_path(@product_output.product), class: "text-blue-600 hover:text-blue-900" %>
          </p>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase">Tipo de Saída</h3>
          <p class="text-lg font-semibold text-gray-900 mt-1">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
              <%= @product_output.output_label %>
            </span>
          </p>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase">Quantidade</h3>
          <p class="text-lg font-semibold text-gray-900 mt-1">
            <%= @product_output.quantity %>
          </p>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase">Data da Saída</h3>
          <p class="text-lg font-semibold text-gray-900 mt-1">
            <%= l(@product_output.date_output, format: :long) %>
          </p>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase">Registrado por</h3>
          <p class="text-lg font-semibold text-gray-900 mt-1">
            <%= @product_output.created_by&.email || "Sistema" %>
          </p>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase">Data de Registro</h3>
          <p class="text-lg font-semibold text-gray-900 mt-1">
            <%= l(@product_output.created_at, format: :short) %>
          </p>
        </div>
      </div>

      <% if @product_output.notes.present? %>
        <div class="mb-6 p-4 bg-gray-50 rounded-lg">
          <h3 class="text-sm font-medium text-gray-700 uppercase mb-2">Observações</h3>
          <p class="text-gray-700 whitespace-pre-wrap"><%= @product_output.notes %></p>
        </div>
      <% end %>

      <div class="flex gap-4 pt-6 border-t border-gray-200">
        <%= link_to "Editar", edit_product_output_path(@product_output), class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
        <%= link_to "Deletar", product_output_path(@product_output), method: :delete, data: { confirm: "Tem certeza?" }, class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
        <%= link_to "Voltar", product_outputs_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    </div>
  </div>
</div>
