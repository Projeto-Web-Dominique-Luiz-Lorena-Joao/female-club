<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Saídas de Produtos</h1>
    <%= link_to "Registrar Saída", new_product_output_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <!-- Filtros -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label for="product_id" class="block text-sm font-medium text-gray-700">Produto</label>
        <select name="product_id" id="product_id" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
          <option value="">Todos os produtos</option>
          <% Product.active.order(:name).each do |product| %>
            <option value="<%= product.id %>" <%= "selected" if params[:product_id] == product.id.to_s %>>
              <%= product.name %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label for="output_type" class="block text-sm font-medium text-gray-700">Tipo de Saída</label>
        <select name="output_type" id="output_type" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
          <option value="">Todos os tipos</option>
          <% ProductOutput.output_type_labels.each do |key, label| %>
            <option value="<%= key %>" <%= "selected" if params[:output_type] == key.to_s %>>
              <%= label %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label for="start_date" class="block text-sm font-medium text-gray-700">Data Início</label>
        <input type="date" name="start_date" id="start_date" value="<%= params[:start_date] %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
      </div>

      <div>
        <label for="end_date" class="block text-sm font-medium text-gray-700">Data Fim</label>
        <input type="date" name="end_date" id="end_date" value="<%= params[:end_date] %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
      </div>

      <div class="flex items-end">
        <button type="submit" class="w-full bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
          Filtrar
        </button>
      </div>
    </form>
  </div>

  <!-- Tabela -->
  <% if @product_outputs.any? %>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Produto</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Tipo</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Quantidade</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Data</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Registrado por</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @product_outputs.each do |output| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= link_to output.product.name, product_path(output.product), class: "text-blue-600 hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                  <%= output.output_label %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 text-center">
                <%= output.quantity %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                <%= l(output.date_output, format: :short) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                <%= output.created_by&.email || "Sistema" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                <%= link_to "Ver", product_output_path(output), class: "text-blue-600 hover:text-blue-900" %>
                <%= link_to "Editar", edit_product_output_path(output), class: "text-gray-600 hover:text-gray-900" %>
                <%= link_to "Deletar", product_output_path(output), method: :delete, data: { confirm: "Tem certeza?" }, class: "text-red-600 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Paginação -->
    <div class="mt-6">
      <%= paginate @product_outputs %>
    </div>
  <% else %>
    <div class="bg-white shadow rounded-lg p-6 text-center text-gray-500">
      <p>Nenhuma saída de produto registrada.</p>
    </div>
  <% end %>
</div>
