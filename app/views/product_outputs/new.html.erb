<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Registrar Saída de Produto</h1>

    <div class="bg-white shadow rounded-lg p-6">
      <%= form_with(model: @product_output, local: true) do |form| %>
        <% if @product_output.errors.any? %>
          <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded">
            <h2 class="text-lg font-semibold text-red-900 mb-2">
              <%= pluralize(@product_output.errors.count, "erro") %> encontrado:
            </h2>
            <ul class="text-red-800">
              <% @product_output.errors.full_messages.each do |message| %>
                <li class="mb-1">• <%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-6">
          <label for="product_output_product_id" class="block text-sm font-medium text-gray-700 mb-2">
            Produto <span class="text-red-600">*</span>
          </label>
          <select name="product_output[product_id]" id="product_output_product_id" class="block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
            <option value="">Selecione um produto</option>
            <% Product.active.order(:name).each do |product| %>
              <option value="<%= product.id %>" <%= "selected" if @product&.id == product.id %>>
                <%= product.name %> (Est. Atual: <%= product.quantity %>)
              </option>
            <% end %>
          </select>
        </div>

        <div class="mb-6">
          <label for="product_output_quantity" class="block text-sm font-medium text-gray-700 mb-2">
            Quantidade <span class="text-red-600">*</span>
          </label>
          <%= form.number_field :quantity, min: 1, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", placeholder: "0", required: true %>
        </div>

        <div class="mb-6">
          <label for="product_output_output_type" class="block text-sm font-medium text-gray-700 mb-2">
            Tipo de Saída <span class="text-red-600">*</span>
          </label>
          <select name="product_output[output_type]" id="product_output_output_type" class="block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
            <option value="">Selecione o tipo</option>
            <% ProductOutput.output_type_labels.each do |key, label| %>
              <option value="<%= key %>"><%= label %></option>
            <% end %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label for="product_output_date_output" class="block text-sm font-medium text-gray-700 mb-2">
              Data da Saída <span class="text-red-600">*</span>
            </label>
            <%= form.date_field :date_output, value: Date.today, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", required: true %>
          </div>

          <div>
            <label for="product_output_date_output_time" class="block text-sm font-medium text-gray-700 mb-2">
              Horário
            </label>
            <input type="time" id="product_output_date_output_time" name="product_output[date_output_time]" value="<%= Time.current.strftime('%H:%M') %>" class="block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" />
          </div>
        </div>

        <div class="mb-6">
          <label for="product_output_notes" class="block text-sm font-medium text-gray-700 mb-2">
            Observações
          </label>
          <%= form.text_area :notes, rows: 4, class: "block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", placeholder: "Detalhes adicionais sobre a saída..." %>
        </div>

        <div class="flex gap-4">
          <%= form.submit "Registrar Saída", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded" %>
          <%= link_to "Cancelar", product_outputs_path, class: "bg-gray-400 hover:bg-gray-500 text-white font-bold py-2 px-6 rounded" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
