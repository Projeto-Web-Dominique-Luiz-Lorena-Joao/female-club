<div class="w-full mb-8 pb-4 border-b border-gray-200 px-8">
  <div class="flex justify-between items-center max-w-4xl mx-auto">

    <div class="flex items-center gap-4">
      <div class="bg-black p-3 rounded-2xl shadow-lg flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="white" class="size-8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 8.25H7.5a2.25 2.25 0 0 0-2.25 2.25v9a2.25 2.25 0 0 0 2.25 2.25h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25H15m0-3-3-3m0 0-3 3m3-3V15" />
        </svg>
      </div>

      <div>
        <h1 class="text-2xl font-medium text-gray-900">Registrar Saída de Produto</h1>
        <p class="text-gray-600 text-sm mt-1">
          Preencha os dados abaixo para registrar uma saída do estoque
        </p>
      </div>
    </div>

    <%= link_to "javascript:history.back()", class: "bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2 transition shadow-sm" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="3" fill="none"
           class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
      </svg>
      Voltar
    <% end %>

  </div>
</div>

<div class="max-w-4xl mx-auto">
  <div class="bg-white shadow-lg rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-black border-b border-gray-200">
      <h2 class="text-xl font-bold text-white">Dados da Saída</h2>
    </div>

    <div class="p-6">
      <%= form_with(model: @product_output, local: true) do |form| %>
        <% if @product_output.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md mb-6">
            <div class="flex">
              <span class="text-red-500 text-xl">⚠️</span>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@product_output.errors.count, "erro") %> encontrado:
                </h3>
                <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                  <% @product_output.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Seção de Seleção de Produto -->
        <div class="mb-6" data-controller="dynamic-search" data-dynamic-search-search-url="<%= search_products_product_outputs_path %>" data-dynamic-search-item-type="product">
          <label for="product_output_product_id" class="block text-sm font-medium text-gray-700 mb-2">
            Produto <span class="text-red-600">*</span>
          </label>
          <div style="position: relative;">
            <input type="text" id="product_output_product_id" name="product_output[product_name]" placeholder="Digite para buscar..." class="block w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" required data-dynamic-search-target="input" autocomplete="off" />
            <div class="hidden absolute top-full left-0 right-0 mt-1 border border-gray-300 rounded-md shadow-lg bg-white z-10 max-h-64 overflow-y-auto" data-dynamic-search-target="results"></div>
          </div>
          <input type="hidden" id="product_output_product_id_hidden" name="product_output[product_id]" />
        </div>

        <div class="mb-6">
          <label for="product_output_quantity" class="block text-sm font-medium text-gray-700 mb-2">
            Quantidade <span class="text-red-600">*</span>
          </label>
          <%= form.number_field :quantity, min: 1, value: nil, class: "block w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent", placeholder: "0", required: true %>
        </div>

        <div class="mb-6">
          <label for="product_output_output_type" class="block text-sm font-medium text-gray-700 mb-2">
            Tipo de Saída <span class="text-red-600">*</span>
          </label>
          <select name="product_output[output_type]" id="product_output_output_type" class="block w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" required>
            <option value="">Selecione o tipo</option>
            <% ProductOutput.output_type_labels.each do |key, label| %>
              <option value="<%= key %>"><%= label %></option>
            <% end %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label for="product_output_date_output" class="block text-sm font-medium text-gray-700 mb-2">
              Data da Saída <span class="text-red-600">*</span>
            </label>
            <%= form.date_field :date_output, value: Date.today, class: "block w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent", required: true %>
          </div>

          <div>
            <label for="product_output_date_output_time" class="block text-sm font-medium text-gray-700 mb-2">
              Horário
            </label>
            <input type="time" id="product_output_date_output_time" name="product_output[date_output_time]" value="<%= Time.current.strftime('%H:%M') %>" class="block w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" />
          </div>
        </div>

        <div class="mb-6">
          <label for="product_output_notes" class="block text-sm font-medium text-gray-700 mb-2">
            Observações
          </label>
          <%= form.text_area :notes, rows: 4, class: "block w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent", placeholder: "Detalhes adicionais sobre a saída..." %>
        </div>

        <div class="flex justify-between items-center pt-2 mb-4">
          <div class="text-xs text-gray-500">* campos obrigatórios</div>
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t border-gray-200">
          <%= link_to "Cancelar", product_outputs_path, class: "px-6 py-3 rounded-lg bg-gray-200 border border-gray-300 hover:bg-white text-gray-700 font-medium transition" %>
          <%= form.submit "Registrar Saída", class: "px-6 py-3 bg-red-600 hover:bg-red-500 text-white rounded-lg font-medium shadow-lg transition cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>