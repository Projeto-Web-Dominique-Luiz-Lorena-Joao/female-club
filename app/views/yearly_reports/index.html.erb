<div class="mb-6">
  <div class="mb-4 flex justify-between items-center">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Relatório Anual</h2>
      <p class="text-gray-600 text-sm mt-0.5">Estatísticas do ano de <%= @current_year %></p>
    </div>

    <!-- Seletor de ano -->
    <%= form_with url: yearly_reports_path, method: :get, id: "year_selector_form", class: "flex items-center gap-3" do |f| %>
      <div class="flex items-center gap-2">
        <label for="year_select" class="text-sm font-medium text-gray-700">Ano:</label>
        <%= f.select :year,
            @available_years.reverse,
            { selected: @current_year },
            { id: "year_select", class: "px-2 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white text-gray-900 cursor-pointer", onchange: "this.form.submit()" }
        %>
      </div>
    <% end %>
  </div>

  <!-- KPI Cards Principais - 2 por linha -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
    <!-- Receitas Totais -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-blue-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-blue-100">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Receitas Totais</h3>
            <p class="text-2xl font-bold text-blue-600">
              R$ <%= number_to_currency(@total_revenue, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
            <% if @revenue_growth != 0 %>
              <p class="text-sm <%= @revenue_growth >= 0 ? 'text-green-600' : 'text-red-600' %> font-semibold mt-1">
                <%= @revenue_growth >= 0 ? '↑' : '↓' %> <%= @revenue_growth.abs %>% vs <%= @current_year - 1 %>
              </p>
            <% end %>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Soma total de todas as vendas do ano, excluindo vendas canceladas.</div>
        </div>
      </div>
    </div>

    <!-- Lucro Líquido -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 <%= @net_profit >= 0 ? 'border-green-500' : 'border-red-500' %> relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full <%= @net_profit >= 0 ? 'bg-green-100' : 'bg-red-100' %>">
            <svg class="w-6 h-6 <%= @net_profit >= 0 ? 'text-green-600' : 'text-red-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Lucro Líquido</h3>
            <p class="text-2xl font-bold <%= @net_profit >= 0 ? 'text-green-600' : 'text-red-600' %>">
              R$ <%= number_to_currency(@net_profit, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
            <p class="text-sm text-gray-500 mt-1">Margem: <%= @profit_margin %>%</p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Lucro real após descontar custos dos produtos e despesas do ano.</div>
        </div>
      </div>
    </div>

    <!-- Despesas Totais -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-orange-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-orange-100">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Despesas Totais</h3>
            <p class="text-2xl font-bold text-orange-600">
              R$ <%= number_to_currency(@total_expenses, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Soma de todas as despesas ativas registradas durante o ano.</div>
        </div>
      </div>
    </div>

    <!-- Recebido -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-green-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-green-100">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Recebido</h3>
            <p class="text-2xl font-bold text-green-600">
              R$ <%= number_to_currency(@received, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Total já recebido de vendas pagas durante o ano.</div>
        </div>
      </div>
    </div>

    <!-- Pendente -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-yellow-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-yellow-100">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Pendente</h3>
            <p class="text-2xl font-bold text-yellow-600">
              R$ <%= number_to_currency(@pending, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Vendas do ano que ainda não foram pagas.</div>
        </div>
      </div>
    </div>

    <!-- Ticket Médio -->
    <div class="bg-white rounded-lg shadow p-5 border-l-4 border-purple-500 relative">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3 flex-1">
          <div class="p-3 rounded-full bg-purple-100">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-gray-600 text-sm font-medium mb-1">Ticket Médio</h3>
            <p class="text-2xl font-bold text-purple-600">
              R$ <%= number_to_currency(@average_ticket, unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
            <p class="text-sm text-gray-500 mt-1"><%= @sales_count %> vendas</p>
          </div>
        </div>
        <div class="info-tooltip">
          <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center cursor-help text-gray-600 text-xs font-bold">i</div>
          <div class="tooltip-text">Valor médio por venda no ano (Receitas ÷ Número de vendas).</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Melhor e Pior Mês -->
  <% if @best_month && @worst_month %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
      <div class="bg-green-50 rounded-lg shadow p-4 border-l-4 border-green-500">
        <h3 class="text-sm font-semibold text-green-900 mb-2">🏆 Melhor Mês</h3>
        <p class="text-lg font-bold text-green-700"><%= @best_month[:name] %></p>
        <p class="text-sm text-green-600">R$ <%= number_to_currency(@best_month[:revenue], unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
      </div>

      <div class="bg-red-50 rounded-lg shadow p-4 border-l-4 border-red-500">
        <h3 class="text-sm font-semibold text-red-900 mb-2">📉 Pior Mês</h3>
        <p class="text-lg font-bold text-red-700"><%= @worst_month[:name] %></p>
        <p class="text-sm text-red-600">R$ <%= number_to_currency(@worst_month[:revenue], unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
      </div>
    </div>
  <% end %>

  <!-- Gráfico Mensal -->
  <div class="bg-white rounded-lg shadow p-4 mb-4">
    <h3 class="text-sm font-semibold text-gray-900 mb-2">Desempenho Mensal</h3>
    <div style="height: 300px; position: relative;">
      <canvas id="monthlyChart"></canvas>
    </div>
  </div>

  <!-- Performance Trimestral -->
  <div class="bg-white rounded-lg shadow p-4 mb-4">
    <h3 class="text-sm font-semibold text-gray-900 mb-3">Performance Trimestral</h3>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
      <% @quarterly_data.each do |quarter| %>
        <%
          quarter_labels = {
            1 => "Jan/Fev/Mar",
            2 => "Abr/Mai/Jun",
            3 => "Jul/Ago/Set",
            4 => "Out/Nov/Dez"
          }
        %>
        <div class="p-3 bg-gray-50 rounded-lg">
          <p class="text-xs text-gray-600 mb-1"><%= quarter_labels[quarter[:quarter]] %></p>
          <p class="text-lg font-bold text-blue-600">
            R$ <%= number_to_currency(quarter[:revenue], unit: '', delimiter: '.', separator: ',', precision: 2) %>
          </p>
          <p class="text-xs text-gray-500 mt-1">
            Lucro: R$ <%= number_to_currency(quarter[:profit], unit: '', delimiter: '.', separator: ',', precision: 2) %>
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Top Produtos e Serviços -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
    <!-- Top 10 Produtos -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Top 10 Produtos do Ano</h3>
      <% if @top_products.any? %>
        <div class="space-y-2 max-h-96 overflow-y-auto">
          <% @top_products.each_with_index do |(name, data), index| %>
            <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-gray-500"><%= index + 1 %>.</span>
                <span class="text-sm font-medium text-gray-700"><%= name %></span>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-blue-600">R$ <%= number_to_currency(data[:revenue], unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
                <p class="text-xs text-gray-500"><%= data[:quantity] %> un.</p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 text-center py-4">Nenhum produto vendido</p>
      <% end %>
    </div>

    <!-- Top 10 Serviços -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Top 10 Serviços do Ano</h3>
      <% if @top_services.any? %>
        <div class="space-y-2 max-h-96 overflow-y-auto">
          <% @top_services.each_with_index do |(name, data), index| %>
            <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-gray-500"><%= index + 1 %>.</span>
                <span class="text-sm font-medium text-gray-700"><%= name %></span>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-purple-600">R$ <%= number_to_currency(data[:revenue], unit: '', delimiter: '.', separator: ',', precision: 2) %></p>
                <p class="text-xs text-gray-500"><%= data[:quantity] %> serv.</p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 text-center py-4">Nenhum serviço vendido</p>
      <% end %>
    </div>
  </div>

  <!-- Top 5 Clientes -->
  <div class="bg-white rounded-lg shadow p-4">
    <h3 class="text-sm font-semibold text-gray-900 mb-3">Top 5 Clientes do Ano</h3>
    <% if @top_customers.any? %>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
        <% @top_customers.each_with_index do |(name, data), index| %>
          <div class="p-3 bg-gray-50 rounded-lg">
            <p class="text-xs text-gray-600 mb-1">#<%= index + 1 %> <%= name %></p>
            <p class="text-lg font-bold text-green-600">
              R$ <%= number_to_currency(data[:revenue], unit: '', delimiter: '.', separator: ',', precision: 2) %>
            </p>
            <p class="text-xs text-gray-500 mt-1"><%= data[:sales_count] %> compras</p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 text-center py-4">Sem dados de clientes</p>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    // Gráfico Mensal
    const monthlyCtx = document.getElementById('monthlyChart');
    if (monthlyCtx) {
      new Chart(monthlyCtx.getContext('2d'), {
        type: 'line',
        data: {
          labels: <%= raw @chart_labels.to_json %>,
          datasets: [
            {
              label: 'Receitas',
              data: <%= raw @chart_revenue_data.to_json %>,
              borderColor: 'rgb(34, 197, 94)',
              backgroundColor: 'rgba(34, 197, 94, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 2
            },
            {
              label: 'Despesas',
              data: <%= raw @chart_expenses_data.to_json %>,
              borderColor: 'rgb(249, 115, 22)',
              backgroundColor: 'rgba(249, 115, 22, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 2
            },
            {
              label: 'Lucro',
              data: <%= raw @chart_profit_data.to_json %>,
              borderColor: 'rgb(59, 130, 246)',
              backgroundColor: 'rgba(59, 130, 246, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 2
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                boxWidth: 12,
                padding: 10,
                font: {
                  size: 11
                }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              callbacks: {
                label: function(context) {
                  let label = context.dataset.label || '';
                  if (label) {
                    label += ': ';
                  }
                  label += 'R$ ' + context.parsed.y.toFixed(2);
                  return label;
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(0, 0, 0, 0.08)'
              },
              ticks: {
                font: {
                  size: 10
                },
                callback: function(value) {
                  return 'R$ ' + value.toFixed(0);
                }
              }
            },
            x: {
              grid: {
                color: 'rgba(0, 0, 0, 0.08)'
              },
              ticks: {
                font: {
                  size: 10
                }
              }
            }
          }
        }
      });
    }
  });
</script>
