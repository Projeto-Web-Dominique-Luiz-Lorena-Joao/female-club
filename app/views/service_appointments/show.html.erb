<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header com Nome e Botões de Ação -->
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Detalhes do Agendamento</h1>
    </div>
    <div class="flex space-x-3">
      <%= link_to "Editar", edit_service_appointment_path(@service_appointment), class: "bg-black hover:bg-gray-700 text-white px-8 py-2 rounded-lg font-medium" %>
      <%= link_to "javascript:history.back()", class: "bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2 transition shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="3" fill="none"
           class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
        </svg>
        Voltar
      <% end %>
    </div>
  </div>

  <!-- Cards de Informações -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Serviço -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        
        <!-- Ícone -->
        <div class="flex-shrink-0 bg-blue-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" 
              d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
          </svg>

        </div>

        <!-- Texto -->
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Serviço</p>

          <% if @service_appointment.service %>
            <p class="text-2xl font-bold text-blue-600 mt-1">
              <%= link_to @service_appointment.service.name, service_path(@service_appointment.service), class: "hover:underline" %>
            </p>
          <% else %>
            <p class="text-gray-400 mt-1">-</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Status -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">

        <!-- Ícone -->
        <div class="flex-shrink-0 bg-gray-100 rounded-lg p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 9v4l3 3m6-4a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>

        <!-- Texto -->
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Status</p>

          <div class="mt-1">
            <% case @service_appointment.status %>
            <% when 'agendado' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                Agendado
              </span>
            <% when 'concluido' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                Concluído
              </span>
            <% when 'cancelado' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                Cancelado
              </span>
            <% when 'nao_compareceu' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                Não Compareceu
              </span>
            <% end %>
          </div>
        </div>

      </div>
    </div>

  </div>


  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-black">
      <h2 class="text-xl font-bold text-white">Informações do Agendamento</h2>
    </div>
    <div class="p-6 space-y-4">

      <div class="pb-4">
        <p class="text-sm font-medium text-gray-500">Data e Hora</p>
        <% if @service_appointment.appointment_date %>
          <p class="text-lg text-gray-900 mt-1">
            <%= l(@service_appointment.appointment_date, format: :long) %>
          </p>
        <% else %>
          <p class="text-gray-400 mt-1">-</p>
        <% end %>
      </div>

      <!-- Cliente -->
      <div class="pb-4">
        <p class="text-sm font-medium text-gray-500">Cliente</p>
        <% if @service_appointment.customer %>
          <p class="text-lg text-gray-900 mt-1">
            <%= link_to @service_appointment.customer.full_name, customer_path(@service_appointment.customer), class: "text-blue-600 hover:text-blue-800" %>
          </p>
        <% else %>
          <p class="text-gray-400 mt-1">-</p>
        <% end %>
      </div>

      <!-- Funcionário -->
      <div class="pb-4">
        <p class="text-sm font-medium text-gray-500">Funcionário</p>
        <% if @service_appointment.employee %>
          <p class="text-lg text-gray-900 mt-1">
            <%= link_to @service_appointment.employee.full_name, employee_path(@service_appointment.employee), class: "text-blue-600 hover:text-blue-800" %>
          </p>
        <% else %>
          <p class="text-gray-400 mt-1">-</p>
        <% end %>
      </div>

      <!-- Preço do Serviço -->
      <div>
        <p class="text-sm font-medium text-gray-500">Preço do Serviço</p>
        <% if @service_appointment.service %>
          <p class="text-lg text-green-600 font-bold mt-1">
            <%= @service_appointment.service.formatted_price %>
          </p>
        <% else %>
          <p class="text-gray-400 mt-1">-</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Data de Criação/Atualização -->
  <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600 space-y-1 border border-gray-200">
    <p>Criado em: <%= l(@service_appointment.created_at, format: :short) %></p>
    <p>Última atualização: <%= l(@service_appointment.updated_at, format: :short) %></p>
  </div>

  <!-- Botão de Deletar -->
  <div class="flex justify-end">
    <button onclick="openDeleteModal('/service_appointments', <%= @service_appointment.id %>, '<%= @service_appointment.service&.name %>', 'agendamento')" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg font-medium">
      Deletar Agendamento
    </button>
  </div>
</div>
