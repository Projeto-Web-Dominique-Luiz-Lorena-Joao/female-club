<div class="max-w-screen mx-auto space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Agendamentos de Serviço</h1>
      <p class="text-gray-600 mt-1">Gerencie os agendamentos de serviços das clientes</p>
    </div>
    <div>
      <%= link_to "Novo Agendamento", new_service_appointment_path, class: "bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition duration-200 inline-flex items-center" %>
    </div>
  </div>

  <!-- Estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    
    <!-- Card Total de Agendamentos -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-blue-100 rounded-lg p-3">
          <!-- Heroicon: calendar-days -->
          <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Total de Agendamentos</p>
          <p class="text-2xl font-bold text-blue-600 mt-1"><%= ServiceAppointment.count %></p>
        </div>
      </div>
    </div>

    <!-- Card Agendamentos do Dia -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
          <!-- Heroicon: clock -->
          <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Agendamentos Hoje</p>
          <p class="text-2xl font-bold text-green-600 mt-1"><%= ServiceAppointment.where("DATE(appointment_date) = ?", Date.today).count %></p>
        </div>
      </div>
    </div>

    <!-- Card Agendamentos Pendentes -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-yellow-100 rounded-lg p-3">
          <!-- Heroicon: exclamation-circle -->
          <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Agendados</p>
          <p class="text-2xl font-bold text-yellow-600 mt-1"><%= ServiceAppointment.where(status: 'agendado').count %></p>
        </div>
      </div>
    </div>

    <!-- Card Agendamentos Concluídos -->
    <div class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="flex items-start">
        <div class="flex-shrink-0 bg-purple-100 rounded-lg p-3">
          <!-- Heroicon: check-badge -->
          <svg class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-xs text-gray-500 font-medium">Concluídos</p>
          <p class="text-2xl font-bold text-purple-600 mt-1"><%= ServiceAppointment.where(status: 'concluido').count %></p>
        </div>
      </div>
    </div>

  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: service_appointments_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <!-- Campo de Busca Unificado -->
        <div>
          <%= text_field_tag :search, params[:search],
              placeholder: "Buscar por serviço, cliente ou funcionário...",
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <!-- Filtro Data -->
        <div>
          <%= f.date_field :date, value: params[:date], 
              placeholder: "Data",
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <!-- Filtro Status -->
        <div>
          <%= f.select :status,
              [
                ["Todos os Status", ""],
                ["Agendado", "agendado"],
                ["Concluído", "concluido"],
                ["Cancelado", "cancelado"],
                ["Não Compareceu", "nao_compareceu"]
              ],
              { selected: params[:status] },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>

      <div class="flex gap-2">
        <%= f.submit "Buscar", class: "bg-black hover:bg-gray-700 text-white px-6 py-2 rounded-lg font-medium transition duration-200" %>
        <%= link_to "Limpar", service_appointments_path, class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition duration-200" %>
      </div>
    <% end %>
  </div>

  <!-- Paginação Topo -->
  <% if @service_appointments.any? %>
    <%= render "shared/pagination_top", collection: @service_appointments %>
  <% end %>

  <!-- Tabela de Agendamentos -->
  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-black">
          <tr>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Data/Hora</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Duração</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Serviço</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Cliente</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Funcionário</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Status</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">

          <% if @service_appointments.any? %>
            <% @service_appointments.each do |appointment| %>

              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-900 text-center">
                  <% if appointment.appointment_date %>
                    <div><%= l(appointment.appointment_date, format: :short) %></div>
                    <div class="text-gray-500 text-xs">
                      <%= appointment.appointment_date.strftime('%H:%M') %>
                      <% if appointment.end_time %>
                        - <%= appointment.end_time.strftime('%H:%M') %>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 text-center">
                  <%= appointment.formatted_duration %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 text-center">
                  <% if appointment.service %>
                    <%= link_to appointment.service.name, service_path(appointment.service), class: "text-gray-900" %>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 text-center">
                  <% if appointment.customer %>
                    <%= link_to appointment.customer.full_name, customer_path(appointment.customer), class: "text-blue-600 hover:text-blue-800" %>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 text-center">
                  <% if appointment.employee %>
                    <%= link_to appointment.employee.full_name, employee_path(appointment.employee), class: "text-blue-600 hover:text-blue-800" %>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-center">
                  <% case appointment.status %>
                  <% when 'agendado' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                        Agendado
                    </span>
                  <% when 'concluido' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                      Concluído
                    </span>
                  <% when 'cancelado' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                     Cancelado
                    </span>
                  <% when 'nao_compareceu' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                      Não Compareceu
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-center">
                  <div class="flex flex-col items-center space-y-2 w-full">
                  <%= link_to "Visualizar", service_appointment_path(appointment), class: "bg-blue-200 text-blue-700 px-5 py-2 rounded-lg hover:bg-blue-100 text-center text-sm font-medium" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-6 py-4 text-center text-gray-500">
                Nenhum agendamento encontrado
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= render "shared/pagination_top", collection: @service_appointments %>

</div>