<div class="max-w-7xl mx-auto space-y-6">
  <!-- Header com Título e Botão de Novo -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Agendamentos de Serviço</h1>
      <p class="text-gray-600 mt-1">Gerencie os agendamentos de serviços das clientes</p>
    </div>
    <div>
      <%= link_to "Novo Agendamento", new_service_appointment_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium" %>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-4">
    <%= form_with url: service_appointments_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Filtro Serviço com Autocomplete -->
        <div data-controller="filter-autocomplete"
             data-filter-autocomplete-search-url-value="/service_appointments/search_services"
             id="filter_service_autocomplete">
          <%= f.label :service_id, "Serviço", class: "block text-sm font-medium text-gray-700" %>
          <div class="relative mt-1">
            <input type="text"
                   placeholder="Buscar serviço..."
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                   autocomplete="off"
                   data-filter-autocomplete-target="searchInput"
                   data-action="input->filter-autocomplete#search focus->filter-autocomplete#focus">
            <div class="absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg hidden max-h-48 overflow-y-auto"
                 data-filter-autocomplete-target="results"></div>
          </div>
          <%= f.hidden_field :service_id, value: params[:service_id], data: { "filter-autocomplete-target": "hiddenInput" } %>
        </div>

        <!-- Filtro Funcionário com Autocomplete -->
        <div data-controller="filter-autocomplete"
             data-filter-autocomplete-search-url-value="/service_appointments/search_employees"
             id="filter_employee_autocomplete">
          <%= f.label :employee_id, "Funcionário", class: "block text-sm font-medium text-gray-700" %>
          <div class="relative mt-1">
            <input type="text"
                   placeholder="Buscar funcionário..."
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                   autocomplete="off"
                   data-filter-autocomplete-target="searchInput"
                   data-action="input->filter-autocomplete#search focus->filter-autocomplete#focus">
            <div class="absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg hidden max-h-48 overflow-y-auto"
                 data-filter-autocomplete-target="results"></div>
          </div>
          <%= f.hidden_field :employee_id, value: params[:employee_id], data: { "filter-autocomplete-target": "hiddenInput" } %>
        </div>

        <!-- Filtro Cliente com Autocomplete -->
        <div data-controller="filter-autocomplete"
             data-filter-autocomplete-search-url-value="/service_appointments/search_customers"
             id="filter_customer_autocomplete">
          <%= f.label :customer_id, "Cliente", class: "block text-sm font-medium text-gray-700" %>
          <div class="relative mt-1">
            <input type="text"
                   placeholder="Buscar cliente..."
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                   autocomplete="off"
                   data-filter-autocomplete-target="searchInput"
                   data-action="input->filter-autocomplete#search focus->filter-autocomplete#focus">
            <div class="absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg hidden max-h-48 overflow-y-auto"
                 data-filter-autocomplete-target="results"></div>
          </div>
          <%= f.hidden_field :customer_id, value: params[:customer_id], data: { "filter-autocomplete-target": "hiddenInput" } %>
        </div>

        <!-- Filtro Data -->
        <div>
          <%= f.label :date, "Data", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :date, value: params[:date], class: "w-full mt-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>

      <div class="flex gap-2">
        <%= f.submit "Filtrar", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium" %>
        <%= link_to "Limpar Filtros", service_appointments_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-lg font-medium" %>
      </div>
    <% end %>
  </div>

  <!-- Tabela de Agendamentos -->
  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Data/Hora</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Serviço</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Funcionário</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @service_appointments.any? %>
            <% @service_appointments.each do |appointment| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-900">
                  <% if appointment.appointment_date %>
                    <div><%= l(appointment.appointment_date, format: :short) %></div>
                    <div class="text-gray-500 text-xs"><%= appointment.appointment_date.strftime('%H:%M') %></div>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <% if appointment.service %>
                    <%= link_to appointment.service.name, service_path(appointment.service), class: "text-blue-600 hover:text-blue-800" %>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <% if appointment.customer %>
                    <%= link_to appointment.customer.full_name, customer_path(appointment.customer), class: "text-blue-600 hover:text-blue-800" %>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <% if appointment.employee %>
                    <%= link_to appointment.employee.full_name, employee_path(appointment.employee), class: "text-blue-600 hover:text-blue-800" %>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-center">
                  <% case appointment.status %>
                  <% when 'agendado' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                      📅 Agendado
                    </span>
                  <% when 'concluido' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                      ✓ Concluído
                    </span>
                  <% when 'cancelado' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                      ✕ Cancelado
                    </span>
                  <% when 'nao_compareceu' %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                      ⚠ Não Compareceu
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-center space-x-2">
                  <%= link_to "Ver", service_appointment_path(appointment), class: "text-blue-600 hover:text-blue-800 text-sm" %>
                  <%= link_to "Editar", edit_service_appointment_path(appointment), class: "text-orange-600 hover:text-orange-800 text-sm" %>
                  <%= link_to "Excluir", service_appointment_path(appointment), method: :delete, data: { confirm: "Tem certeza?" }, class: "text-red-600 hover:text-red-800 text-sm" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-4 text-center text-gray-500">
                Nenhum agendamento encontrado
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Paginação -->
  <% if @service_appointments.respond_to?(:total_pages) %>
    <div class="flex justify-center">
      <%= paginate @service_appointments %>
    </div>
  <% end %>
</div>
