<%= form_with(model: service_appointment, local: true, class: "space-y-6") do |form| %>
  <% if service_appointment.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h2 class="text-lg font-medium text-red-800">
        <%= pluralize(service_appointment.errors.count, "erro") %> ao salvar agendamento:
      </h2>
      <ul class="mt-3 list-disc list-inside space-y-1 text-red-700">
        <% service_appointment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Serviço com Autocomplete -->
  <div data-controller="sales-autocomplete"
       data-sales-autocomplete-search-url-value="/service_appointments/search_services"
       data-sales-autocomplete-allow-create-value="false"
       id="service_autocomplete">
    <div>
      <%= form.label :service_id, "Serviço *", class: "block text-sm font-medium text-gray-700" %>
      <div class="relative mt-1">
        <input type="text"
               placeholder="Digite o nome do serviço..."
               value="<%= service_appointment.service&.name %>"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
               autocomplete="off"
               data-sales-autocomplete-target="searchInput"
               data-action="input->sales-autocomplete#search focus->sales-autocomplete#focus click->sales-autocomplete#focus">
        <div class="absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg hidden max-h-48 overflow-y-auto"
             data-sales-autocomplete-target="results"></div>
      </div>
      <%= form.hidden_field :service_id, id: "service_appointment_service_id", data: { "sales-autocomplete-target": "hiddenInput" } %>
      <small class="text-gray-500 text-xs mt-1 block">Selecionado: <span class="font-medium" data-sales-autocomplete-target="selectedDisplay"><%= service_appointment.service&.name || 'Nenhum' %></span></small>
    </div>
    <% if service_appointment.errors[:service_id].any? %>
      <p class="mt-1 text-sm text-red-600"><%= service_appointment.errors[:service_id].join(", ") %></p>
    <% end %>
  </div>

  <!-- Funcionário com Autocomplete -->
  <div data-controller="sales-autocomplete"
       data-sales-autocomplete-search-url-value="/service_appointments/search_employees"
       data-sales-autocomplete-allow-create-value="false"
       id="employee_autocomplete">
    <div>
      <%= form.label :employee_id, "Funcionário *", class: "block text-sm font-medium text-gray-700" %>
      <div class="relative mt-1">
        <input type="text"
               placeholder="Digite o nome do funcionário..."
               value="<%= service_appointment.employee&.full_name %>"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
               autocomplete="off"
               data-sales-autocomplete-target="searchInput"
               data-action="input->sales-autocomplete#search focus->sales-autocomplete#focus click->sales-autocomplete#focus">
        <div class="absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg hidden max-h-48 overflow-y-auto"
             data-sales-autocomplete-target="results"></div>
      </div>
      <%= form.hidden_field :employee_id, id: "service_appointment_employee_id", data: { "sales-autocomplete-target": "hiddenInput" } %>
      <small class="text-gray-500 text-xs mt-1 block">Selecionado: <span class="font-medium" data-sales-autocomplete-target="selectedDisplay"><%= service_appointment.employee&.full_name || 'Nenhum' %></span></small>
    </div>
    <% if service_appointment.errors[:employee_id].any? %>
      <p class="mt-1 text-sm text-red-600"><%= service_appointment.errors[:employee_id].join(", ") %></p>
    <% end %>
  </div>

  <!-- Cliente com Autocomplete e Modal -->
  <div data-controller="sales-autocomplete"
       data-sales-autocomplete-search-url-value="/service_appointments/search_customers"
       data-sales-autocomplete-allow-create-value="true"
       id="customer_autocomplete">
    <div>
      <%= form.label :customer_id, "Cliente *", class: "block text-sm font-medium text-gray-700" %>
      <div class="relative mt-1">
        <input type="text"
               placeholder="Digite o nome da cliente..."
               value="<%= service_appointment.customer&.full_name %>"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
               autocomplete="off"
               data-sales-autocomplete-target="searchInput"
               data-action="input->sales-autocomplete#search focus->sales-autocomplete#focus click->sales-autocomplete#focus">
        <div class="absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg hidden max-h-48 overflow-y-auto"
             data-sales-autocomplete-target="results"></div>
      </div>
      <%= form.hidden_field :customer_id, id: "service_appointment_customer_id", data: { "sales-autocomplete-target": "hiddenInput" } %>
      <small class="text-gray-500 text-xs mt-1 block">Selecionado: <span class="font-medium" data-sales-autocomplete-target="selectedDisplay"><%= service_appointment.customer&.full_name || 'Nenhum' %></span></small>
    </div>
    <% if service_appointment.errors[:customer_id].any? %>
      <p class="mt-1 text-sm text-red-600"><%= service_appointment.errors[:customer_id].join(", ") %></p>
    <% end %>
  </div>

  <!-- Data e Hora do Agendamento -->
  <div>
    <%= form.label :appointment_date, "Data e Hora *", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <% min_datetime = Time.current.strftime('%Y-%m-%dT%H:%M') %>
      <%= form.datetime_local_field :appointment_date,
          min: min_datetime,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    <p class="mt-1 text-xs text-gray-500">Selecione uma data e hora futura (08:00 - 23:59)</p>
    <% if service_appointment.errors[:appointment_date].any? %>
      <p class="mt-1 text-sm text-red-600"><%= service_appointment.errors[:appointment_date].join(", ") %></p>
    <% end %>
  </div>

  <!-- Status -->
  <div>
    <%= form.label :status, "Status *", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.select :status,
          [
            ["📅 Agendado", "agendado"],
            ["✓ Concluído", "concluido"],
            ["✕ Cancelado", "cancelado"],
            ["⚠ Não Compareceu", "nao_compareceu"]
          ],
          { prompt: "Selecione um status" },
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    <% if service_appointment.errors[:status].any? %>
      <p class="mt-1 text-sm text-red-600"><%= service_appointment.errors[:status].join(", ") %></p>
    <% end %>
  </div>

  <!-- Botões de Ação -->
  <div class="flex justify-between items-center pt-4 border-gray-200">
    <div class="text-xs text-gray-500">* campos obrigatórios</div>
    <div class="flex gap-3">
      <%= link_to "Cancelar", service_appointments_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 px-6 py-2 rounded-lg font-medium" %>
      <%= form.submit class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium cursor-pointer" %>
    </div>
  </div>
<% end %>
