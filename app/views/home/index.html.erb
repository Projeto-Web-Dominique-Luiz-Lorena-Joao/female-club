<div class="min-h-screen bg-gradient-to-br from-gray-100 to-purple-100">
  <nav class="bg-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <h1 class="text-2xl font-bold text-black-600">FEMALE CLUB</h1>
        </div>

        <div class="flex items-center space-x-4">
          <% if user_signed_in? %>
            <%= link_to "Employee", employees_path, class: "text-gray-700 hover:text-red-600 px-3 py-2" %>
            <%= link_to "Dashboard", dashboard_path, class: "text-gray-700 hover:text-red-600 px-3 py-2" %>
            <span class="text-gray-700">Olá, <%= current_user.email %></span>
            <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "bg-red-600 hover:bg-pink-700 text-white px-4 py-2 rounded-lg" %>
          <% else %>
            <%= link_to "Entrar", new_user_session_path, class: "text-gray-700 hover:text-pink-600 px-3 py-2" %>
            <%= link_to "Cadastrar", new_user_registration_path, class: "bg-pink-600 hover:bg-pink-700 text-white px-4 py-2 rounded-lg" %>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

</div>
