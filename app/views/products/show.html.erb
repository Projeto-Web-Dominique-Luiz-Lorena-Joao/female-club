<div class="max-w-6xl mx-auto space-y-6">

  <!-- Header com Nome, Código e Botões -->
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @product.name %></h1>
    </div>
    <div class="flex space-x-3">
      <%= link_to edit_product_path(@product), class: "bg-black hover:bg-gray-700 text-white px-8 py-2 rounded-lg font-medium" do %>
        Editar
      <% end %>
      <%= link_to products_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-md font-medium" do %>
        ← Voltar
      <% end %>
    </div>
  </div>

  <!-- Layout Principal: Imagem à Esquerda e Cards à Direita -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Coluna Esquerda: Imagem e Status -->
    <div class="lg:col-span-1 space-y-4">
      
      <!-- Card de Imagem -->
      <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
        <div class="aspect-square bg-gray-50 flex items-center justify-center p-6">
          <% if @product.cover_image.attached? %>
            <%= image_tag url_for(@product.cover_image), class: "max-w-full max-h-full object-contain", loading: "lazy" %>
          <% else %>
            <div class="text-gray-400 text-center">
              <svg class="mx-auto h-24 w-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <p class="mt-2 text-sm">Sem imagem</p>
            </div>
          <% end %>
        </div>
        
        <!-- Status e Estoque dentro do card da imagem -->
        <div class="p-4 border-t border-gray-200 space-y-3">
          <div class="flex items-center justify-center space-x-2">
            <span class="text-sm text-gray-500">Status:</span>
            <% if @product.active? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                Disponível
              </span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                Indisponível
              </span>
            <% end %>
          </div>
          <div class="text-center pt-2 border-t border-gray-100">
            <p class="text-xs text-gray-500">Estoque: <%= @product.quantity || 0 %></p>
          </div>
        </div>
      </div>

    </div>

    <!-- Coluna Direita: Cards de Informações -->
    <div class="lg:col-span-2 space-y-4">
      
      <!-- Cards de Métricas (3 colunas) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <!-- Card Preço de Venda -->
        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-start">
            <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
              <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="ml-3 flex-1">
              <p class="text-xs text-gray-500 font-medium">Preço de Venda</p>
              <p class="text-xl font-bold text-green-600 mt-1">
                <% if @product.sale_price.present? %>
                  R$ <%= number_with_precision(@product.sale_price, precision: 2, delimiter: ".", separator: ",") %>
                <% else %>
                  -
                <% end %>
              </p>
            </div>
          </div>
        </div>

        <!-- Card Estoque Atual -->
        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-start">
            <div class="flex-shrink-0 <%= @product.stock_status == 'fora_de_estoque' ? 'bg-red-100' : @product.stock_status == 'critico' ? 'bg-orange-100' : @product.stock_status == 'baixo' ? 'bg-yellow-100' : 'bg-blue-100' %> rounded-lg p-3">
              <svg class="h-6 w-6 <%= @product.stock_status == 'fora_de_estoque' ? 'text-red-600' : @product.stock_status == 'critico' ? 'text-orange-600' : @product.stock_status == 'baixo' ? 'text-yellow-600' : 'text-blue-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <div class="ml-3 flex-1">
              <p class="text-xs text-gray-500 font-medium">Estoque Atual</p>
              <p class="text-xl font-bold <%= @product.stock_status == 'fora_de_estoque' ? 'text-red-600' : @product.stock_status == 'critico' ? 'text-orange-600' : @product.stock_status == 'baixo' ? 'text-yellow-600' : 'text-blue-600' %> mt-1">
                <%= @product.quantity || 0 %>
              </p>
              <% if @product.stock_status == "fora_de_estoque" %>
                <p class="text-xs text-red-600 mt-1">❌ Fora de estoque</p>
              <% elsif @product.stock_status == "critico" %>
                <p class="text-xs text-orange-600 mt-1">⚠️ Estoque crítico</p>
              <% elsif @product.stock_status == "baixo" %>
                <p class="text-xs text-yellow-600 mt-1">⚠️ Estoque baixo</p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Card Margem de Lucro -->
        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-start">
            <div class="flex-shrink-0 bg-purple-100 rounded-lg p-3">
              <svg class="h-6 w-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
            </div>
            <div class="ml-3 flex-1">
              <p class="text-xs text-gray-500 font-medium">Margem de Lucro</p>
              <p class="text-xl font-bold <%= @product.profit_margin >= 0 ? 'text-purple-600' : 'text-red-600' %> mt-1">
                <% if @product.purchase_price.present? && @product.purchase_price > 0 %>
                  <%= @product.profit_margin %>%
                <% else %>
                  -
                <% end %>
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- Card de Informações do Produto -->
      <div class="bg-white rounded-lg border border-gray-200">
        <div class="px-5 py-3 bg-black text-white rounded-t-lg">
          <h2 class="text-base font-semibold">Informações do Produto</h2>
        </div>
        <div class="p-4">
          <div class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
            
            <!-- Marca -->
            <div class="flex items-start">
              <svg class="h-4 w-4 text-gray-400 mr-1.5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
              </svg>
              <div class="flex-1">
                <span class="text-gray-500">Marca</span>
                <p class="font-medium text-gray-900"><%= @product.brand.present? ? @product.brand : '-' %></p>
              </div>
            </div>

            <!-- Unidade de Medida -->
            <div class="flex items-start">
              <svg class="h-4 w-4 text-gray-400 mr-1.5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
              </svg>
              <div class="flex-1">
                <span class="text-gray-500">Unidade de Medida</span>
                <p class="font-medium text-gray-900"><%= @product.unit.present? ? @product.unit.titleize : '-' %></p>
              </div>
            </div>

            <!-- Cor -->
            <div class="flex items-start">
              <svg class="h-4 w-4 text-gray-400 mr-1.5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
              </svg>
              <div class="flex-1">
                <span class="text-gray-500">Cor</span>
                <p class="font-medium text-gray-900"><%= @product.color.present? ? @product.color : '-' %></p>
              </div>
            </div>

            <!-- Localização -->
            <div class="flex items-start">
              <svg class="h-4 w-4 text-gray-400 mr-1.5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <div class="flex-1">
                <span class="text-gray-500">Localização no Estoque</span>
                <p class="font-medium text-gray-900"><%= @product.location.present? ? @product.location : '-' %></p>
              </div>
            </div>

            <!-- Categoria -->
            <div class="flex items-start">
              <svg class="h-4 w-4 text-gray-400 mr-1.5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
              <div class="flex-1">
                <span class="text-gray-500">Categoria</span>
                <p>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    <%= @product.category %>
                  </span>
                </p>
              </div>
            </div>

            <!-- Fornecedor -->
            <% if @product.supplier.present? %>
              <div class="flex items-start">
                <svg class="h-4 w-4 text-gray-400 mr-1.5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                <div class="flex-1">
                  <span class="text-gray-500">Fornecedor</span>
                  <p>
                    <%= link_to @product.supplier.display_name, supplier_path(@product.supplier), class: "text-blue-600 hover:text-blue-800 font-medium" %>
                  </p>
                </div>
              </div>
            <% end %>

          </div>

          <% if @product.description.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <p class="text-xs text-gray-500 mb-1">Descrição</p>
              <p class="text-sm text-gray-900"><%= @product.description %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Card de Preços e Estoque -->
      <div class="bg-white rounded-lg border border-gray-200">
        <div class="px-5 py-3 bg-black text-white rounded-t-lg">
          <h2 class="text-base font-semibold">Preços e Estoque</h2>
        </div>
        <div class="p-4">
          <div class="grid grid-cols-3 gap-4 text-sm">
            
            <div>
              <p class="text-xs text-gray-500 mb-1">Preço de Custo</p>
              <p class="text-base font-semibold text-gray-900">
                <% if @product.purchase_price.present? %>
                  R$ <%= number_with_precision(@product.purchase_price, precision: 2, delimiter: ".", separator: ",") %>
                <% else %>
                  -
                <% end %>
              </p>
            </div>

            <div>
              <p class="text-xs text-gray-500 mb-1">Preço de Venda</p>
              <p class="text-base font-semibold text-green-600">
                <% if @product.sale_price.present? %>
                  R$ <%= number_with_precision(@product.sale_price, precision: 2, delimiter: ".", separator: ",") %>
                <% else %>
                  -
                <% end %>
              </p>
            </div>

            <div>
              <p class="text-xs text-gray-500 mb-1">Preço Padrão</p>
              <p class="text-base font-semibold text-gray-900">
                <% if @product.price.present? %>
                  R$ <%= number_with_precision(@product.price, precision: 2, delimiter: ".", separator: ",") %>
                <% else %>
                  -
                <% end %>
              </p>
            </div>

            <div>
              <p class="text-xs text-gray-500 mb-1">Valor Total em Estoque</p>
              <p class="text-base font-semibold text-blue-600">
                R$ <%= number_with_precision(@product.stock_value, precision: 2, delimiter: ".", separator: ",") %>
              </p>
            </div>

            <div>
              <p class="text-xs text-gray-500 mb-1">Quantidade em Estoque</p>
              <p class="text-base font-semibold <%= @product.stock_status == 'fora_de_estoque' ? 'text-red-600' : @product.stock_status == 'critico' ? 'text-orange-600' : @product.stock_status == 'baixo' ? 'text-yellow-600' : 'text-blue-600' %>">
                <%= @product.quantity || 0 %>
              </p>
            </div>

            <div>
              <p class="text-xs text-gray-500 mb-1">Estoque Mínimo</p>
              <p class="text-base font-semibold text-gray-900">
                <%= @product.min_stock || '-' %>
              </p>
            </div>

          </div>

          <% if @product.profit_margin != 0 && @product.purchase_price.present? && @product.purchase_price > 0 %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <p class="text-xs text-gray-500 mb-1">Margem de Lucro</p>
                  <p class="text-xl font-bold <%= @product.profit_margin >= 0 ? 'text-green-600' : 'text-red-600' %>">
                    <%= @product.profit_margin %>%
                  </p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 mb-1">Lucro por Unidade</p>
                  <p class="text-xl font-bold text-green-600">
                    R$ <%= number_with_precision(@product.sale_price - @product.purchase_price, precision: 2, delimiter: ".", separator: ",") %>
                  </p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Observações -->
      <% if @product.notes.present? %>
        <div class="bg-white rounded-lg border border-gray-200">
          <div class="px-5 py-3 bg-black text-white rounded-t-lg">
            <h2 class="text-base font-semibold">Observações Internas</h2>
          </div>
          <div class="p-4">
            <p class="text-sm text-gray-900"><%= @product.notes %></p>
          </div>
        </div>
      <% end %>

    </div>

  </div>

  <!-- Data de Criação/Atualização -->
  <div class="bg-gray-50 rounded-lg border border-gray-200 p-4 text-xs text-gray-500">
    <p>Criado em: <%= l(@product.created_at, format: :short) %></p>
    <p>Última atualização: <%= l(@product.updated_at, format: :short) %></p>
  </div>

</div>