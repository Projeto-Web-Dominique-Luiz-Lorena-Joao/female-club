<div class="max-w-6xl mx-auto space-y-6">

  <!-- Header com Nome e Botões de Ação -->
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @product.name %></h1>
      <% if @product.code.present? %>
        <p class="mt-2 text-sm text-gray-600">Código: <span class="font-mono font-semibold"><%= @product.code %></span></p>
      <% end %>
    </div>
    <div class="flex space-x-3">
      <%= link_to edit_product_path(@product), class: "bg-orange-200 hover:bg-orange-100 text-orange-700 px-8 py-2 rounded-lg font-medium" do %>
        Editar
      <% end %>
      <%= link_to products_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg font-medium" do %>
        ← Voltar
      <% end %>
    </div>
  </div>

  <!-- Cards de Métricas Principais -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Preço de Venda</p>
      <p class="text-3xl font-bold text-green-600 mt-2">
        <% if @product.sale_price.present? %>
          R$ <%= number_with_precision(@product.sale_price, precision: 2, delimiter: ",", separator: ".") %>
        <% else %>
          -
        <% end %>
      </p>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Estoque Atual</p>
      <p class="text-3xl font-bold <%= @product.low_stock? ? 'text-red-600' : 'text-blue-600' %> mt-2">
        <%= @product.quantity || 0 %>
      </p>
      <% if @product.low_stock? %>
        <p class="text-xs text-red-600 mt-2">⚠️ Estoque baixo</p>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Margem de Lucro</p>
      <p class="text-3xl font-bold <%= @product.profit_margin >= 0 ? 'text-green-600' : 'text-red-600' %> mt-2">
        <% if @product.purchase_price.present? && @product.purchase_price > 0 %>
          <%= @product.profit_margin %>%
        <% else %>
          -
        <% end %>
      </p>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-gray-500 text-sm font-medium">Status</p>
      <div class="mt-2">
        <% if @product.active? %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
            ✓ Disponível
          </span>
        <% else %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
            ✕ Indisponível
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Seção de Imagem de Capa -->
  <% if @product.cover_image.attached? %>
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="px-6 py-4 bg-gray-900">
        <h2 class="text-xl font-bold text-white">Imagem do Produto</h2>
      </div>
      <div class="p-6">
        <div class="flex justify-center">
          <%= image_tag @product.cover_image.variant(resize_to_limit: [600, 600], strip: false), class: "max-h-96 rounded-lg object-cover shadow", loading: "lazy" %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Informações Detalhadas do Produto -->
  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-900">
      <h2 class="text-xl font-bold text-white">Informações do Produto</h2>
    </div>
    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">

      <div>
        <p class="text-sm font-medium text-gray-500">Marca</p>
        <p class="mt-1 text-lg text-gray-900"><%= @product.brand.present? ? @product.brand : '-' %></p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Cor</p>
        <p class="mt-1 text-lg text-gray-900"><%= @product.color.present? ? @product.color : '-' %></p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Categoria</p>
        <p class="mt-1">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
            <%= @product.category %>
          </span>
        </p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Unidade de Medida</p>
        <p class="mt-1 text-lg text-gray-900"><%= @product.unit.present? ? @product.unit.titleize : '-' %></p>
      </div>

      <% if @product.supplier.present? %>
        <div class="md:col-span-2">
          <p class="text-sm font-medium text-gray-500">Fornecedor</p>
          <p class="mt-1">
            <%= link_to @product.supplier.display_name, supplier_path(@product.supplier),
                class: "text-blue-600 hover:text-blue-800 underline" %>
          </p>
        </div>
      <% end %>

      <% if @product.description.present? %>
        <div class="col-span-2">
          <p class="text-sm font-medium text-gray-500">Descrição</p>
          <p class="mt-1 text-gray-900"><%= @product.description %></p>
        </div>
      <% end %>

      <% if @product.location.present? %>
        <div class="col-span-2">
          <p class="text-sm font-medium text-gray-500">Localização no Estoque</p>
          <p class="mt-1 text-lg text-gray-900 font-mono"><%= @product.location %></p>
        </div>
      <% end %>

    </div>
  </div>

  <!-- Informações Financeiras e de Estoque -->
  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-900">
      <h2 class="text-xl font-bold text-white">Preços e Estoque</h2>
    </div>
    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">

      <div>
        <p class="text-sm font-medium text-gray-500">Preço de Custo</p>
        <p class="mt-1 text-lg text-gray-900">
          <% if @product.purchase_price.present? %>
            R$ <%= number_with_precision(@product.purchase_price, precision: 2, delimiter: ",", separator: ".") %>
          <% else %>
            -
          <% end %>
        </p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Preço de Venda</p>
        <p class="mt-1 text-lg font-bold text-green-600">
          <% if @product.sale_price.present? %>
            R$ <%= number_with_precision(@product.sale_price, precision: 2, delimiter: ",", separator: ".") %>
          <% else %>
            -
          <% end %>
        </p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Preço Padrão</p>
        <p class="mt-1 text-lg text-gray-900">
          <% if @product.price.present? %>
            R$ <%= number_with_precision(@product.price, precision: 2, delimiter: ",", separator: ".") %>
          <% else %>
            -
          <% end %>
        </p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Valor Total em Estoque</p>
        <p class="mt-1 text-lg font-bold text-blue-600">
          R$ <%= number_with_precision(@product.stock_value, precision: 2, delimiter: ",", separator: ".") %>
        </p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Quantidade em Estoque</p>
        <p class="mt-1 text-2xl font-bold <%= @product.low_stock? ? 'text-red-600' : 'text-blue-600' %>">
          <%= @product.quantity || 0 %>
        </p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Estoque Mínimo</p>
        <p class="mt-1 text-lg text-gray-900"><%= @product.min_stock || '-' %></p>
      </div>

      <% if @product.profit_margin != 0 && @product.purchase_price.present? && @product.purchase_price > 0 %>
        <div class="md:col-span-2 pt-4 border-t">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-500">Margem de Lucro</p>
              <p class="mt-1 text-2xl font-bold <%= @product.profit_margin >= 0 ? 'text-green-600' : 'text-red-600' %>">
                <%= @product.profit_margin %>%
              </p>
            </div>
            <div class="text-right">
              <p class="text-sm font-medium text-gray-500">Lucro por Unidade</p>
              <p class="mt-1 text-2xl font-bold text-green-600">
                R$ <%= number_with_precision(@product.sale_price - @product.purchase_price, precision: 2, delimiter: ",", separator: ".") %>
              </p>
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <!-- Observações -->
  <% if @product.notes.present? %>
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="px-6 py-4 bg-gray-900">
        <h2 class="text-xl font-bold text-white">Observações Internas</h2>
      </div>
      <div class="p-6">
        <p class="text-gray-900"><%= @product.notes %></p>
      </div>
    </div>
  <% end %>

  <!-- Data de Criação/Atualização -->
  <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
    <p>Criado em: <%= l(@product.created_at, format: :short) %></p>
    <p>Última atualização: <%= l(@product.updated_at, format: :short) %></p>
  </div>

</div>
