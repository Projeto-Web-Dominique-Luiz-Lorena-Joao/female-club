<%= form_with(model: product, class: "space-y-6") do |form| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md">
      <div class="flex">
        <span class="text-red-500 text-xl">⚠️</span>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(product.errors.count, "erro") %>:
          </h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% product.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Seção: Informações Básicas -->
  <div class="border-t pt-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Informações Básicas</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div class="md:col-span-2">
        <%= form.label :name, "Nome do Produto *", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :name,
            id: "product_name",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
            placeholder: "Ex: Camiseta de Algodão Premium",
            required: true %>
      </div>

      <div>
        <%= form.label :code, "Código (SKU)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :code,
            id: "product_code",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
            placeholder: "Ex: ABC-123" %>
      </div>

      <div>
        <%= form.label :brand, "Marca", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :brand,
            id: "product_brand",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
            placeholder: "Ex: Nike, Adidas..." %>
      </div>

      <div>
        <%= form.label :category, "Categoria *", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.select :category,
            options_for_select(Product.categories.map { |k, v| [v, k] }, product.category),
            { include_blank: "Selecione uma categoria" },
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
      </div>

      <div>
        <%= form.label :color, "Cor", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :color,
            id: "product_color",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
            placeholder: "Ex: Preto, Branco..." %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :description, "Descrição", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_area :description,
            rows: 3,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
            placeholder: "Descrição detalhada do produto..." %>
      </div>

    </div>
  </div>

  <!-- Seção: Preços -->
  <div class="border-t pt-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Preços</h3>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <div>
        <%= form.label :purchase_price, "Preço de Custo", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="relative">
          <span class="absolute left-3 top-2 text-gray-500">R$</span>
          <%= form.number_field :purchase_price,
              step: "0.01",
              class: "w-full px-4 py-2 pl-8 border border-gray-300 rounded-lg",
              placeholder: "0,00" %>
        </div>
      </div>

      <div>
        <%= form.label :sale_price, "Preço de Venda *", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="relative">
          <span class="absolute left-3 top-2 text-gray-500">R$</span>
          <%= form.number_field :sale_price,
              step: "0.01",
              class: "w-full px-4 py-2 pl-8 border border-gray-300 rounded-lg",
              placeholder: "0,00",
              required: true %>
        </div>
      </div>

      <div>
        <%= form.label :price, "Preço Padrão", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="relative">
          <span class="absolute left-3 top-2 text-gray-500">R$</span>
          <%= form.number_field :price,
              step: "0.01",
              class: "w-full px-4 py-2 pl-8 border border-gray-300 rounded-lg",
              placeholder: "0,00" %>
        </div>
      </div>

    </div>
  </div>

  <!-- Seção: Estoque -->
  <div class="border-t pt-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Gerenciamento de Estoque</h3>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <div>
        <%= form.label :quantity, "Quantidade em Estoque", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.number_field :quantity,
            step: "1",
            min: "0",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
            placeholder: "0" %>
      </div>

      <div>
        <%= form.label :min_stock, "Estoque Mínimo", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.number_field :min_stock,
            step: "1",
            min: "0",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
            placeholder: "0" %>
      </div>

      <div>
        <%= form.label :unit, "Unidade de Medida", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.select :unit,
            options_for_select([
              ["Unidade", "unidade"],
              ["Pares", "pares"],
              ["Quilos", "quilos"],
              ["Litros", "litros"],
              ["Metros", "metros"],
              ["Caixas", "caixas"]
            ], product.unit),
            { include_blank: "Selecione" },
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :location, "Localização no Estoque", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :location,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
            placeholder: "Ex: Prateleira A1, Corredor 2..." %>
      </div>

    </div>
  </div>

  <!-- Seção: Status e Fornecedor -->
  <div class="border-t pt-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Status e Fornecedor</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div>
        <%= form.label :supplier_id, "Fornecedor", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.collection_select :supplier_id,
            Supplier.all,
            :id,
            :display_name,
            { include_blank: "Selecione um fornecedor" },
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
      </div>

      <div class="flex items-center space-x-4">
        <%= form.label :active, "Status: Disponível", class: "block text-sm font-medium text-gray-700 mb-2 flex-1" %>
        <div class="flex items-center space-x-2">
          <%= form.check_box :active, { class: "w-5 h-5 rounded border-gray-300" } %>
          <span class="text-sm text-gray-600"><%= product.active ? "Disponível" : "Indisponível" %></span>
        </div>
      </div>

    </div>
  </div>

  <!-- Seção: Imagens -->
  <div class="border-t pt-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Imagens</h3>

    <div class="space-y-4">

      <div>
        <%= form.label :cover_image, "Imagem de Capa", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="flex items-center space-x-4">
          <% if product.cover_image.attached? %>
            <div class="relative">
              <%= image_tag product.cover_image.variant(resize_to_limit: [150, 150], strip: false), class: "h-24 w-24 rounded object-cover" %>
              <button type="button"
                      onclick="document.getElementById('remove-cover-image').checked = true; this.textContent='Será removida'; this.classList.add('opacity-50', 'cursor-not-allowed');"
                      class="absolute top-0 right-0 bg-red-500 text-white rounded-full p-1 hover:bg-red-600">
                ✕
              </button>
            </div>
            <%= form.check_box :cover_image_delete, { id: "remove-cover-image", class: "hidden" }, "true", "false" %>
          <% end %>
          <%= form.file_field :cover_image,
              accept: "image/*",
              class: "px-4 py-2 border border-gray-300 rounded-lg" %>
        </div>
      </div>

      <div>
        <%= form.label :gallery_images, "Galeria de Imagens (até 7 fotos)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <% if product.gallery_images.attached? %>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
            <% product.gallery_images.each_with_index do |image, index| %>
              <div class="relative">
                <%= image_tag image.variant(resize_to_limit: [100, 100], strip: false), class: "h-24 w-24 rounded object-cover" %>
              </div>
            <% end %>
          </div>
        <% end %>
        <%= form.file_field :gallery_images,
            multiple: true,
            accept: "image/*",
            class: "px-4 py-2 border border-gray-300 rounded-lg" %>
        <p class="text-xs text-gray-500 mt-2">Máximo de 7 imagens. Selecione múltiplas imagens mantendo CTRL/CMD pressionado.</p>
      </div>

    </div>
  </div>

  <!-- Seção: Observações -->
  <div class="border-t pt-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Observações Adicionais</h3>

    <div>
      <%= form.label :notes, "Notas Internas", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :notes,
          rows: 3,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
          placeholder: "Informações adicionais sobre o produto, cuidados especiais, etc..." %>
    </div>
  </div>

  <!-- Botões de Ação -->
  <div class="flex justify-end space-x-2 pt-6">
    <%= link_to "Cancelar", products_path,
        class: "px-6 py-3 rounded-lg bg-gray-300 hover:bg-gray-200 text-gray-700 font-medium transition" %>
    <%= form.submit product.new_record? ? "Criar Produto" : "Atualizar Produto",
        class: "px-6 py-3 bg-green-600 hover:bg-green-500 text-white rounded-lg font-medium shadow-lg transition" %>
  </div>

<% end %>

<script>
  // Função para converter texto em MAIÚSCULAS
  function toUpperCaseText(text) {
    return text ? text.toUpperCase() : text;
  }

  function initializePriceMasks() {
    // Máscara para campos de preço com 2 casas decimais
    const priceFields = document.querySelectorAll('input[type="number"][step="0.01"]');

    priceFields.forEach(field => {
      field.addEventListener('input', function() {
        if (this.value) {
          // Remove caracteres não numéricos
          let value = this.value.replace(/[^\d]/g, '');

          // Se vazio, deixa em branco
          if (!value) {
            this.value = '';
            return;
          }

          // Garante que tenha pelo menos 3 dígitos (para colocar 2 casas decimais)
          if (value.length === 1) {
            value = '00' + value;
          } else if (value.length === 2) {
            value = '0' + value;
          }

          // Coloca o ponto na posição correta
          let integerPart = value.slice(0, -2);
          const decimalPart = value.slice(-2);

          // Remove zeros à esquerda, mas deixa pelo menos um zero
          integerPart = integerPart.replace(/^0+/, '') || '0';

          this.value = integerPart + '.' + decimalPart;
        }
      });
    });
  }

  function initializeCodeField() {
    // Máscara para código SKU: 3 letras maiúsculas - 3 números
    const codeField = document.getElementById('product_code');
    if (codeField) {
      codeField.addEventListener('input', function() {
        let value = this.value.toUpperCase();

        // Divide em letras (primeiros 3) e números (últimos 3)
        let letters = '';
        let numbers = '';

        // Extrai as letras dos primeiros 3 caracteres
        for (let i = 0; i < Math.min(value.length, 3); i++) {
          if (/[A-Z]/.test(value[i])) {
            letters += value[i];
          }
        }

        // Extrai os números do resto
        for (let i = 3; i < value.length; i++) {
          if (/[0-9]/.test(value[i])) {
            numbers += value[i];
          }
        }

        // Limita a 3 números
        numbers = numbers.slice(0, 3);

        // Formata: XXX-### apenas se tiver letras
        if (letters.length > 0) {
          this.value = letters + (numbers.length > 0 ? '-' + numbers : '');
        } else {
          this.value = '';
        }

        console.log('✨ Máscara CÓDIGO inicializada para: product_code');
      });
    }
  }

  function initializeUpperCaseFields() {
    // Usar IDs específicos para encontrar os campos
    const fieldIds = ['product_name', 'product_brand', 'product_color'];

    fieldIds.forEach(id => {
      const field = document.getElementById(id);
      console.log('🔍 Procurando ID:', id, 'Encontrado:', !!field);

      if (field) {
        // Aplicar em tempo real enquanto digita (input)
        field.addEventListener('input', function() {
          console.log('📝 Input em', id, 'Valor anterior:', this.value);
          this.value = toUpperCaseText(this.value);
          console.log('✅ Valor novo:', this.value);
        });

        console.log('✨ Máscara MAIÚSCULAS inicializada para:', id);
      } else {
        console.log('❌ Campo NÃO encontrado com ID:', id);
      }
    });
  }

  function initializeAllMasks() {
    console.log('🚀 Inicializando TODAS as máscaras...');
    initializePriceMasks();
    console.log('💰 Máscaras de preço inicializadas');
    initializeCodeField();
    console.log('📦 Máscara de código inicializada');
    initializeUpperCaseFields();
    console.log('⬆️ Máscaras MAIÚSCULAS inicializadas');
  }

  // Inicializar ao carregar a página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      initializeAllMasks();
    });
  } else {
    initializeAllMasks();
  }

  // Para Turbo (se estiver usando Turbo no Rails)
  document.addEventListener('turbo:load', function() {
    initializeAllMasks();
  });
</script>
