<div class="space-y-6">
  <%= form_with(model: product, class: "space-y-8 max-w-4xl mx-auto") do |form| %>

    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="px-6 py-4 bg-black border-b border-gray-200">
        <h2 class="text-xl font-bold text-white">Dados do Produto</h2>
      </div>

      <div class="p-6">
        <% if product.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md mb-6">
            <div class="flex">
              <span class="text-red-500 text-xl">⚠️</span>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(product.errors.count, "erro") %> ao salvar:
                </h3>
                <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                  <% product.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Seção: Informações Básicas -->
        <div class="pb-6 border-b border-gray-200">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Nome -->
            <div class="md:col-span-2">
              <%= form.label :name, "Nome do Produto *", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :name,
                  id: "product_name",
                  class: "w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "Ex: Camiseta de Algodão Premium",
                  required: true %>
            </div>

            <!-- Marca -->
            <div>
              <%= form.label :brand, "Marca", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :brand,
                  id: "product_brand",
                  class: "w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "Ex: Nike, Adidas..." %>
            </div>

            <!-- Categoria -->
            <div>
              <%= form.label :category, "Categoria *", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :category,
                  options_for_select(Product.categories.map { |k, v| [v, k] }, product.category),
                  { prompt: "Selecione uma categoria" },
                  class: "w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  required: true %>
            </div>

            <!-- Cor -->
            <div>
              <%= form.label :color, "Cor", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :color,
                  id: "product_color",
                  class: "w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "Ex: Preto, Branco..." %>
            </div>

            <!-- Descrição -->
            <div class="md:col-span-2">
              <%= form.label :description, "Descrição", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_area :description,
                  rows: 3,
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "Descrição detalhada do produto..." %>
            </div>
          </div>
        </div>

        <!-- Seção: Preços -->
        <div class="py-6 border-b border-gray-200">

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <div>
              <%= form.label :sale_price, "Preço de Venda *", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">R$</span>
                <%= form.number_field :sale_price,
                    step: "0.01",
                    class: "w-full px-4 py-2 pl-10 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                    placeholder: "0,00",
                    required: true %>
              </div>
            </div>

          </div>
        </div>

        <!-- Seção: Estoque -->
        <div class="py-6 border-b border-gray-200">

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <div>
              <%= form.label :min_stock, "Estoque Mínimo *", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.number_field :min_stock,
                  step: "1",
                  min: "0",
                  class: "w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "0",
                  required: true %>
            </div>

            <div>
              <%= form.label :unit, "Unidade de Medida", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :unit,
                  options_for_select([
                    ["Unidade", "unidade"],
                    ["Pares", "pares"],
                    ["Quilos", "quilos"],
                    ["Litros", "litros"],
                    ["Metros", "metros"],
                    ["Caixas", "caixas"]
                  ], product.unit),
                  { prompt: "Selecione" },
                  class: "w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
            </div>

            <div>
              <%= form.label :location, "Localização no Estoque", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :location,
                  class: "w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                  placeholder: "Ex: Prateleira A1, Corredor 2..." %>
            </div>

          </div>
        </div>

        <!-- Seção: Status e Fornecedor -->
        <div class="py-6 border-b border-gray-200">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- Fornecedor -->
            <div>
              <%= form.label :supplier_id, "Fornecedor", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.collection_select :supplier_id,
                  Supplier.all,
                  :id,
                  :display_name,
                  { prompt: "Selecione um fornecedor" },
                  class: "w-full px-4 py-2 h-11 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
            </div>
            
            <!-- Toggle Disponível -->
            <div class="flex items-center gap-3 mt-6">
              <%= form.label :active, "Status", class: "text-sm font-medium text-gray-700" %>
              <label class="relative inline-flex items-center cursor-pointer shrink-0">
                <input type="checkbox"
                      class="sr-only peer"
                      data-guarantor-form-target="toggle"
                      data-action="change->guarantor-form#toggleSection"
                      <%= 'checked' if product.active? %>>
                <div class="relative w-14 h-7 bg-gray-200 rounded-full
                            peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-green-300
                            after:content-[''] after:absolute after:top-0.5 after:left-[4px]
                            after:bg-white after:border-gray-300 after:border after:rounded-full
                            after:h-6 after:w-6 after:transition-all
                            peer-checked:after:translate-x-full peer-checked:bg-green-600">
                </div>
              </label>
            </div>

          </div>
        </div>

        <!-- Seção: Imagens -->
        <div class="py-6 border-b border-gray-200">

          <div class="space-y-4">
            <div>
              <%= form.label :cover_image, "Imagem de Capa", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <div class="flex items-center space-x-4">
                <% if product.cover_image.attached? && product.persisted? %>
                  <div class="relative">
                    <% begin %>
                      <%= image_tag product.cover_image.variant(resize_to_limit: [150, 150], strip: false), class: "h-24 w-24 rounded object-cover" %>
                    <% rescue ArgumentError %>
                      <%= image_tag product.cover_image, class: "h-24 w-24 rounded object-cover" %>
                    <% end %>
                    <button type="button"
                            onclick="document.getElementById('remove-cover-image').checked = true; this.textContent='Será removida'; this.classList.add('opacity-50', 'cursor-not-allowed');"
                            class="absolute top-0 right-0 bg-red-500 text-white rounded-full p-1 hover:bg-red-600">
                      ✕
                    </button>
                  </div>
                  <%= form.check_box :cover_image_delete, { id: "remove-cover-image", class: "hidden" }, "true", "false" %>
                <% end %>
                <%= form.file_field :cover_image,
                    accept: "image/*",
                    class: "px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
              </div>
            </div>
          </div>
        </div>

        <!-- Seção: Observações -->
        <div class="py-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Observações Adicionais</h3>

          <div>
            <%= form.label :notes, "Notas Internas", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_area :notes,
                rows: 3,
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 focus:ring-2 focus:ring-gray-900 focus:border-transparent",
                placeholder: "Informações adicionais sobre o produto, cuidados especiais, etc..." %>
          </div>
        </div>

        <div class="flex justify-between items-center pt-2">
          <div class="text-xs text-gray-500">* campos obrigatórios</div>
        </div>

      </div>
    </div>

    <!-- Botões -->
    <div class="flex justify-end space-x-3 pt-6">
      <%= link_to "Cancelar", products_path, class: "px-6 py-3 rounded-lg bg-gray-200 border border-gray-300 hover:bg-white text-gray-700 font-medium transition" %>
      <%= form.submit product.new_record? ? "Criar Produto" : "Atualizar Produto",
          class: "px-6 py-3 bg-green-600 hover:bg-green-500 text-white rounded-lg font-medium shadow-lg transition cursor-pointer" %>
    </div>

  <% end %>
</div>

<script>
  function initializePriceMasks() {
    const priceFields = document.querySelectorAll('input[type="number"][step="0.01"]');

    priceFields.forEach(field => {
      field.addEventListener('input', function() {
        if (this.value) {
          let value = this.value.replace(/[^\d]/g, '');
          if (!value) {
            this.value = '';
            return;
          }
          if (value.length === 1) value = '00' + value;
          else if (value.length === 2) value = '0' + value;
          let integerPart = value.slice(0, -2);
          const decimalPart = value.slice(-2);
          integerPart = integerPart.replace(/^0+/, '') || '0';
          this.value = integerPart + '.' + decimalPart;
        }
      });
    });
  }

  function initializeAllMasks() {
    initializePriceMasks();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAllMasks);
  } else {
    initializeAllMasks();
  }

  document.addEventListener('turbo:load', initializeAllMasks);
</script>
