<div class="bg-white rounded-lg shadow-lg p-6">
  <%= form_with(model: @guarantor, local: true, class: "space-y-6") do |form| %>
    <% if @guarantor.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md">
        <div class="flex">
          <span class="text-red-500 text-xl">⚠️</span>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">
              <%= pluralize(@guarantor.errors.count, "erro") %>:
            </h3>
            <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
              <% @guarantor.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Nome Completo -->
      <div class="md:col-span-2">
        <%= form.label :full_name, "Nome Completo *", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :full_name,
                            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
                            placeholder: "Digite o nome completo do fiador",
                            required: true %>
      </div>

      <!-- CPF -->
      <div>
        <%= form.label :cpf, "CPF", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :cpf,
                            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
                            placeholder: "000.000.000-00",
                            maxlength: 14 %>
      </div>

      <!-- Telefone -->
      <div>
        <%= form.label :phone, "Telefone", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :phone,
                            class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
                            placeholder: "(00) 00000-0000" %>
      </div>

      <!-- Relacionamento -->
      <div class="md:col-span-2">
        <%= form.label :relationship, "Parentesco", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.select :relationship,
                        options_for_select(
                          Guarantor.relationships.keys.map { |key| [key.titleize, key] },
                          @guarantor.relationship
                        ),
                        { include_blank: "Selecione o parentesco" },
                        class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
      </div>

      <!-- Status -->
      <div class="md:col-span-2">
        <%= form.label :status, "Status *", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.select :status,
                        options_for_select(
                          Guarantor.statuses.keys.map { |key| [key.titleize, key] },
                          @guarantor.status
                        ),
                        { include_blank: "Selecione o status" },
                        class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
                        required: true %>
      </div>

      <!-- Endereço -->
      <div class="md:col-span-2">
        <%= form.label :address, "Endereço", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_area :address,
                           rows: 2,
                           class: "w-full px-4 py-2 border border-gray-300 rounded-lg",
                           placeholder: "Digite o endereço completo do fiador" %>
      </div>

      <!-- Campo de Associação com Cliente -->
      <div class="md:col-span-2"
           data-controller="sales-autocomplete"
           data-sales-autocomplete-search-url-value="/guarantors/search_customers"
           data-sales-autocomplete-allow-create-value="false">
        <%= form.label :customer_association, "Associar a um Cliente (Opcional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="relative">
          <input type="hidden" name="customer_association_id" id="customer_association_id" value="<%= @guarantor.customer&.id %>" data-sales-autocomplete-target="hiddenInput">
          <input type="text"
                 id="customer_search"
                 class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
                 placeholder="Digite o nome do cliente para associar..."
                 autocomplete="off"
                 value="<%= @guarantor.customer&.full_name %>"
                 data-sales-autocomplete-target="searchInput"
                 data-action="input->sales-autocomplete#search focus->sales-autocomplete#focus click->sales-autocomplete#focus">
          <div class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg max-h-60 overflow-auto"
               data-sales-autocomplete-target="results"></div>
        </div>
        <small class="text-gray-500 text-xs">
          Selecionado: <span class="font-medium" data-sales-autocomplete-target="selectedDisplay"><%= @guarantor.customer&.full_name || 'Nenhum cliente associado' %></span>
        </small>
        <p class="text-xs text-gray-500 mt-2">
          <strong>Dica:</strong> Digite o nome do cliente e selecione da lista para associar este fiador.
        </p>
      </div>
    </div>

    <!-- Botões de Ação -->
    <div class="flex justify-end space-x-2 pt-6">
      <%= link_to "Cancelar", guarantors_path,
                  class: "px-6 py-3 rounded-lg bg-gray-300 hover:bg-gray-200 text-gray-700 font-medium transition" %>
      <%= form.submit @guarantor.new_record? ? "Salvar Fiador" : "Atualizar Fiador",
                      class: "px-6 py-3 bg-green-600 hover:bg-green-500 text-white rounded-lg font-medium shadow-lg transition" %>
    </div>
  <% end %>
</div>

<script>
(function() {
  console.log('Máscaras ativadas!');

  function aplicar() {
    // --- MÁSCARA DE CPF ---
    const cpf = document.querySelector('input[name="guarantor[cpf]"]');
    if (cpf && !cpf.dataset.m) {
      cpf.dataset.m = '1';

      cpf.addEventListener("input", function(e) {
        let cursor = e.target.selectionStart;
        let old = e.target.value;
        let clean = old.replace(/\D/g, '');

        const before = old.slice(0, cursor).replace(/\D/g, '').length;

        const masked = formatCPF(clean);
        e.target.value = masked;

        let newCursor = masked.length;
        let count = 0;

        for (let i = 0; i < masked.length; i++) {
          if (masked[i].match(/\d/)) count++;
          if (count == before) {
            newCursor = i + 1;
            break;
          }
        }

        e.target.setSelectionRange(newCursor, newCursor);
      });

      console.log("CPF ok");
    }

    // --- MÁSCARA DE TELEFONE ---
    const tel = document.querySelector('input[name="guarantor[phone]"]');
    if (tel && !tel.dataset.mtel) {
      tel.dataset.mtel = '1';

      tel.addEventListener('input', function(e) {
        let cursor = e.target.selectionStart;
        let clean = e.target.value.replace(/\D/g, '');

        if (e.inputType === "deleteContentBackward") {
          e.target.value = formatPhone(clean);
          e.target.setSelectionRange(cursor, cursor);
          return;
        }

        e.target.value = formatPhone(clean);
        e.target.setSelectionRange(e.target.value.length, e.target.value.length);
      });

      console.log('Telefone ok');
    }
  }

  function formatCPF(v) {
    if (v.length > 11) v = v.slice(0, 11);

    if (v.length > 9) {
      return v.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, "$1.$2.$3-$4");
    } else if (v.length > 6) {
      return v.replace(/(\d{3})(\d{3})(\d{1,3})/, "$1.$2.$3");
    } else if (v.length > 3) {
      return v.replace(/(\d{3})(\d{1,3})/, "$1.$2");
    }
    return v;
  }

  function formatPhone(v) {
    if (v.length > 11) v = v.slice(0, 11);

    if (v.length > 10) {
      return v.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
    } else if (v.length > 6) {
      return v.replace(/(\d{2})(\d{4,5})(\d{0,4})/, '($1) $2-$3');
    } else if (v.length > 2) {
      return v.replace(/(\d{2})(\d{0,5})/, '($1) $2');
    } else if (v.length > 0) {
      return '(' + v;
    }
    return v;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', aplicar);
  } else {
    aplicar();
  }

  document.addEventListener('turbo:load', aplicar);
})();
</script>
