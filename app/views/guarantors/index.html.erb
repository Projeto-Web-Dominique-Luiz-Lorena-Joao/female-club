<div class="space-y-6">
  <!-- Header -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Fiadores</h1>
      <p class="mt-2 text-gray-600">Gerenciar todos os fiadores cadastrados no sistema</p>
    </div>
    <div class="flex gap-3">
      <%= link_to new_guarantor_path, class: "bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition inline-flex items-center" do %>
        Novo Fiador
      <% end %>
    </div>
  </div>

  <!-- Lista -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @guarantors.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Nome</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Cliente</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">CPF</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Telefone</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Parentesco</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase w-32">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @guarantors.each do |guarantor| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <p class="text-sm text-center font-medium text-gray-900"><%= guarantor.full_name %></p>
              </td>
              <td class="px-6 py-4 text-sm text-center text-gray-900">
                <% if guarantor.customer.present? %>
                  <%= link_to guarantor.customer.full_name, customer_path(guarantor.customer), class: "text-blue-600 hover:underline" %>
                <% else %>
                  <span class="text-gray-400 italic text-xs">Sem cliente</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-center text-gray-900">
                <%= guarantor.formatted_cpf || '-' %>
              </td>
              <td class="px-6 py-4 text-sm text-center text-gray-900">
                <%= guarantor.formatted_phone || '-' %>
              </td>
              <td class="px-6 py-4 text-center">
                <% if guarantor.relationship.present? %>
                  <span class="px-3 py-1 text-xs font-medium rounded-full bg-purple-100 text-purple-800">
                    <%= guarantor.relationship.titleize %>
                  </span>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-right w-32">
                <div class="flex flex-col items-end space-y-2 w-full">
                  <%= link_to "Visualizar", guarantor_path(guarantor), class: "bg-blue-200 text-blue-700 px-3 py-1 rounded-lg hover:bg-blue-100 w-full text-center text-sm font-medium" %>
                  <%= link_to "Editar", edit_guarantor_path(guarantor), class: "bg-orange-200 text-orange-700 px-3 py-1 rounded-lg hover:bg-orange-100 w-full text-center text-sm font-medium" %>
                  <%= button_to "Deletar", guarantor_path(guarantor),
                      method: :delete,
                      data: { confirm: "Tem certeza que deseja excluir este fiador?" },
                      form: { class: "w-full" },
                      class: "bg-red-200 text-red-700 px-3 py-1 rounded-lg hover:bg-red-100 w-full text-center text-sm font-medium" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-12">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <p class="mt-4 text-xl text-gray-600">Nenhum fiador cadastrado</p>
        <p class="text-gray-500 mb-6">Ainda não há fiadores cadastrados no sistema.</p>
        <%= link_to "Cadastrar primeiro fiador", new_guarantor_path,
            class: "mt-4 inline-block bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-lg font-medium" %>
      </div>
    <% end %>
  </div>
</div>
