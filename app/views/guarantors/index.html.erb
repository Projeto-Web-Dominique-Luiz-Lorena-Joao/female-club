<div class="space-y-6">
  <!-- Header -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Fiadores</h1>
      <p class="mt-2 text-gray-600">Gerenciar todos os fiadores cadastrados no sistema</p>
    </div>
    <div class="flex gap-3">
      <%= link_to new_guarantor_path, class: "bg-black hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-medium shadow-lg transition duration-200 inline-flex items-center" do %>
        Novo Fiador
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: guarantors_path, method: :get, class: "space-y-4", local: true do %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <div class="md:col-span-2">
          <%= text_field_tag :search, params[:search],
            placeholder: "Buscar por nome, CPF, telefone ou cliente",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
        </div>

        <div class="flex justify-end space-x-2 items-center">
          <%= submit_tag "Buscar",
              class: "bg-black hover:bg-gray-700 text-white px-6 py-2 rounded-lg font-medium transition duration-200" %>

          <%= link_to "Limpar", guarantors_path,
              class: "bg-gray-300 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition duration-200" %>
        </div>

      </div>
    <% end %>
  </div>

  <!-- Lista -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if @guarantors.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-black">
          <tr>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Nome</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Cliente</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">CPF</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Telefone</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Parentesco</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase">Status</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-white uppercase w-32">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @guarantors.each do |guarantor| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <p class="text-sm text-center font-medium text-gray-900"><%= guarantor.full_name %></p>
              </td>
              <td class="px-6 py-4 text-sm text-center text-gray-900">
                <% if guarantor.customer.present? %>
                  <%= link_to guarantor.customer.full_name, customer_path(guarantor.customer), class: "text-blue-600 hover:underline" %>
                <% else %>
                  <span class="text-gray-400 italic text-xs">Sem cliente</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-center text-gray-900">
                <%= guarantor.formatted_cpf || '-' %>
              </td>
              <td class="px-6 py-4 text-sm text-center text-gray-900">
                <%= guarantor.formatted_phone || '-' %>
              </td>
              <td class="px-6 py-4 text-center">
                <% if guarantor.relationship.present? %>
                  <span class="px-3 py-1 text-xs font-medium rounded-full bg-purple-100 text-purple-800">
                    <%= guarantor.relationship.titleize %>
                  </span>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-center">
                <% if guarantor.ativo? %>
                  <span class="px-3 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">
                    Ativo
                  </span>
                <% elsif guarantor.inativo? %>
                  <span class="px-3 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800">
                    Inativo
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-center space-x-2">
                <div class="flex flex-col items-end space-y-2 w-full">
                  <%= link_to "Visualizar", guarantor_path(guarantor), class: "bg-blue-200 text-blue-700 px-5 py-2 rounded-lg hover:bg-blue-100 text-center text-sm font-medium" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-12">
        <p class="mt-4 text-xl text-gray-600">Nenhum fiador cadastrado</p>
        <%= link_to "Cadastrar primeiro fiador", new_guarantor_path,
            class: "mt-4 inline-block bg-black hover:bg-gray-800 text-white px-6 py-3 rounded-lg font-medium transition duration-200" %>
      </div>
    <% end %>
  </div>
</div>
