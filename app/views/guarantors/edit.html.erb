<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Editar Fiador</h1>
        <p class="mt-2 text-gray-600">Atualize as informações do fiador</p>
      </div>
      <%= link_to guarantors_path,
      class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg font-medium flex items-center gap-2" do %>

        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            stroke="currentColor" stroke-width="2" fill="none"
            class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" />
        </svg>

        Voltar
      <% end %>

    </div>
  </div>

  <%= render 'form' %>
</div>
